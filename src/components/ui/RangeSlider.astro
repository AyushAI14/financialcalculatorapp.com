---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getLanguageDefaultCurrency, getCurrencySymbol } from '../../lib/currency';

interface Props {
  id: string;
  label: string;
  min: number;
  max: number;
  step?: number;
  value: number;
  prefix?: string;
  suffix?: string;
  name?: string;
}

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);

const { id, label, min, max, step = 1, value, prefix, suffix, name } = Astro.props;
const localizedLabel = t(label, label);

const defaultCurrency = getLanguageDefaultCurrency(lang);
const defaultCurrencySymbol = getCurrencySymbol(defaultCurrency);
const displayPrefix = prefix === '$' ? defaultCurrencySymbol : prefix;
---
<div class="flex flex-col gap-1.5 sm:gap-2">
  <div class="flex items-center justify-between">
    <label for={id} class="text-[10px] sm:text-xs font-mono font-bold uppercase tracking-wider text-muted">{localizedLabel}</label>
    <div class="flex items-center gap-1 bg-soft px-2 sm:px-2.5 py-0.5 rounded-full border border-ink text-[11px] sm:text-xs font-mono font-bold text-ink shadow-[var(--control-shadow)]">
      {prefix && (
        <span data-currency-prefix={prefix === '$' ? "true" : undefined}>
          {displayPrefix}
        </span>
      )}
      <span id={`${id}-val`}>{value}</span>
      {suffix && <span>{suffix}</span>}
    </div>
  </div>
  <div class="relative flex items-center gap-2 sm:gap-3 group">
    <button 
      type="button" 
      class="slider-control-btn minus bg-paper hover:bg-soft border border-ink w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-ink font-bold text-xs sm:text-sm select-none cursor-pointer transition-all shadow-[var(--control-shadow)] hover:shadow-[var(--control-shadow-hover)] shrink-0 active:scale-95" 
      data-target={id}
      aria-label="Decrease value"
    >
      &minus;
    </button>
    <input
      type="range"
      id={id}
      name={name || id}
      min={min}
      max={max}
      step={step}
      value={value}
      data-base-min={min}
      data-base-max={max}
      data-base-step={step}
      data-currency-slider={prefix === '$' ? "true" : undefined}
      class="flex-1 h-2 bg-soft border border-ink/30 rounded-lg appearance-none cursor-pointer accent-input-accent focus:outline-none transition-colors group-hover:border-ink [&::-webkit-slider-thumb]:w-5.5 [&::-webkit-slider-thumb]:h-5.5 sm:[&::-webkit-slider-thumb]:w-6 sm:[&::-webkit-slider-thumb]:h-6 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-input-accent [&::-webkit-slider-thumb]:border [&::-webkit-slider-thumb]:border-ink [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:shadow-[var(--control-shadow)] [&::-webkit-slider-thumb]:hover:scale-110 [&::-webkit-slider-thumb]:transition-transform [&::-moz-range-thumb]:w-5.5 [&::-moz-range-thumb]:h-5.5 sm:[&::-moz-range-thumb]:w-6 sm:[&::-moz-range-thumb]:h-6 [&::-moz-range-thumb]:rounded-full [&::-moz-range-thumb]:bg-input-accent [&::-moz-range-thumb]:border [&::-moz-range-thumb]:border-ink [&::-moz-range-thumb]:shadow-[var(--control-shadow)] [&::-moz-range-thumb]:hover:scale-110 [&::-moz-range-thumb]:transition-transform"
    />
    <button 
      type="button" 
      class="slider-control-btn plus bg-paper hover:bg-soft border border-ink w-7 h-7 sm:w-8 sm:h-8 rounded-full flex items-center justify-center text-ink font-bold text-xs sm:text-sm select-none cursor-pointer transition-all shadow-[var(--control-shadow)] hover:shadow-[var(--control-shadow-hover)] shrink-0 active:scale-95" 
      data-target={id}
      aria-label="Increase value"
    >
      &plus;
    </button>
  </div>
</div>

<script is:inline>
  // Automatically update the value display label when the slider moves
  document.querySelectorAll('input[type="range"]').forEach(slider => {
    const valDisplay = document.getElementById(`${slider.id}-val`);
    if (valDisplay) {
      slider.addEventListener('input', (e) => {
        valDisplay.textContent = e.target.value;
      });
    }
  });

  // Handle minus and plus buttons for precise slider adjustments
  document.querySelectorAll('.slider-control-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const targetBtn = e.currentTarget;
      const targetId = targetBtn.dataset.target;
      if (!targetId) return;
      const slider = document.getElementById(targetId);
      if (slider) {
        const step = parseFloat(slider.step) || 1;
        const min = parseFloat(slider.min) || 0;
        const max = parseFloat(slider.max) || 100;
        const currentVal = parseFloat(slider.value) || min;
        
        let newVal = currentVal;
        if (targetBtn.classList.contains('minus')) {
          newVal = Math.max(min, currentVal - step);
        } else {
          newVal = Math.min(max, currentVal + step);
        }
        
        slider.value = String(newVal);
        
        // Update label display
        const valDisplay = document.getElementById(`${targetId}-val`);
        if (valDisplay) valDisplay.textContent = String(newVal);

        // Dispatch input and change events so page calculators recalculate in real-time
        slider.dispatchEvent(new Event('input', { bubbles: true }));
        slider.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });
</script>
