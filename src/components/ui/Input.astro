---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  id: string;
  label: string;
  type?: 'text' | 'number';
  placeholder?: string;
  value?: string | number;
  prefix?: string;
  suffix?: string;
  tooltip?: string;
}

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);

const { id, label, type = 'text', placeholder = '', value = '', prefix, suffix, tooltip } = Astro.props;

const localizedLabel = t(label, label);
const localizedTooltip = tooltip ? t(tooltip, tooltip) : undefined;
const localizedPlaceholder = placeholder ? t(placeholder, placeholder) : placeholder;
---
<div class="flex flex-col gap-1.5 w-full relative">
  <div class="flex items-center gap-1.5">
    <label for={id} class="text-sm font-medium text-ink">{localizedLabel}</label>
    {localizedTooltip && (
      <div class="group relative cursor-help select-none">
        <span
          class="w-3.5 h-3.5 rounded-full border border-mute/50 text-[10px] text-mute flex items-center justify-center font-mono hover:bg-canvas-soft-2 transition-colors"
          tabindex="0"
          role="img"
          aria-label={localizedTooltip}
          aria-describedby={`${id}-tooltip`}
        >?</span>
        <div
          id={`${id}-tooltip`}
          role="tooltip"
          class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-2 bg-primary text-on-primary text-[10px] leading-normal rounded shadow-md opacity-0 pointer-events-none group-hover:opacity-100 group-focus-within:opacity-100 focus-within:opacity-100 transition-opacity z-50 text-center font-normal"
        >
          {localizedTooltip}
          <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-primary"></div>
        </div>
      </div>
    )}
  </div>
  <div class="relative flex items-center">
    {prefix && (
      <span 
        class="absolute left-3 text-mute text-sm pointer-events-none" 
        data-currency-prefix={prefix === '$' ? "true" : undefined}
      >
        {prefix}
      </span>
    )}
    <input
      type={type}
      id={id}
      name={id}
      value={value}
      placeholder={localizedPlaceholder}
      class:list={[
        "w-full h-10 bg-canvas text-ink text-sm border border-hairline rounded-sm transition-colors focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong shadow-[0_1px_2px_rgba(0,0,0,0.02)]",
        prefix ? "pl-7" : "pl-3",
        suffix ? (suffix.length > 4 ? "pr-20" : (suffix.length > 2 ? "pr-14" : "pr-8")) : "pr-3"
      ]}
    />
    {suffix && <span class="absolute right-3 text-mute text-sm pointer-events-none">{suffix}</span>}
  </div>
  <!-- Validation Error Container -->
  <span id={`${id}-error`} class="text-[10px] text-error font-medium mt-0.5 leading-none hidden"></span>
</div>

<script>
  import { safeGetItem } from '../../lib/storage';

  function updateCurrencySymbol() {
    const symbols: Record<string, string> = {
      USD: '$',
      EUR: '€',
      GBP: '£',
      INR: '₹'
    };
    const currentCurrency = safeGetItem('currency', 'USD');
    const symbol = symbols[currentCurrency] || '$';
    
    document.querySelectorAll('[data-currency-prefix]').forEach(span => {
      span.textContent = symbol;
    });
  }

  // Register listeners (Astro script is executed once per page load)
  if (!(window as any).__currency_listener_registered) {
    (window as any).__currency_listener_registered = true;
    window.addEventListener('currency-change', updateCurrencySymbol);
    document.addEventListener('DOMContentLoaded', updateCurrencySymbol);
  }
  
  // Run immediately on client load
  updateCurrencySymbol();
</script>
