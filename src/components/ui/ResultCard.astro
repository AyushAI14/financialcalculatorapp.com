---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  title: string;
  value?: string | number;
  description?: string;
  highlight?: boolean;
  id?: string;
}

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);

const { title, value = "--", description, highlight = false, id } = Astro.props;

const localizedTitle = t(title, title);
const localizedDescription = description ? t(description, description) : undefined;
---
<div id={id} class:list={[
  "px-5 py-4 rounded-lg flex items-center justify-between gap-4 min-h-[76px] w-full transition-all",
  highlight ? "bg-paper border-2 border-input-accent shadow-[var(--control-shadow-hover)]" : "bg-paper border border-ink/40 shadow-[var(--control-shadow)]"
]}>
  <div class="flex-1 min-w-0 text-left pr-2">
    <h4 class="text-[11px] font-bold uppercase tracking-wider text-muted">{localizedTitle}</h4>
    {localizedDescription && <p class="text-xs text-muted mt-0.5 leading-normal max-w-md hidden sm:block">{localizedDescription}</p>}
  </div>
  <div class="text-xl sm:text-2xl font-mono font-black tracking-tight text-ink whitespace-nowrap text-right shrink-0" data-result-value title={String(value)}>
    {value}
  </div>
</div>
