---
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Option {
  value: string;
  label: string;
}

interface Props {
  id: string;
  label: string;
  options: Option[];
  value?: string;
  name?: string;
}

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);

const { id, label, options, value, name } = Astro.props;
const localizedLabel = t(label, label);
---
<div class="flex flex-col gap-1.5">
  <label for={id} class="text-[11px] sm:text-xs font-mono font-bold uppercase tracking-wider text-ink">{localizedLabel}</label>
  <div class="relative">
    <select
      id={id}
      name={name || id}
      class="w-full h-10 sm:h-11 bg-canvas text-ink text-xs sm:text-sm font-mono font-medium border border-ink/40 rounded-md pl-3 sm:pl-3.5 pr-8 sm:pr-9 appearance-none transition-all focus:outline-none focus:border-input-accent focus:ring-2 focus:ring-input-accent/20 shadow-[var(--control-shadow)]"
    >
      {options.map(opt => (
        <option value={opt.value} selected={opt.value === value}>{t(opt.label, opt.label)}</option>
      ))}
    </select>
    <div class="absolute inset-y-0 right-0 flex items-center px-3 pointer-events-none text-muted">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
    </div>
  </div>
</div>
