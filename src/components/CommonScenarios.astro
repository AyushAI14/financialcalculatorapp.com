---
import { getScenariosForCalculator, getScenariosByCategory } from '../lib/scenarios';
import type { ScenarioDefinition } from '../types/scenario';

interface Props {
  calculatorUrl?: string;
  category?: string;
  limit?: number;
  title?: string;
  description?: string;
}

const {
  calculatorUrl,
  category,
  limit = 6,
  title = "Common Scenarios & Worked Examples",
  description = "Real-world financial scenarios with step-by-step mathematical proofs, key metrics, and preloaded parameters."
} = Astro.props;

let scenarios: ScenarioDefinition[] = [];

if (calculatorUrl) {
  scenarios = getScenariosForCalculator(calculatorUrl, category, limit);
} else if (category) {
  scenarios = getScenariosByCategory(category).slice(0, limit);
}
---

{scenarios.length > 0 && (
  <section class="border-t-2 border-line mt-10 sm:mt-12 pt-8 sm:pt-12 space-y-6 no-print" aria-label="Real-World Calculation Scenarios">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <h2 class="font-display font-black text-xl sm:text-2xl tracking-tight text-ink flex items-center gap-2">
          <span>💡</span> {title}
        </h2>
        {description && (
          <p class="text-xs sm:text-sm text-muted mt-1 max-w-2xl font-sans">
            {description}
          </p>
        )}
      </div>
      <span class="text-[11px] font-mono text-muted bg-paper px-2.5 py-1 rounded border border-hairline shrink-0">
        Verified Client-Side Math
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      {scenarios.map((sc) => (
        <a 
          href={`/scenarios/${sc.slug}`}
          class="group bg-paper border border-hairline hover:border-input-accent rounded-xl p-4 sm:p-5 transition-all flex flex-col justify-between hover:shadow-md block relative"
        >
          <div class="space-y-2.5">
            <div class="flex items-center justify-between gap-2">
              <span class="text-[10px] font-mono font-bold text-input-accent uppercase tracking-wider bg-canvas px-2 py-0.5 rounded border border-hairline">
                {sc.seo.badge || sc.category}
              </span>
              <span class="text-muted text-xs group-hover:text-input-accent transition-transform group-hover:translate-x-0.5 font-bold">
                →
              </span>
            </div>

            <h3 class="font-display font-bold text-sm text-ink group-hover:text-input-accent transition-colors line-clamp-2 leading-snug">
              {sc.query}
            </h3>

            <p class="text-xs text-muted font-sans line-clamp-2 leading-relaxed">
              {sc.directAnswer.takeaway}
            </p>
          </div>

          <!-- Highlight Metric Pills -->
          {sc.directAnswer.metrics && sc.directAnswer.metrics.length > 0 && (
            <div class="mt-3.5 pt-3 border-t border-hairline/80 grid grid-cols-2 gap-2">
              {sc.directAnswer.metrics.slice(0, 2).map((m) => (
                <div class="bg-canvas/60 p-1.5 rounded border border-hairline/50">
                  <div class="text-[9px] font-mono text-muted uppercase truncate">{m.label}</div>
                  <div class="text-xs font-mono font-bold text-ink truncate">{m.value}</div>
                </div>
              ))}
            </div>
          )}
        </a>
      ))}
    </div>
  </section>
)}
