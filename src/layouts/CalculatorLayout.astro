---
import Layout from './Layout.astro';
import CalculatorGuide from '../components/ui/CalculatorGuide.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, getPathWithoutLocale } from '../i18n/utils';
import { getLanguageDefaultCurrency, getCurrencyInfo } from '../lib/currency';
import { getLocalizedCategories, PATH_TO_CALC_KEY } from '../lib/calculators';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  seoTitle?: string;
  description?: string;
  faqs?: FAQItem[];
  lastUpdated?: string;
  calcKey?: string;
}

const { title, seoTitle, description, faqs = [], calcKey } = Astro.props;

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const cleanPath = getPathWithoutLocale(Astro.url.pathname);

const defaultCurr = getLanguageDefaultCurrency(lang);
const defaultMeta = getCurrencyInfo(defaultCurr);

// Synchronized calculator routes & categories
const categories = getLocalizedCategories(t);

// Determine related calculators in the same category
const normCleanPath = cleanPath.replace(/\/+$/, '') || '/';
const currentCategory = categories.find(cat => cat.links.some(link => link.url.replace(/\/+$/, '') === normCleanPath));
const relatedLinks = currentCategory 
  ? currentCategory.links.filter(l => l.url.replace(/\/+$/, '') !== normCleanPath).slice(0, 3)
  : [];

// Localized values
const localizedTitle = t(title, title);

let localizedSeoTitle: string;
if (seoTitle) {
  const trSeo = t(seoTitle, seoTitle);
  if (trSeo !== seoTitle) {
    localizedSeoTitle = trSeo;
  } else if (lang === 'ja' || lang === 'pt') {
    localizedSeoTitle = `${localizedTitle} | financialcalculatorapp.com`;
  } else {
    localizedSeoTitle = trSeo;
  }
} else {
  localizedSeoTitle = localizedTitle;
}

let localizedDescription: string | undefined = undefined;
if (description) {
  const trDesc = t(description, description);
  if (trDesc !== description) {
    localizedDescription = trDesc;
  } else if (lang === 'ja' || lang === 'pt') {
    const currentCalcItem = categories.flatMap(cat => cat.calculators).find(c => c.url.replace(/\/+$/, '') === normCleanPath);
    localizedDescription = currentCalcItem?.snippet || undefined;
  } else {
    localizedDescription = trDesc;
  }
}

const localizedFaqs = faqs.map(faq => ({
  question: t(faq.question, faq.question),
  answer: t(faq.answer, faq.answer)
}));

const pathToCalcKey = PATH_TO_CALC_KEY;

const resolvedCalcKey = calcKey || pathToCalcKey[cleanPath] || pathToCalcKey[cleanPath.replace(/\/$/, '')];

// Schema creation
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": localizedTitle,
  "description": localizedDescription,
  "applicationCategory": "FinancialApplication",
  "applicationSubCategory": "FinanceApplication",
  "operatingSystem": "All",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};

const faqSchema = localizedFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": localizedFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://financialcalculatorapp.com').replace(/\/+$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "financialcalculatorapp.com",
      "item": `${siteOrigin}${translatePath('/')}`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t('nav.calculators', 'Calculators'),
      "item": `${siteOrigin}${translatePath('/calculators')}`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": localizedTitle,
      "item": `${siteOrigin}${translatePath(cleanPath)}`
    }
  ]
};
---
<Layout title={localizedSeoTitle} description={localizedDescription} lang={lang}>
  <!-- Inject Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
  

  <div class="page-shell py-6 lg:py-8 flex flex-col lg:flex-row gap-8 items-start">
    <!-- Sidebar / Navigation -->
    <aside class="w-full lg:w-72 flex-shrink-0">
      <!-- Mobile Collapsible Menu -->
      <details id="mobile-nav-details" class="group lg:hidden mb-4 border border-ink rounded-lg bg-paper shadow-[var(--control-shadow)]">
        <summary class="flex items-center justify-between px-4 py-3 text-xs font-mono font-bold uppercase tracking-wider text-ink cursor-pointer select-none">
          <span class="flex items-center gap-2">
            <span>✦</span>
            {t('nav.calculators')}
          </span>
          <svg class="w-4 h-4 text-muted transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="p-4 border-t border-line/20 bg-canvas space-y-6 max-h-[340px] overflow-y-auto">
          {categories.map(cat => (
            <div>
              <h3 class="text-[10px] font-mono text-muted uppercase font-bold tracking-wider mb-2 px-3">{cat.name}</h3>
              <ul class="space-y-1">
                {cat.links.map(link => {
                  const isActive = cleanPath === link.url || cleanPath === `${link.url}/`;
                  return (
                    <li>
                      <a 
                        href={translatePath(link.url)} 
                        class:list={[
                          "block px-3 py-1.5 text-xs font-mono font-bold rounded-full transition-colors",
                          isActive ? "bg-ink text-canvas shadow-[var(--control-shadow)]" : "text-muted hover:text-ink hover:bg-soft"
                        ]}
                      >
                        {link.name}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <!-- Desktop Sidebar -->
      <div class="hidden lg:block space-y-6 sticky top-24 bg-paper border border-ink/40 rounded-lg p-5 shadow-[var(--control-shadow)]">
        {categories.map(cat => (
          <div>
            <h3 class="text-[10px] font-mono text-muted uppercase font-bold tracking-wider mb-2.5 px-2">{cat.name}</h3>
            <ul class="space-y-1">
              {cat.links.map(link => {
                const isActive = cleanPath === link.url || cleanPath === `${link.url}/`;
                return (
                  <li>
                    <a 
                      href={translatePath(link.url)} 
                      class:list={[
                        "block px-3 py-1.5 text-xs font-mono font-bold rounded-full transition-colors",
                        isActive ? "bg-ink text-canvas shadow-[var(--control-shadow)]" : "text-muted hover:text-ink hover:bg-soft"
                      ]}
                    >
                      {link.name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}

        <!-- Saved Scenarios Section -->
        <div class="pt-4 border-t border-line/20">
          <div class="flex items-center justify-between px-2 mb-2">
            <h3 class="text-[10px] font-mono text-muted uppercase font-bold tracking-wider">{t('calc.savedScenarios', 'Saved Scenarios')}</h3>
            <button id="save-scenario-btn" class="text-[10px] text-input-accent hover:underline cursor-pointer font-mono font-bold uppercase" title="Save current inputs">+ {t('calc.save', 'Save')}</button>
          </div>
          <div id="scenarios-list" class="space-y-1 text-xs px-2 font-mono">
            <span class="text-muted text-[11px] block">{t('calc.noSaved', 'No saved scenarios yet.')}</span>
          </div>
          <button id="compare-scenarios-btn" class="hidden w-full mt-2 py-1.5 card-action text-ink text-[11px] font-mono font-bold rounded-full">
            {t('calc.compare', 'Compare Selected (2)')}
          </button>
        </div>

        <button id="print-calculator-btn" class="card-action w-full py-2 text-ink text-xs font-mono font-bold rounded-full mt-3 flex items-center justify-center gap-1.5">
          <span>🖨️</span> {t('calc.print')}
        </button>
        <button id="share-calculator-btn" class="card-action w-full py-2 text-ink text-xs font-mono font-bold rounded-full mt-2 flex items-center justify-center gap-1.5">
          <span>🔗</span> {t('calc.share')}
        </button>
      </div>
    </aside>

    <!-- Main Calculator Content Section -->
    <section class="flex-1 bg-paper border border-ink rounded-lg p-6 lg:p-10 shadow-[var(--control-shadow)] min-h-[600px] relative w-full">

      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs font-mono text-muted mb-4 flex-wrap" aria-label="Breadcrumb">
        <a href={translatePath('/')} class="hover:text-ink transition-colors">{t('nav.home', 'Home')}</a>
        <span>/</span>
        <a href={translatePath('/calculators')} class="hover:text-ink transition-colors font-bold">{t('nav.calculators', 'Calculators')}</a>
        <span>/</span>
        <span class="text-ink font-bold truncate max-w-xs">{localizedTitle}</span>
      </nav>

      <div class="mb-8">
        <h1 class="font-display font-black text-3xl sm:text-4xl tracking-tight text-ink mb-3">{localizedTitle}</h1>
        {localizedDescription && <p class="text-sm sm:text-base text-muted max-w-3xl font-sans leading-relaxed">{localizedDescription}</p>}
      </div>
      <slot />

      <!-- Educational Guide Section -->
      {resolvedCalcKey && <CalculatorGuide calcKey={resolvedCalcKey} />}

      <!-- FAQ Section -->
      {localizedFaqs && localizedFaqs.length > 0 && (
        <div class="border-t-2 border-line mt-12 pt-12 space-y-6 no-print">
          <h2 class="font-display font-black text-2xl tracking-tight text-ink">{t('calc.faqs')}</h2>
          <div class="divide-y divide-line/20">
            {localizedFaqs.map(faq => (
              <details class="group py-4">
                <summary class="flex items-center justify-between text-base font-display font-bold text-ink cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-input-accent rounded">
                  <span>{faq.question}</span>
                  <svg class="w-4 h-4 text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-3 text-sm text-muted font-sans leading-relaxed space-y-2">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Browser Privacy Note -->
      <div class="mt-12 p-4 bg-note-surface border border-note-border rounded-lg text-xs text-ink/80 flex flex-col gap-2 no-print shadow-[var(--control-shadow)]">
        <div class="flex items-center gap-2">
          <span>🔒</span>
          <span><strong>{t('privacy.title', '100% Private:')}</strong> {t('privacy.desc', 'All calculations execute locally in your web browser. We do not store or transmit your financial details.')}</span>
        </div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-t border-note-border/50 pt-2 mt-1">
          <div class="flex items-center gap-2">
            <span>💱</span>
            <span>
              <strong>{t('currency.title', 'Currency Rates:')}</strong>{' '}
              <span id="currency-rate-notice-desc">
                {defaultMeta.code === 'USD'
                  ? t('currency.desc.usd', 'Conversions use benchmark reference rates for convenience.')
                  : `${t('currency.desc.ref', 'Conversions use benchmark reference rates')} (1 USD ≈ ${defaultMeta.rate} ${defaultMeta.code}). Values scale dynamically.`}
              </span>
            </span>
          </div>
          <button
            id="currency-rate-notice-toggle"
            type="button"
            class="card-action self-start sm:self-auto text-[10px] font-mono px-3 py-1 rounded-full text-ink"
            title={t('currency.toggle.title', 'Toggle between dynamic FX conversion and 1:1 nominal units')}
          >
            {t('currency.mode.fx', 'Mode: 💱 FX Rate')}
          </button>
        </div>
      </div>

      <!-- Scenario Comparison Modal -->
      <div id="compare-modal" role="dialog" aria-modal="true" aria-labelledby="compare-modal-title" class="fixed inset-0 bg-ink/50 backdrop-blur-sm z-[100] flex items-center justify-center p-4 hidden no-print">
        <div class="bg-paper border-2 border-ink rounded-xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-[8px_8px_0_color-mix(in_srgb,var(--ink)_20%,transparent)] overflow-hidden animate-fade-in">
          <header class="px-6 py-4 border-b border-line/20 flex items-center justify-between bg-soft">
            <h3 id="compare-modal-title" class="text-sm font-bold text-ink font-mono uppercase tracking-wider">{t('modal.comparisonTitle', 'Scenario Comparison')}</h3>
            <button id="close-compare-modal" aria-label="Close comparison modal" class="text-muted hover:text-ink text-lg font-bold p-1 cursor-pointer">&times;</button>
          </header>
          <div class="p-6 overflow-y-auto space-y-6">
            <div class="overflow-x-auto border border-ink/30 rounded-lg">
              <table class="w-full border-collapse text-left text-xs">
                <thead class="bg-soft border-b border-ink/20 font-mono uppercase text-muted font-bold">
                  <tr>
                    <th class="px-4 py-3">{t('modal.metric', 'Metric')}</th>
                    <th class="px-4 py-3" id="compare-scen-a-title">{t('modal.scenarioA', 'Scenario A')}</th>
                    <th class="px-4 py-3" id="compare-scen-b-title">{t('modal.scenarioB', 'Scenario B')}</th>
                    <th class="px-4 py-3">{t('modal.difference', 'Difference')}</th>
                  </tr>
                </thead>
                <tbody id="compare-modal-tbody" class="divide-y divide-line/15 text-ink font-mono">
                  <!-- Generated comparison rows go here -->
                </tbody>
              </table>
            </div>
          </div>
          <footer class="px-6 py-4 border-t border-line/20 flex justify-end gap-2 bg-soft">
            <button id="close-compare-modal-btn" class="card-action px-4 py-2 text-ink text-xs font-mono font-bold rounded-full">{t('modal.close', 'Close')}</button>
          </footer>
        </div>
      </div>

      <!-- Related Calculators Section -->
      {relatedLinks.length > 0 && (
        <div class="mt-12 border-t-2 border-line pt-8 no-print">
          <h3 class="text-xs font-mono text-muted uppercase font-bold tracking-wider mb-4">{t('calc.related')}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedLinks.map(link => (
              <a href={translatePath(link.url)} class="p-4 bg-paper hover:bg-soft border border-ink/40 rounded-lg shadow-[var(--control-shadow)] hover:shadow-[var(--control-shadow-hover)] transition-all block text-sm font-display font-bold text-ink">
                {link.name} →
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Feedback Widget -->
      <div class="mt-12 border-t border-line/20 pt-6 no-print">
        <div id="feedback-widget-container" class="space-y-4" data-thank-you={t('feedback.thankYou', 'Thank you for your feedback!')}>
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <span class="text-xs text-muted font-mono font-bold uppercase">{t('feedback.helpful', 'Was this calculator helpful?')}</span>
            <div id="feedback-widget" class="flex items-center gap-2" role="group" aria-label="Feedback ratings">
              <button class="feedback-btn card-action px-3.5 py-1.5 text-xs text-ink font-mono font-bold rounded-full" data-val="yes" aria-pressed="false">{t('feedback.yes', '👍 Yes')}</button>
              <button class="feedback-btn card-action px-3.5 py-1.5 text-xs text-ink font-mono font-bold rounded-full" data-val="no" aria-pressed="false">{t('feedback.no', '👎 No')}</button>
            </div>
          </div>
          <div id="feedback-text-container" class="hidden space-y-2.5 max-w-xl transition-all duration-300">
            <label for="feedback-comment" class="sr-only">{t('feedback.placeholder', 'Any comments or suggestions? (Optional)')}</label>
            <textarea
              id="feedback-comment"
              placeholder={t('feedback.placeholder', 'Any comments or suggestions? (Optional)')}
              rows="3"
              class="w-full p-3 bg-canvas border border-hairline text-ink text-xs rounded-lg focus-visible:ring-2 focus-visible:ring-primary focus-visible:outline-none transition-colors resize-none"
            ></textarea>
            <div class="flex justify-end gap-2">
              <button type="button" id="feedback-skip-btn" class="px-3.5 py-1 bg-canvas hover:bg-canvas-soft text-mute text-xs border border-hairline rounded-full cursor-pointer transition-colors font-medium">{t('feedback.skip', 'Skip')}</button>
              <button type="button" id="feedback-submit-btn" class="px-4 py-1.5 bg-primary text-on-primary text-xs rounded-full cursor-pointer hover:opacity-90 transition-opacity font-semibold">{t('feedback.submit', 'Submit Comments')}</button>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { safeSetItem, safeGetJSON } from '../lib/storage';
  import { escapeHtml } from '../lib/utils';
  import { getPathWithoutLocale } from '../i18n/utils';
  import {
    getEffectiveCurrency,
    getCurrencySymbol,
    getCurrencyInfo,
    isManualCurrencyOverride,
    getConversionMode,
    type ConversionMode
  } from '../lib/currency';

  // Feedback Widget Handlers
  const buttons = document.querySelectorAll('.feedback-btn');
  const textContainer = document.getElementById('feedback-text-container');
  const commentTextarea = document.getElementById('feedback-comment') as HTMLTextAreaElement | null;
  const skipBtn = document.getElementById('feedback-skip-btn');
  const submitBtn = document.getElementById('feedback-submit-btn');
  const widgetContainer = document.getElementById('feedback-widget-container');

  let selectedRating: string | null = null;

  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      buttons.forEach(b => {
        b.classList.remove('bg-canvas-soft-2', 'border-hairline-strong');
        b.setAttribute('aria-pressed', 'false');
      });
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-canvas-soft-2', 'border-hairline-strong');
      target.setAttribute('aria-pressed', 'true');

      selectedRating = target.dataset.val || 'yes';

      if (textContainer) {
        textContainer.classList.remove('hidden');
      }
    });
  });

  function saveFeedback(comment = '') {
    if (!selectedRating) return;
    const pageUrl = window.location.pathname;
    const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];

    const payload = {
      url: pageUrl,
      name: pageName,
      rating: selectedRating,
      message: comment.trim()
    };

    // 1. Submit to server API endpoint
    fetch('/api/feedback', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    }).catch(err => {
      console.error('Error submitting feedback to server:', err);
    });

    // 2. Fallback / save to local storage for backward compatibility & local display
    let feedbackList = safeGetJSON<any[]>('feedback_responses', []);
    if (!Array.isArray(feedbackList)) feedbackList = [];

    feedbackList.push({
      ...payload,
      timestamp: Date.now()
    });
    if (feedbackList.length > 50) feedbackList = feedbackList.slice(-50);

    safeSetItem('feedback_responses', JSON.stringify(feedbackList));

    if (widgetContainer) {
      const thankYouMsg = widgetContainer.getAttribute('data-thank-you') || 'Thank you for your feedback!';
      widgetContainer.innerHTML = `<span class="text-xs text-success font-medium animate-fade-in">${thankYouMsg}</span>`;
    }
  }

  skipBtn?.addEventListener('click', () => {
    saveFeedback();
  });

  submitBtn?.addEventListener('click', () => {
    const comment = commentTextarea?.value || '';
    saveFeedback(comment);
  });

  // 1. Record Visited page inside recent_calculators
  if (typeof window !== 'undefined') {
    const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];
    const rawPath = window.location.pathname;
    const cleanPath = getPathWithoutLocale(rawPath);

    const ignoredPaths = ['/', '/about', '/contact', '/privacy', '/terms', '/disclaimer', '/feedback', '/calculators'];
    if (!ignoredPaths.includes(cleanPath) && !cleanPath.includes('/blog') && !cleanPath.includes('/compare')) {
      let recents = safeGetJSON<any[]>('recent_calculators', []);
      if (!Array.isArray(recents)) recents = [];
      recents = recents.filter((item: any) => item && item.url !== rawPath);
      recents.unshift({ name: pageName, url: rawPath });
      if (recents.length > 5) recents.pop();
      safeSetItem('recent_calculators', JSON.stringify(recents));
    }
  }

  // 2. Scenario Saving & Loading Logic
  const saveBtn = document.getElementById('save-scenario-btn');
  const scenariosList = document.getElementById('scenarios-list');
  const form = document.querySelector('form');
  const scenarioKey = `scenarios:${getPathWithoutLocale(window.location.pathname)}`;

    let selectedIndices: number[] = [];

    function updateScenariosUI() {
      if (!scenariosList) return;
      const saved = safeGetJSON<any[]>(scenarioKey, []);
      if (!Array.isArray(saved) || saved.length === 0) {
        scenariosList.innerHTML = `<span class="text-mute text-[11px] block">No saved scenarios yet.</span>`;
        selectedIndices = [];
        updateCompareButton();
        return;
      }
      
      scenariosList.innerHTML = saved.map((scenario: any, idx: number) => `
        <div class="group flex items-center justify-between gap-2 p-1.5 hover:bg-canvas-soft-2 rounded transition-colors border border-transparent hover:border-hairline">
          <input type="checkbox" class="compare-checkbox w-3.5 h-3.5 rounded border-hairline cursor-pointer text-primary focus:ring-transparent bg-canvas" data-index="${idx}" title="Select for comparison" ${selectedIndices.includes(idx) ? 'checked' : ''} />
          <button class="load-scenario-btn text-left text-ink font-medium truncate flex-1 block" data-index="${idx}" title="Click to load scenario">
            ${escapeHtml(scenario.name)}
          </button>
          <button class="delete-scenario-btn opacity-0 group-hover:opacity-100 text-mute hover:text-error transition-opacity font-bold px-1" data-index="${idx}" title="Delete scenario">
            &times;
          </button>
        </div>
      `).join('');

      // Bind load listeners
      scenariosList.querySelectorAll('.load-scenario-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
          loadScenario(idx);
        });
      });

      // Bind delete listeners
      scenariosList.querySelectorAll('.delete-scenario-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
          deleteScenario(idx);
        });
      });

      // Bind compare checkbox handlers
      const checkboxes = scenariosList.querySelectorAll('.compare-checkbox');
      checkboxes.forEach(cb => {
        cb.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.dataset.index || '0');
          if (target.checked) {
            selectedIndices.push(idx);
            if (selectedIndices.length > 2) {
              // Uncheck the oldest one
              const oldestIdx = selectedIndices.shift()!;
              const oldestCb = scenariosList.querySelector(`.compare-checkbox[data-index="${oldestIdx}"]`) as HTMLInputElement | null;
              if (oldestCb) oldestCb.checked = false;
            }
          } else {
            selectedIndices = selectedIndices.filter(i => i !== idx);
          }
          updateCompareButton();
        });
      });

      updateCompareButton();
    }

    function updateCompareButton() {
      const compareBtn = document.getElementById('compare-scenarios-btn');
      if (compareBtn) {
        if (selectedIndices.length === 2) {
          compareBtn.classList.remove('hidden');
          compareBtn.innerHTML = `<span>📊</span> Compare (2/2)`;
        } else {
          compareBtn.classList.add('hidden');
        }
      }
    }

    // Capture comparison logic click
    const compareBtn = document.getElementById('compare-scenarios-btn');
    compareBtn?.addEventListener('click', () => {
      if (selectedIndices.length !== 2) return;
      
      const saved = safeGetJSON<any[]>(scenarioKey, []);
      const scA = Array.isArray(saved) ? saved[selectedIndices[0]] : undefined;
      const scB = Array.isArray(saved) ? saved[selectedIndices[1]] : undefined;
      
      if (!scA || !scB || !form) return;

      const titleA = document.getElementById('compare-scen-a-title');
      const titleB = document.getElementById('compare-scen-b-title');
      if (titleA) titleA.textContent = scA.name;
      if (titleB) titleB.textContent = scB.name;

      // 1. Capture current form inputs
      const currentInputs: Record<string, string | boolean> = {};
      Array.from(form.elements).forEach((el: any) => {
        if (el.name) {
          currentInputs[el.name] = el.type === 'checkbox' ? el.checked : el.value;
        }
      });

      const applyInputsAndRun = (data: Record<string, any>) => {
        Object.entries(data).forEach(([name, val]) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
          if (el) {
            if (el.type === 'checkbox') {
              (el as HTMLInputElement).checked = val === true;
            } else {
              el.value = String(val);
            }
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      };

      const extractInputs = () => {
        const result: Record<string, { label: string, value: string, numeric: number }> = {};
        Array.from(form.elements).forEach((el: any) => {
          if (el.name && el.type !== 'submit' && el.type !== 'reset' && el.type !== 'button') {
            let labelText = el.name;
            const labelEl = document.querySelector(`label[for="${el.id}"]`);
            if (labelEl) {
              labelText = labelEl.textContent || el.name;
            } else {
              const parentLabel = el.closest('div')?.querySelector('label');
              if (parentLabel) labelText = parentLabel.textContent || el.name;
            }
            labelText = labelText.replace(/:$/, '').trim();

            let displayVal = el.value;
            if (el.type === 'checkbox') {
              displayVal = el.checked ? 'Yes' : 'No';
            } else if (el.tagName === 'SELECT') {
              displayVal = el.options[el.selectedIndex]?.text || el.value;
            }

            const rawVal = el.type === 'checkbox' ? (el.checked ? 1 : 0) : parseFloat(el.value.replace(/,/g, ''));
            result[el.name] = {
              label: labelText,
              value: displayVal,
              numeric: isNaN(rawVal) ? 0 : rawVal
            };
          }
        });
        return result;
      };

      const extractOutputs = () => {
        const result: Record<string, { label: string, value: string, numeric: number }> = {};
        document.querySelectorAll('.result-card, [id^="res-"]').forEach((card, idx) => {
          const titleEl = card.querySelector('h4, .text-xs, .text-[10px]');
          const valEl = card.querySelector('.font-mono, p.text-3xl, .text-3xl');
          if (titleEl && valEl) {
            const labelText = titleEl.textContent?.trim() || `Output ${idx + 1}`;
            const displayVal = valEl.textContent?.trim() || '';
            const rawVal = parseFloat(displayVal.replace(/[^0-9.-]/g, ''));
            result[labelText] = {
              label: labelText,
              value: displayVal,
              numeric: isNaN(rawVal) ? 0 : rawVal
            };
          }
        });
        return result;
      };

      // Run Scenario A
      applyInputsAndRun(scA.data);
      const inputsA = extractInputs();
      const outputsA = extractOutputs();

      // Run Scenario B
      applyInputsAndRun(scB.data);
      const inputsB = extractInputs();
      const outputsB = extractOutputs();

      // Restore original inputs
      applyInputsAndRun(currentInputs);

      // Build Comparison Table Rows
      const compareTbody = document.getElementById('compare-modal-tbody');
      if (compareTbody) {
        let rowsHtml = '';

        // Add Inputs Header
        rowsHtml += `<tr class="bg-canvas-soft font-mono uppercase text-mute font-semibold"><td colspan="4" class="px-4 py-2 text-[10px]">Form Inputs</td></tr>`;

        Object.keys(inputsA).forEach(name => {
          const itemA = inputsA[name];
          const itemB = inputsB[name] || { value: '-', numeric: 0 };
          const diff = itemB.numeric - itemA.numeric;
          let diffHtml = '-';
          if (typeof itemA.numeric === 'number' && !isNaN(itemA.numeric) && itemA.value !== 'Yes' && itemA.value !== 'No') {
            const isPct = name.includes('rate') || name.includes('pct') || name.includes('percent');
            const isCurr = !isPct && (name.includes('price') || name.includes('down') || name.includes('payment') || name.includes('amount') || name.includes('cost') || name.includes('contrib') || name.includes('ins') || name.includes('hoa') || name.includes('balance') || name.includes('budget') || name.includes('fee'));
            
            const diffSymbol = diff >= 0 ? '+' : '';
            if (isCurr) {
              const symbol = getCurrencySymbol(getEffectiveCurrency());
              diffHtml = `${diffSymbol}${symbol}${diff.toLocaleString(undefined, { maximumFractionDigits: 0 })}`;
            } else if (isPct) {
              diffHtml = `${diffSymbol}${diff.toFixed(2)}%`;
            } else {
              diffHtml = `${diffSymbol}${diff.toFixed(1)}`;
            }
          }

          rowsHtml += `
            <tr class="hover:bg-canvas-soft transition-colors">
              <td class="px-4 py-2.5 font-semibold text-ink">${escapeHtml(itemA.label)}</td>
              <td class="px-4 py-2.5 font-mono">${escapeHtml(itemA.value)}</td>
              <td class="px-4 py-2.5 font-mono">${escapeHtml(itemB.value)}</td>
              <td class="px-4 py-2.5 font-mono ${diff > 0 ? 'text-link' : diff < 0 ? 'text-error' : 'text-mute'}">${escapeHtml(diffHtml)}</td>
            </tr>
          `;
        });

        // Add Outputs Header
        rowsHtml += `<tr class="bg-canvas-soft font-mono uppercase text-mute font-semibold"><td colspan="4" class="px-4 py-2 text-[10px]">Calculated Results</td></tr>`;

        Object.keys(outputsA).forEach(label => {
          const itemA = outputsA[label];
          const itemB = outputsB[label] || { value: '-', numeric: 0 };
          const diff = itemB.numeric - itemA.numeric;
          let diffHtml = '-';

          if (!isNaN(diff)) {
            const diffSymbol = diff >= 0 ? '+' : '';
            const isPct = itemA.value.includes('%');
            const isCurr = itemA.value.includes('$') || itemA.value.includes('€') || itemA.value.includes('£') || itemA.value.includes('₹') || label.toLowerCase().includes('interest') || label.toLowerCase().includes('balance') || label.toLowerCase().includes('amount') || label.toLowerCase().includes('cost') || label.toLowerCase().includes('gain') || label.toLowerCase().includes('payment') || label.toLowerCase().includes('proceeds') || label.toLowerCase().includes('shortfall') || label.toLowerCase().includes('net');

            if (isCurr) {
              const symbol = getCurrencySymbol(getEffectiveCurrency());
              diffHtml = `${diffSymbol}${symbol}${diff.toLocaleString(undefined, { maximumFractionDigits: 0 })}`;
            } else if (isPct) {
              diffHtml = `${diffSymbol}${diff.toFixed(2)}%`;
            } else {
              diffHtml = `${diffSymbol}${diff.toFixed(1)}`;
            }
          }

          rowsHtml += `
            <tr class="hover:bg-canvas-soft transition-colors font-medium">
              <td class="px-4 py-2.5 text-ink">${escapeHtml(itemA.label)}</td>
              <td class="px-4 py-2.5 font-mono text-ink">${escapeHtml(itemA.value)}</td>
              <td class="px-4 py-2.5 font-mono text-ink">${escapeHtml(itemB.value)}</td>
              <td class="px-4 py-2.5 font-mono ${diff > 0 ? 'text-link font-semibold' : diff < 0 ? 'text-error font-semibold' : 'text-mute'}">${escapeHtml(diffHtml)}</td>
            </tr>
          `;
        });

        compareTbody.innerHTML = rowsHtml;
      }

      // Show modal
      const modal = document.getElementById('compare-modal');
      if (modal) modal.classList.remove('hidden');
    });

    // Close Modal Listeners
    const compModal = document.getElementById('compare-modal');
    const closeIds = ['close-compare-modal', 'close-compare-modal-btn'];
    closeIds.forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        compModal?.classList.add('hidden');
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        compModal?.classList.add('hidden');
      }
    });

    compModal?.addEventListener('click', (e) => {
      if (e.target === compModal) {
        compModal.classList.add('hidden');
      }
    });

    // Print handler (button exists in sidebar but was previously unwired)
    document.getElementById('print-calculator-btn')?.addEventListener('click', () => {
      window.print();
    });

    // Copy Share URL Click Handler
    const shareBtn = document.getElementById('share-calculator-btn');
    shareBtn?.addEventListener('click', () => {
      const urlObj = new URL(window.location.href);
      if (isManualCurrencyOverride()) {
        urlObj.searchParams.set('currency', getEffectiveCurrency());
      }
      const url = urlObj.toString();
      navigator.clipboard.writeText(url).then(() => {
        const originalText = shareBtn.innerHTML;
        shareBtn.innerHTML = '<span>✅</span> Link Copied!';
        setTimeout(() => {
          shareBtn.innerHTML = originalText;
        }, 2000);
      }).catch(err => {
        alert("Failed to copy link: " + err);
      });
    });

    // Global URL Sync (for pages that don't have it manually configured)
    if (typeof window !== 'undefined' && form) {
      if (form.getAttribute('data-synced') !== 'true') {
        const params = new URLSearchParams(window.location.search);
        
        // 1. Sync from URL on load
        Array.from(form.elements).forEach((el: any) => {
          const input = el as HTMLInputElement | HTMLSelectElement;
          const nameOrId = input.name || input.id;
          if (!nameOrId || nameOrId === 'currency-select') return;
          
          const value = params.get(nameOrId);
          if (value !== null && value.length <= 100) {
            if (input.type === 'checkbox') {
              (input as HTMLInputElement).checked = value === 'true';
            } else {
              // Sanitize numeric inputs against extreme scientific notation
              if (input.type === 'number') {
                const num = parseFloat(value);
                if (isFinite(num) && Math.abs(num) <= 1e12) {
                  input.value = value;
                }
              } else {
                input.value = value;
              }
            }
          }
        });

        // Trigger updates once page completes loading
        window.addEventListener('load', () => {
          setTimeout(() => {
            Array.from(form.elements).forEach((el: any) => {
              el.dispatchEvent(new Event('input', { bubbles: true }));
              el.dispatchEvent(new Event('change', { bubbles: true }));
            });
          }, 100);
        });

        // 2. Sync to URL on input/change
        const handleGlobalInputSync = () => {
          const newParams = new URLSearchParams();
          if (isManualCurrencyOverride()) {
            newParams.set('currency', getEffectiveCurrency());
          }
          Array.from(form.elements).forEach((el: any) => {
            const input = el as HTMLInputElement | HTMLSelectElement;
            const nameOrId = input.name || input.id;
            if (!nameOrId || nameOrId === 'currency-select') return;

            if (input.type === 'checkbox') {
              if ((input as HTMLInputElement).checked) {
                newParams.set(nameOrId, 'true');
              }
            } else if (input.value && input.value !== (input instanceof HTMLInputElement ? input.defaultValue : '')) {
              newParams.set(nameOrId, input.value);
            }
          });
          const newQueryString = newParams.toString();
          const newUrl = `${window.location.pathname}${newQueryString ? '?' + newQueryString : ''}`;
          window.history.replaceState(null, '', newUrl);
        };

        form.addEventListener('input', handleGlobalInputSync);
        form.addEventListener('change', handleGlobalInputSync);
        form.setAttribute('data-synced', 'true');
      }
    }

  function loadScenario(idx: number) {
    if (!form) return;
    const saved = safeGetJSON<any[]>(scenarioKey, []);
    const scenario = Array.isArray(saved) ? saved[idx] : null;
    if (!scenario || !scenario.data) return;

    Object.entries(scenario.data).forEach(([name, val]: [string, any]) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (input) {
        if (input.type === 'checkbox') {
          (input as HTMLInputElement).checked = val === true;
        } else {
          input.value = String(val);
        }
        // Dispatch events so calculation scripts pick it up
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }

  function deleteScenario(idx: number) {
    const saved = safeGetJSON<any[]>(scenarioKey, []);
    if (!Array.isArray(saved)) return;
    saved.splice(idx, 1);
    safeSetItem(scenarioKey, JSON.stringify(saved));
    updateScenariosUI();
  }

  saveBtn?.addEventListener('click', () => {
    if (!form) {
      alert("No input form found on this page.");
      return;
    }
    const name = prompt("Enter a name for this scenario:");
    if (!name || !name.trim()) return;

    const data: Record<string, any> = {};
    Array.from(form.elements).forEach((el: any) => {
      const input = el as HTMLInputElement | HTMLSelectElement;
      if (input.name) {
        data[input.name] = input.type === 'checkbox' ? (input as HTMLInputElement).checked : input.value;
      }
    });

    const saved = safeGetJSON<any[]>(scenarioKey, []);
    const safeSaved = Array.isArray(saved) ? saved : [];
    safeSaved.push({ name: name.trim().slice(0, 50), data, timestamp: Date.now() });
    if (safeSaved.length > 50) safeSaved.shift();
    safeSetItem(scenarioKey, JSON.stringify(safeSaved));
    updateScenariosUI();
  });

  // Run initial UI update for scenarios
  updateScenariosUI();

  // Dynamic currency rate notice update
  function updateCurrencyNotice(currCode?: string, mode?: ConversionMode) {
    const activeCode = currCode || getEffectiveCurrency();
    const currentMode = mode || getConversionMode();
    const meta = getCurrencyInfo(activeCode);
    const descEl = document.getElementById('currency-rate-notice-desc');
    const noticeToggle = document.getElementById('currency-rate-notice-toggle');

    if (noticeToggle) {
      noticeToggle.textContent = currentMode === 'convert' ? 'Mode: 💱 FX Rate' : 'Mode: 🏷️ 1:1 Nominal';
      noticeToggle.title = currentMode === 'convert'
        ? 'Currently converting amounts via exchange rates. Click to switch to 1:1 nominal units.'
        : 'Currently using nominal units (1:1) without conversion. Click to switch to FX rate conversions.';
    }

    if (descEl) {
      if (currentMode === 'symbol_only') {
        descEl.textContent = 'Nominal Mode: values represent local units directly (1:1) without conversion.';
      } else if (meta.code === 'USD') {
        descEl.textContent = 'Conversions use benchmark reference rates for convenience.';
      } else {
        descEl.textContent = `Conversions use benchmark reference rates (1 USD ≈ ${meta.rate} ${meta.code}). Values scale dynamically.`;
      }
    }
  }

  updateCurrencyNotice();
  window.addEventListener('currency-change', (e: any) => {
    updateCurrencyNotice(e.detail);
  });
  window.addEventListener('currency-mode-change', (e: any) => {
    updateCurrencyNotice(undefined, e.detail);
  });
  document.addEventListener('astro:page-load', () => updateCurrencyNotice());

  // Close mobile navigation collapsible details menu when clicking outside or on a link
  const mobileNavDetails = document.getElementById('mobile-nav-details') as HTMLDetailsElement | null;
  if (mobileNavDetails) {
    document.addEventListener('click', (e) => {
      if (!mobileNavDetails.contains(e.target as Node)) {
        mobileNavDetails.removeAttribute('open');
      }
    });

    mobileNavDetails.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNavDetails.removeAttribute('open');
      });
    });
  }
</script>
