---
import Layout from './Layout.astro';
import CalculatorGuide from '../components/ui/CalculatorGuide.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, getPathWithoutLocale } from '../i18n/utils';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description?: string;
  faqs?: FAQItem[];
  lastUpdated?: string;
  calcKey?: string;
}

const { title, description, faqs = [], lastUpdated = 'July 2026', calcKey } = Astro.props;

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const cleanPath = getPathWithoutLocale(Astro.url.pathname);

// Expanded calculator routes
const categories = [
  {
    name: t('cat.finance', 'Finance & Investment'),
    links: [
      { name: t('calc.tvm.name', 'TVM Calculator'), url: '/finance/tvm' },
      { name: t('calc.compound.name', 'Compound Interest Calculator'), url: '/finance/compound-interest' },
      { name: t('calc.roi.name', 'ROI Calculator'), url: '/finance/roi' },
      { name: t('calc.savingsgoal.name', 'Savings Goal Calculator'), url: '/finance/savings-goal' },
      { name: t('calc.stockreturn.name', 'Stock Return Calculator'), url: '/finance/stock-return' },
      { name: t('calc.capm.name', 'CAPM Calculator'), url: '/finance/capm' },
      { name: t('calc.dividend.name', 'Dividend Calculator'), url: '/finance/dividend' },
      { name: t('calc.inflation.name', 'Inflation Calculator'), url: '/finance/inflation' },
      { name: t('calc.paycheck.name', 'Paycheck Calculator'), url: '/finance/paycheck' },
      { name: t('calc.networth.name', 'Net Worth Tracker'), url: '/finance/net-worth' },
      { name: t('calc.emergencyfund.name', 'Emergency Fund Calculator'), url: '/finance/emergency-fund' },
      { name: t('calc.feeimpact.name', 'Investment Fee Calculator'), url: '/finance/fee-impact' },
      { name: t('calc.collegesavings.name', 'College Savings (529)'), url: '/finance/college-savings' },
      { name: t('calc.cryptodca.name', 'Crypto DCA Calculator'), url: '/finance/crypto-dca' },
    ]
  },
  {
    name: t('cat.loan', 'Loan & Mortgage'),
    links: [
      { name: t('calc.loan.name', 'Loan Calculator'), url: '/loan/calculator' },
      { name: t('calc.mortgage.name', 'Mortgage Calculator'), url: '/loan/mortgage' },
      { name: t('calc.debtsnowball.name', 'Debt Snowball vs Avalanche'), url: '/loan/debt-payoff' },
      { name: t('calc.loanrefinance.name', 'Loan Refinance Calculator'), url: '/loan/refinance' },
      { name: t('calc.studentloan.name', 'Student Loan IDR Calculator'), url: '/loan/student-loan' },
      { name: t('calc.dti.name', 'Debt-to-Income (DTI) Calculator'), url: '/loan/dti' },
      { name: t('calc.apr.name', 'APR Calculator'), url: '/loan/apr' },
      { name: t('calc.rentvsbuy.name', 'Rent vs Buy Calculator'), url: '/loan/rent-vs-buy' },
      { name: t('calc.homeaffordability.name', 'Home Affordability Calculator'), url: '/loan/home-affordability' },
    ]
  },
  {
    name: t('cat.retirement', 'Retirement'),
    links: [
      { name: t('calc.retirement.name', 'Retirement Planner'), url: '/retirement/planner' },
      { name: t('calc.401k.name', '401k Contribution Calculator'), url: '/retirement/401k' },
      { name: t('calc.iracomparison.name', 'Roth vs Trad IRA'), url: '/retirement/ira-comparison' },
    ]
  },
  {
    name: t('cat.credit', 'Credit Card & Auto'),
    links: [
      { name: t('calc.creditcardpayoff.name', 'Credit Card Payoff Calculator'), url: '/credit-card/payoff' },
      { name: t('calc.autoloan.name', 'Auto Loan Calculator'), url: '/auto/loan' },
    ]
  },
  {
    name: t('cat.misc', 'Miscellaneous'),
    links: [
      { name: t('calc.tip.name', 'Tip Calculator'), url: '/misc/tip' },
      { name: t('calc.discount.name', 'Discount and Tax Calculator'), url: '/misc/discount' },
    ]
  }
];

// Determine related calculators in the same category
const currentCategory = categories.find(cat => cat.links.some(link => link.url === cleanPath));
const relatedLinks = currentCategory 
  ? currentCategory.links.filter(l => l.url !== cleanPath).slice(0, 3)
  : [];

// Localized values
const localizedTitle = t(title, title);
const localizedDescription = description ? t(description, description) : undefined;
const localizedFaqs = faqs.map(faq => ({
  question: t(faq.question, faq.question),
  answer: t(faq.answer, faq.answer)
}));

const pathToCalcKey: Record<string, string> = {
  '/loan/mortgage': 'mortgage',
  '/loan/calculator': 'loan',
  '/loan/debt-payoff': 'debt-payoff',
  '/loan/refinance': 'refinance',
  '/loan/student-loan': 'student-loan',
  '/loan/dti': 'dti',
  '/loan/apr': 'apr',
  '/loan/rent-vs-buy': 'rent-vs-buy',
  '/loan/home-affordability': 'home-affordability',
  '/auto/loan': 'auto-loan',
  '/credit-card/payoff': 'credit-card-payoff',
  '/retirement/planner': 'retirement-planner',
  '/retirement/401k': '401k',
  '/retirement/ira-comparison': 'ira-comparison',
  '/finance/compound-interest': 'compound-interest',
  '/finance/tvm': 'tvm',
  '/finance/roi': 'roi',
  '/finance/savings-goal': 'savings-goal',
  '/finance/stock-return': 'stock-return',
  '/finance/capm': 'capm',
  '/finance/dividend': 'dividend',
  '/finance/inflation': 'inflation',
  '/finance/paycheck': 'paycheck',
  '/finance/net-worth': 'net-worth',
  '/finance/emergency-fund': 'emergency-fund',
  '/finance/fee-impact': 'fee-impact',
  '/finance/college-savings': 'college-savings',
  '/finance/crypto-dca': 'crypto-dca',
  '/misc/tip': 'tip',
  '/misc/discount': 'discount'
};

const resolvedCalcKey = calcKey || pathToCalcKey[cleanPath] || pathToCalcKey[cleanPath.replace(/\/$/, '')];

// Schema creation
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": localizedTitle,
  "description": localizedDescription,
  "applicationCategory": "FinancialApplication",
  "operatingSystem": "All"
};

const faqSchema = localizedFaqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": localizedFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---
<Layout title={localizedTitle} description={localizedDescription} lang={lang}>
  <!-- Inject Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  

  <div class="max-w-[1400px] mx-auto py-4 lg:py-8 flex flex-col lg:flex-row gap-8">
    <!-- Sidebar / Mobile Navigation -->
    <aside class="w-full lg:w-64 flex-shrink-0">
      <!-- Mobile Collapsible Menu -->
      <details id="mobile-nav-details" class="lg:hidden mb-4 border border-hairline rounded bg-canvas shadow-sm">
        <summary class="flex items-center justify-between px-4 py-3 text-sm font-medium text-ink cursor-pointer select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            {t('nav.calculators')}
          </span>
          <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="p-4 border-t border-hairline bg-canvas-soft space-y-6 max-h-[300px] overflow-y-auto">
          {categories.map(cat => (
            <div>
              <h3 class="text-[10px] font-mono text-mute uppercase tracking-wider mb-2 px-3">{cat.name}</h3>
              <ul class="space-y-1">
                {cat.links.map(link => {
                  const isActive = cleanPath === link.url || cleanPath === `${link.url}/`;
                  return (
                    <li>
                      <a 
                        href={translatePath(link.url)} 
                        class:list={[
                          "block px-3 py-1.5 text-sm rounded transition-colors",
                          isActive ? "bg-canvas-soft-2 text-ink font-semibold border-l-2 border-primary rounded-l-none" : "text-body hover:text-ink hover:bg-canvas-soft"
                        ]}
                      >
                        {link.name}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <!-- Desktop Sticky Navigation -->
      <nav class="hidden lg:block sticky top-24 space-y-8">
        {categories.map(cat => (
          <div>
            <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-3 px-3">{cat.name}</h3>
            <ul class="space-y-1">
              {cat.links.map(link => {
                const isActive = cleanPath === link.url || cleanPath === `${link.url}/`;
                return (
                  <li>
                    <a 
                      href={translatePath(link.url)} 
                      class:list={[
                        "block px-3 py-1.5 text-sm rounded transition-colors",
                        isActive ? "bg-canvas-soft-2 text-ink font-semibold border-l-2 border-primary rounded-l-none" : "text-body hover:text-ink hover:bg-canvas-soft"
                      ]}
                    >
                      {link.name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Saved Scenarios section in sidebar -->
      <div id="saved-scenarios-sidebar" class="bg-canvas-soft border border-hairline rounded-lg p-4 space-y-3 no-print mt-6 hidden lg:block">
        <h3 class="text-[10px] font-mono text-mute uppercase tracking-wider">{t('scenario.savedTitle', 'My Saved Scenarios')}</h3>
        <div id="scenarios-list" class="space-y-1.5 text-xs text-mute">
          {t('scenario.noSaved', 'No saved scenarios yet.')}
        </div>
        <button id="save-scenario-btn" class="w-full py-1.5 bg-canvas hover:bg-canvas-soft-2 border border-hairline text-ink text-xs rounded transition-colors cursor-pointer font-medium mt-2 flex items-center justify-center gap-1.5">
          <span>💾</span> {t('calc.saveInputs', 'Save Inputs')}
        </button>
        <button id="compare-scenarios-btn" class="w-full py-1.5 bg-canvas hover:bg-canvas-soft-2 border border-hairline text-ink text-xs rounded transition-colors cursor-pointer font-medium mt-1 flex items-center justify-center gap-1.5 hidden">
          <span>📊</span> {t('calc.compare', 'Compare (0/2)')}
        </button>
        <button id="share-calculator-btn" class="w-full py-1.5 bg-canvas hover:bg-canvas-soft-2 border border-hairline text-ink text-xs rounded transition-colors cursor-pointer font-medium mt-1 flex items-center justify-center gap-1.5">
          <span>🔗</span> {t('calc.share')}
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 bg-canvas border border-hairline rounded-lg p-6 lg:p-10 shadow-sm min-h-[600px] relative">

      <div class="mb-10">
        <h1 class="text-3xl font-semibold tracking-[-1.28px] text-ink mb-3">{localizedTitle}</h1>
        {localizedDescription && <p class="text-body text-base max-w-3xl">{localizedDescription}</p>}
        {lastUpdated && <p class="text-[11px] text-mute font-mono mt-2">{t('calc.lastUpdated')}: {lastUpdated}</p>}
      </div>
      <slot />

      <!-- Educational Guide Section -->
      {resolvedCalcKey && <CalculatorGuide calcKey={resolvedCalcKey} />}

      <!-- FAQ Section -->
      {localizedFaqs && localizedFaqs.length > 0 && (
        <div class="border-t border-hairline mt-12 pt-12 space-y-6 no-print">
          <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">{t('calc.faqs')}</h2>
          <div class="divide-y divide-hairline">
            {localizedFaqs.map(faq => (
              <details class="group py-4">
                <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
                  <span>{faq.question}</span>
                  <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Browser Privacy Note -->
      <div class="mt-12 p-4 bg-canvas-soft border border-hairline border-dashed rounded-md text-xs text-mute flex flex-col gap-2 no-print">
        <div class="flex items-center gap-2">
          <span>🔒</span>
          <span><strong>{t('privacy.title', '100% Private:')}</strong> {t('privacy.desc', 'All calculations execute locally in your web browser. We do not store or transmit your financial details.')}</span>
        </div>
        <div class="flex items-center gap-2 border-t border-hairline/60 pt-2 mt-1">
          <span>💱</span>
          <span><strong>{t('currency.title', 'Currency Rates:')}</strong> {t('currency.desc', 'Conversions use static rates (1 USD = 0.92 EUR = 0.79 GBP = 83 INR) for convenience.')}</span>
        </div>
      </div>

      <!-- Scenario Comparison Modal -->
      <div id="compare-modal" class="fixed inset-0 bg-ink/40 backdrop-blur-sm z-[100] flex items-center justify-center p-4 hidden no-print">
        <div class="bg-canvas border border-hairline rounded-xl max-w-2xl w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden animate-fade-in">
          <header class="px-6 py-4 border-b border-hairline flex items-center justify-between bg-canvas-soft">
            <h3 class="text-sm font-semibold text-ink font-mono uppercase tracking-wider">{t('modal.comparisonTitle', 'Scenario Comparison')}</h3>
            <button id="close-compare-modal" class="text-mute hover:text-ink text-lg font-bold p-1 cursor-pointer">&times;</button>
          </header>
          <div class="p-6 overflow-y-auto space-y-6">
            <div class="overflow-x-auto border border-hairline rounded-lg">
              <table class="w-full border-collapse text-left text-xs">
                <thead class="bg-canvas-soft border-b border-hairline font-mono uppercase text-mute">
                  <tr>
                    <th class="px-4 py-3">{t('modal.metric', 'Metric')}</th>
                    <th class="px-4 py-3" id="compare-scen-a-title">{t('modal.scenarioA', 'Scenario A')}</th>
                    <th class="px-4 py-3" id="compare-scen-b-title">{t('modal.scenarioB', 'Scenario B')}</th>
                    <th class="px-4 py-3">{t('modal.difference', 'Difference')}</th>
                  </tr>
                </thead>
                <tbody id="compare-modal-tbody" class="divide-y divide-hairline text-body text-ink">
                  <!-- Generated comparison rows go here -->
                </tbody>
              </table>
            </div>
          </div>
          <footer class="px-6 py-4 border-t border-hairline flex justify-end gap-2 bg-canvas-soft">
            <button id="close-compare-modal-btn" class="px-4 py-2 bg-canvas hover:bg-canvas-soft border border-hairline text-ink text-xs font-semibold rounded-full cursor-pointer transition-colors shadow-sm">{t('modal.close', 'Close')}</button>
          </footer>
        </div>
      </div>

      <!-- Related Calculators Section -->
      {relatedLinks.length > 0 && (
        <div class="mt-12 border-t border-hairline pt-8 no-print">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">{t('calc.related')}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedLinks.map(link => (
              <a href={translatePath(link.url)} class="p-4 bg-canvas-soft hover:bg-canvas-soft-2 border border-hairline hover:border-hairline-strong rounded-md transition-colors block text-sm font-medium text-ink">
                {link.name} →
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Feedback Widget -->
      <div class="mt-12 border-t border-hairline pt-6 no-print">
        <div id="feedback-widget-container" class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
            <span class="text-xs text-mute font-mono">{t('feedback.helpful', 'Was this calculator helpful?')}</span>
            <div id="feedback-widget" class="flex items-center gap-2">
              <button class="feedback-btn px-3 py-1 bg-canvas hover:bg-canvas-soft-2 text-xs border border-hairline rounded-full cursor-pointer transition-colors" data-val="yes">{t('feedback.yes', '👍 Yes')}</button>
              <button class="feedback-btn px-3 py-1 bg-canvas hover:bg-canvas-soft-2 text-xs border border-hairline rounded-full cursor-pointer transition-colors" data-val="no">{t('feedback.no', '👎 No')}</button>
            </div>
          </div>
          <div id="feedback-text-container" class="hidden space-y-2.5 max-w-xl transition-all duration-300">
            <textarea
              id="feedback-comment"
              placeholder={t('feedback.placeholder', 'Any comments or suggestions? (Optional)')}
              rows="3"
              class="w-full p-3 bg-canvas border border-hairline text-ink text-xs rounded-lg focus:outline-none focus:border-hairline-strong transition-colors resize-none"
            ></textarea>
            <div class="flex justify-end gap-2">
              <button type="button" id="feedback-skip-btn" class="px-3.5 py-1 bg-canvas hover:bg-canvas-soft text-mute text-xs border border-hairline rounded-full cursor-pointer transition-colors font-medium">{t('feedback.skip', 'Skip')}</button>
              <button type="button" id="feedback-submit-btn" class="px-4 py-1.5 bg-primary text-on-primary text-xs rounded-full cursor-pointer hover:opacity-90 transition-opacity font-semibold">{t('feedback.submit', 'Submit Comments')}</button>
            </div>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { safeGetItem, safeSetItem } from '../lib/storage';

  // Feedback Widget Handlers
  const buttons = document.querySelectorAll('.feedback-btn');
  const textContainer = document.getElementById('feedback-text-container');
  const commentTextarea = document.getElementById('feedback-comment') as HTMLTextAreaElement | null;
  const skipBtn = document.getElementById('feedback-skip-btn');
  const submitBtn = document.getElementById('feedback-submit-btn');
  const widgetContainer = document.getElementById('feedback-widget-container');

  let selectedRating: string | null = null;

  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      buttons.forEach(b => b.classList.remove('bg-canvas-soft-2', 'border-hairline-strong'));
      const target = e.currentTarget as HTMLButtonElement;
      target.classList.add('bg-canvas-soft-2', 'border-hairline-strong');

      selectedRating = target.dataset.val || 'yes';

      if (textContainer) {
        textContainer.classList.remove('hidden');
      }
    });
  });

  function saveFeedback(comment = '') {
    if (!selectedRating) return;
    const pageUrl = window.location.pathname;
    const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];

    const payload = {
      url: pageUrl,
      name: pageName,
      rating: selectedRating,
      message: comment.trim()
    };

    // 1. Submit to server API endpoint
    fetch('/api/feedback', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify(payload)
    }).catch(err => {
      console.error('Error submitting feedback to server:', err);
    });

    // 2. Fallback / save to local storage for backward compatibility & local display
    let feedbackList = [];
    try {
      feedbackList = JSON.parse(safeGetItem('feedback_responses', '[]'));
    } catch (err) {}

    feedbackList.push({
      ...payload,
      timestamp: Date.now()
    });

    safeSetItem('feedback_responses', JSON.stringify(feedbackList));

    if (widgetContainer) {
      widgetContainer.innerHTML = `<span class="text-xs text-success font-medium animate-fade-in">Thank you for your feedback!</span>`;
    }
  }

  skipBtn?.addEventListener('click', () => {
    saveFeedback();
  });

  submitBtn?.addEventListener('click', () => {
    const comment = commentTextarea?.value || '';
    saveFeedback(comment);
  });

  // 1. Record Visited page inside recent_calculators
  if (typeof window !== 'undefined') {
    const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];
    const pageUrl = window.location.pathname;

    const ignoredPaths = ['/', '/about', '/contact', '/privacy', '/terms', '/disclaimer'];
    if (!ignoredPaths.includes(pageUrl) && !pageUrl.includes('/blog') && !pageUrl.includes('/compare')) {
      let recents = JSON.parse(safeGetItem('recent_calculators', '[]'));
      recents = recents.filter((item: any) => item.url !== pageUrl);
      recents.unshift({ name: pageName, url: pageUrl });
      if (recents.length > 5) recents.pop();
      safeSetItem('recent_calculators', JSON.stringify(recents));
    }
  }

  // 2. Scenario Saving & Loading Logic
  const saveBtn = document.getElementById('save-scenario-btn');
  const scenariosList = document.getElementById('scenarios-list');
  const form = document.querySelector('form');
  const scenarioKey = `scenarios:${window.location.pathname}`;

    let selectedIndices: number[] = [];

    function updateScenariosUI() {
      if (!scenariosList) return;
      const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
      if (saved.length === 0) {
        scenariosList.innerHTML = `<span class="text-mute text-[11px] block">No saved scenarios yet.</span>`;
        selectedIndices = [];
        updateCompareButton();
        return;
      }
      
      scenariosList.innerHTML = saved.map((scenario: any, idx: number) => `
        <div class="group flex items-center justify-between gap-2 p-1.5 hover:bg-canvas-soft-2 rounded transition-colors border border-transparent hover:border-hairline">
          <input type="checkbox" class="compare-checkbox w-3.5 h-3.5 rounded border-hairline cursor-pointer text-primary focus:ring-transparent bg-canvas" data-index="${idx}" title="Select for comparison" ${selectedIndices.includes(idx) ? 'checked' : ''} />
          <button class="load-scenario-btn text-left text-ink font-medium truncate flex-1 block" data-index="${idx}" title="Click to load scenario">
            ${scenario.name}
          </button>
          <button class="delete-scenario-btn opacity-0 group-hover:opacity-100 text-mute hover:text-error transition-opacity font-bold px-1" data-index="${idx}" title="Delete scenario">
            &times;
          </button>
        </div>
      `).join('');

      // Bind load listeners
      scenariosList.querySelectorAll('.load-scenario-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
          loadScenario(idx);
        });
      });

      // Bind delete listeners
      scenariosList.querySelectorAll('.delete-scenario-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
          deleteScenario(idx);
        });
      });

      // Bind compare checkbox handlers
      const checkboxes = scenariosList.querySelectorAll('.compare-checkbox');
      checkboxes.forEach(cb => {
        cb.addEventListener('change', (e) => {
          const target = e.currentTarget as HTMLInputElement;
          const idx = parseInt(target.dataset.index || '0');
          if (target.checked) {
            selectedIndices.push(idx);
            if (selectedIndices.length > 2) {
              // Uncheck the oldest one
              const oldestIdx = selectedIndices.shift()!;
              const oldestCb = scenariosList.querySelector(`.compare-checkbox[data-index="${oldestIdx}"]`) as HTMLInputElement | null;
              if (oldestCb) oldestCb.checked = false;
            }
          } else {
            selectedIndices = selectedIndices.filter(i => i !== idx);
          }
          updateCompareButton();
        });
      });

      updateCompareButton();
    }

    function updateCompareButton() {
      const compareBtn = document.getElementById('compare-scenarios-btn');
      if (compareBtn) {
        if (selectedIndices.length === 2) {
          compareBtn.classList.remove('hidden');
          compareBtn.innerHTML = `<span>📊</span> Compare (2/2)`;
        } else {
          compareBtn.classList.add('hidden');
        }
      }
    }

    // Capture comparison logic click
    const compareBtn = document.getElementById('compare-scenarios-btn');
    compareBtn?.addEventListener('click', () => {
      if (selectedIndices.length !== 2) return;
      
      const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
      const scA = saved[selectedIndices[0]];
      const scB = saved[selectedIndices[1]];
      
      if (!scA || !scB || !form) return;

      const titleA = document.getElementById('compare-scen-a-title');
      const titleB = document.getElementById('compare-scen-b-title');
      if (titleA) titleA.textContent = scA.name;
      if (titleB) titleB.textContent = scB.name;

      // 1. Capture current form inputs
      const currentInputs: Record<string, string | boolean> = {};
      Array.from(form.elements).forEach((el: any) => {
        if (el.name) {
          currentInputs[el.name] = el.type === 'checkbox' ? el.checked : el.value;
        }
      });

      const applyInputsAndRun = (data: Record<string, any>) => {
        Object.entries(data).forEach(([name, val]) => {
          const el = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
          if (el) {
            if (el.type === 'checkbox') {
              (el as HTMLInputElement).checked = val === true;
            } else {
              el.value = String(val);
            }
            el.dispatchEvent(new Event('input', { bubbles: true }));
            el.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      };

      const extractInputs = () => {
        const result: Record<string, { label: string, value: string, numeric: number }> = {};
        Array.from(form.elements).forEach((el: any) => {
          if (el.name && el.type !== 'submit' && el.type !== 'reset' && el.type !== 'button') {
            let labelText = el.name;
            const labelEl = document.querySelector(`label[for="${el.id}"]`);
            if (labelEl) {
              labelText = labelEl.textContent || el.name;
            } else {
              const parentLabel = el.closest('div')?.querySelector('label');
              if (parentLabel) labelText = parentLabel.textContent || el.name;
            }
            labelText = labelText.replace(/:$/, '').trim();

            let displayVal = el.value;
            if (el.type === 'checkbox') {
              displayVal = el.checked ? 'Yes' : 'No';
            } else if (el.tagName === 'SELECT') {
              displayVal = el.options[el.selectedIndex]?.text || el.value;
            }

            const rawVal = el.type === 'checkbox' ? (el.checked ? 1 : 0) : parseFloat(el.value.replace(/,/g, ''));
            result[el.name] = {
              label: labelText,
              value: displayVal,
              numeric: isNaN(rawVal) ? 0 : rawVal
            };
          }
        });
        return result;
      };

      const extractOutputs = () => {
        const result: Record<string, { label: string, value: string, numeric: number }> = {};
        document.querySelectorAll('.result-card, [id^="res-"]').forEach((card, idx) => {
          const titleEl = card.querySelector('h4, .text-xs, .text-[10px]');
          const valEl = card.querySelector('.font-mono, p.text-3xl, .text-3xl');
          if (titleEl && valEl) {
            const labelText = titleEl.textContent?.trim() || `Output ${idx + 1}`;
            const displayVal = valEl.textContent?.trim() || '';
            const rawVal = parseFloat(displayVal.replace(/[^0-9.-]/g, ''));
            result[labelText] = {
              label: labelText,
              value: displayVal,
              numeric: isNaN(rawVal) ? 0 : rawVal
            };
          }
        });
        return result;
      };

      // Run Scenario A
      applyInputsAndRun(scA.data);
      const inputsA = extractInputs();
      const outputsA = extractOutputs();

      // Run Scenario B
      applyInputsAndRun(scB.data);
      const inputsB = extractInputs();
      const outputsB = extractOutputs();

      // Restore original inputs
      applyInputsAndRun(currentInputs);

      // Build Comparison Table Rows
      const compareTbody = document.getElementById('compare-modal-tbody');
      if (compareTbody) {
        let rowsHtml = '';

        // Add Inputs Header
        rowsHtml += `<tr class="bg-canvas-soft font-mono uppercase text-mute font-semibold"><td colspan="4" class="px-4 py-2 text-[10px]">Form Inputs</td></tr>`;

        Object.keys(inputsA).forEach(name => {
          const itemA = inputsA[name];
          const itemB = inputsB[name] || { value: '-', numeric: 0 };
          const diff = itemB.numeric - itemA.numeric;
          let diffHtml = '-';
          if (typeof itemA.numeric === 'number' && !isNaN(itemA.numeric) && itemA.value !== 'Yes' && itemA.value !== 'No') {
            const isPct = name.includes('rate') || name.includes('pct') || name.includes('percent');
            const isCurr = !isPct && (name.includes('price') || name.includes('down') || name.includes('payment') || name.includes('amount') || name.includes('cost') || name.includes('contrib') || name.includes('ins') || name.includes('hoa') || name.includes('balance') || name.includes('budget') || name.includes('fee'));
            
            const diffSymbol = diff >= 0 ? '+' : '';
            if (isCurr) {
              const symbolMap: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', INR: '₹' };
              const symbol = symbolMap[safeGetItem('currency', 'USD')] || '$';
              diffHtml = `${diffSymbol}${symbol}${diff.toLocaleString(undefined, { maximumFractionDigits: 0 })}`;
            } else if (isPct) {
              diffHtml = `${diffSymbol}${diff.toFixed(2)}%`;
            } else {
              diffHtml = `${diffSymbol}${diff.toFixed(1)}`;
            }
          }

          rowsHtml += `
            <tr class="hover:bg-canvas-soft transition-colors">
              <td class="px-4 py-2.5 font-semibold text-ink">${itemA.label}</td>
              <td class="px-4 py-2.5 font-mono">${itemA.value}</td>
              <td class="px-4 py-2.5 font-mono">${itemB.value}</td>
              <td class="px-4 py-2.5 font-mono ${diff > 0 ? 'text-link' : diff < 0 ? 'text-error' : 'text-mute'}">${diffHtml}</td>
            </tr>
          `;
        });

        // Add Outputs Header
        rowsHtml += `<tr class="bg-canvas-soft font-mono uppercase text-mute font-semibold"><td colspan="4" class="px-4 py-2 text-[10px]">Calculated Results</td></tr>`;

        Object.keys(outputsA).forEach(label => {
          const itemA = outputsA[label];
          const itemB = outputsB[label] || { value: '-', numeric: 0 };
          const diff = itemB.numeric - itemA.numeric;
          let diffHtml = '-';

          if (!isNaN(diff)) {
            const diffSymbol = diff >= 0 ? '+' : '';
            const isPct = itemA.value.includes('%');
            const isCurr = itemA.value.includes('$') || itemA.value.includes('€') || itemA.value.includes('£') || itemA.value.includes('₹') || label.toLowerCase().includes('interest') || label.toLowerCase().includes('balance') || label.toLowerCase().includes('amount') || label.toLowerCase().includes('cost') || label.toLowerCase().includes('gain') || label.toLowerCase().includes('payment') || label.toLowerCase().includes('proceeds') || label.toLowerCase().includes('shortfall') || label.toLowerCase().includes('net');

            if (isCurr) {
              const symbolMap: Record<string, string> = { USD: '$', EUR: '€', GBP: '£', INR: '₹' };
              const symbol = symbolMap[safeGetItem('currency', 'USD')] || '$';
              diffHtml = `${diffSymbol}${symbol}${diff.toLocaleString(undefined, { maximumFractionDigits: 0 })}`;
            } else if (isPct) {
              diffHtml = `${diffSymbol}${diff.toFixed(2)}%`;
            } else {
              diffHtml = `${diffSymbol}${diff.toFixed(1)}`;
            }
          }

          rowsHtml += `
            <tr class="hover:bg-canvas-soft transition-colors font-medium">
              <td class="px-4 py-2.5 text-ink">${itemA.label}</td>
              <td class="px-4 py-2.5 font-mono text-ink">${itemA.value}</td>
              <td class="px-4 py-2.5 font-mono text-ink">${itemB.value}</td>
              <td class="px-4 py-2.5 font-mono ${diff > 0 ? 'text-link font-semibold' : diff < 0 ? 'text-error font-semibold' : 'text-mute'}">${diffHtml}</td>
            </tr>
          `;
        });

        compareTbody.innerHTML = rowsHtml;
      }

      // Show modal
      const modal = document.getElementById('compare-modal');
      if (modal) modal.classList.remove('hidden');
    });

    // Close Modal Listeners
    const compModal = document.getElementById('compare-modal');
    const closeIds = ['close-compare-modal', 'close-compare-modal-btn'];
    closeIds.forEach(id => {
      document.getElementById(id)?.addEventListener('click', () => {
        compModal?.classList.add('hidden');
      });
    });

    compModal?.addEventListener('click', (e) => {
      if (e.target === compModal) {
        compModal.classList.add('hidden');
      }
    });

    // Copy Share URL Click Handler
    const shareBtn = document.getElementById('share-calculator-btn');
    shareBtn?.addEventListener('click', () => {
      const url = window.location.href;
      navigator.clipboard.writeText(url).then(() => {
        const originalText = shareBtn.innerHTML;
        shareBtn.innerHTML = '<span>✅</span> Link Copied!';
        setTimeout(() => {
          shareBtn.innerHTML = originalText;
        }, 2000);
      }).catch(err => {
        alert("Failed to copy link: " + err);
      });
    });

    // Global URL Sync (for pages that don't have it manually configured)
    if (typeof window !== 'undefined' && form) {
      if (form.getAttribute('data-synced') !== 'true') {
        const params = new URLSearchParams(window.location.search);
        
        // 1. Sync from URL on load
        Array.from(form.elements).forEach((el: any) => {
          const input = el as HTMLInputElement | HTMLSelectElement;
          const nameOrId = input.name || input.id;
          if (!nameOrId || nameOrId === 'currency-select') return;
          
          const value = params.get(nameOrId);
          if (value !== null) {
            if (input.type === 'checkbox') {
              (input as HTMLInputElement).checked = value === 'true';
            } else {
              input.value = value;
            }
          }
        });

        // Trigger updates once page completes loading
        window.addEventListener('load', () => {
          setTimeout(() => {
            Array.from(form.elements).forEach((el: any) => {
              el.dispatchEvent(new Event('input', { bubbles: true }));
              el.dispatchEvent(new Event('change', { bubbles: true }));
            });
          }, 100);
        });

        // 2. Sync to URL on input/change
        const handleGlobalInputSync = () => {
          const newParams = new URLSearchParams();
          Array.from(form.elements).forEach((el: any) => {
            const input = el as HTMLInputElement | HTMLSelectElement;
            const nameOrId = input.name || input.id;
            if (!nameOrId || nameOrId === 'currency-select') return;

            if (input.type === 'checkbox') {
              if ((input as HTMLInputElement).checked) {
                newParams.set(nameOrId, 'true');
              }
            } else if (input.value && input.value !== (input instanceof HTMLInputElement ? input.defaultValue : '')) {
              newParams.set(nameOrId, input.value);
            }
          });
          const newQueryString = newParams.toString();
          const newUrl = `${window.location.pathname}${newQueryString ? '?' + newQueryString : ''}`;
          window.history.replaceState(null, '', newUrl);
        };

        form.addEventListener('input', handleGlobalInputSync);
        form.addEventListener('change', handleGlobalInputSync);
        form.setAttribute('data-synced', 'true');
      }
    }

  function loadScenario(idx: number) {
    if (!form) return;
    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    const scenario = saved[idx];
    if (!scenario || !scenario.data) return;

    Object.entries(scenario.data).forEach(([name, val]: [string, any]) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (input) {
        if (input.type === 'checkbox') {
          (input as HTMLInputElement).checked = val === true;
        } else {
          input.value = String(val);
        }
        // Dispatch events so calculation scripts pick it up
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }

  function deleteScenario(idx: number) {
    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    saved.splice(idx, 1);
    safeSetItem(scenarioKey, JSON.stringify(saved));
    updateScenariosUI();
  }

  saveBtn?.addEventListener('click', () => {
    if (!form) {
      alert("No input form found on this page.");
      return;
    }
    const name = prompt("Enter a name for this scenario:");
    if (!name || !name.trim()) return;

    const data: Record<string, any> = {};
    Array.from(form.elements).forEach((el: any) => {
      const input = el as HTMLInputElement | HTMLSelectElement;
      if (input.name) {
        data[input.name] = input.type === 'checkbox' ? (input as HTMLInputElement).checked : input.value;
      }
    });

    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    saved.push({ name: name.trim(), data, timestamp: Date.now() });
    safeSetItem(scenarioKey, JSON.stringify(saved));
    updateScenariosUI();
  });

  // Run initial UI update for scenarios
  updateScenariosUI();

  // Close mobile navigation collapsible details menu when clicking outside or on a link
  const mobileNavDetails = document.getElementById('mobile-nav-details') as HTMLDetailsElement | null;
  if (mobileNavDetails) {
    document.addEventListener('click', (e) => {
      if (!mobileNavDetails.contains(e.target as Node)) {
        mobileNavDetails.removeAttribute('open');
      }
    });

    mobileNavDetails.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileNavDetails.removeAttribute('open');
      });
    });
  }
</script>
