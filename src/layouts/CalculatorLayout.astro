---
import Layout from './Layout.astro';

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description?: string;
  faqs?: FAQItem[];
  lastUpdated?: string;
}

const { title, description, faqs = [], lastUpdated = 'July 2026' } = Astro.props;

const currentPath = Astro.url.pathname;

// Expanded calculator routes
const categories = [
  {
    name: 'Finance & Investment',
    links: [
      { name: 'TVM Calculator', url: '/finance/tvm' },
      { name: 'Compound Interest', url: '/finance/compound-interest' },
      { name: 'ROI Calculator', url: '/finance/roi' },
      { name: 'Savings Goal', url: '/finance/savings-goal' },
      { name: 'Stock Return', url: '/finance/stock-return' },
      { name: 'Dividend Calculator', url: '/finance/dividend' },
      { name: 'Inflation Calculator', url: '/finance/inflation' },
      { name: 'Paycheck Calculator', url: '/finance/paycheck' },
      { name: 'Net Worth Tracker', url: '/finance/net-worth' },
      { name: 'Emergency Fund', url: '/finance/emergency-fund' },
      { name: 'Investment Fee Impact', url: '/finance/fee-impact' },
      { name: 'College Savings (529)', url: '/finance/college-savings' },
      { name: 'Crypto DCA', url: '/finance/crypto-dca' },
    ]
  },
  {
    name: 'Loan & Mortgage',
    links: [
      { name: 'Loan Calculator', url: '/loan/calculator' },
      { name: 'Mortgage Calculator', url: '/loan/mortgage' },
      { name: 'Debt Snowball vs Avalanche', url: '/loan/debt-payoff' },
      { name: 'Loan Refinance', url: '/loan/refinance' },
      { name: 'Student Loan IDR', url: '/loan/student-loan' },
      { name: 'Debt-to-Income (DTI)', url: '/loan/dti' },
      { name: 'APR Calculator', url: '/loan/apr' },
      { name: 'Rent vs Buy', url: '/loan/rent-vs-buy' },
      { name: 'Home Affordability', url: '/loan/home-affordability' },
    ]
  },
  {
    name: 'Retirement',
    links: [
      { name: 'Retirement Planner', url: '/retirement/planner' },
      { name: '401k Calculator', url: '/retirement/401k' },
      { name: 'Roth vs Trad IRA', url: '/retirement/ira-comparison' },
    ]
  },
  {
    name: 'Credit Card & Auto',
    links: [
      { name: 'Credit Card Payoff', url: '/credit-card/payoff' },
      { name: 'Auto Loan', url: '/auto/loan' },
    ]
  },
  {
    name: 'Miscellaneous',
    links: [
      { name: 'Tip Calculator', url: '/misc/tip' },
      { name: 'Discount & Tax', url: '/misc/discount' },
    ]
  }
];

// Determine related calculators in the same category
const currentCategory = categories.find(cat => cat.links.some(link => link.url === currentPath));
const relatedLinks = currentCategory 
  ? currentCategory.links.filter(l => l.url !== currentPath).slice(0, 3)
  : [];

// Schema creation
const webAppSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": title,
  "description": description,
  "applicationCategory": "FinancialApplication",
  "operatingSystem": "All"
};

const faqSchema = faqs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;
---
<Layout title={title} description={description}>
  <!-- Inject Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(webAppSchema)} />
  {faqSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />}
  <div class="max-w-[1400px] mx-auto py-4 lg:py-8 flex flex-col lg:flex-row gap-8">
    <!-- Sidebar / Mobile Navigation -->
    <aside class="w-full lg:w-64 flex-shrink-0">
      <!-- Mobile Collapsible Menu -->
      <details class="lg:hidden mb-4 border border-hairline rounded bg-canvas shadow-sm">
        <summary class="flex items-center justify-between px-4 py-3 text-sm font-medium text-ink cursor-pointer select-none">
          <span class="flex items-center gap-2">
            <svg class="w-4 h-4 text-mute" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>
            Navigate Calculators
          </span>
          <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
        </summary>
        <div class="p-4 border-t border-hairline bg-canvas-soft space-y-6 max-h-[300px] overflow-y-auto">
          {categories.map(cat => (
            <div>
              <h3 class="text-[10px] font-mono text-mute uppercase tracking-wider mb-2 px-3">{cat.name}</h3>
              <ul class="space-y-1">
                {cat.links.map(link => {
                  const isActive = currentPath === link.url || currentPath === `${link.url}/`;
                  return (
                    <li>
                      <a 
                        href={link.url} 
                        class:list={[
                          "block px-3 py-1.5 text-sm rounded transition-colors",
                          isActive ? "bg-canvas-soft-2 text-ink font-semibold border-l-2 border-primary rounded-l-none" : "text-body hover:text-ink hover:bg-canvas-soft"
                        ]}
                      >
                        {link.name}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </div>
      </details>

      <!-- Desktop Sticky Navigation -->
      <nav class="hidden lg:block sticky top-24 space-y-8">
        {categories.map(cat => (
          <div>
            <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-3 px-3">{cat.name}</h3>
            <ul class="space-y-1">
              {cat.links.map(link => {
                const isActive = currentPath === link.url || currentPath === `${link.url}/`;
                return (
                  <li>
                    <a 
                      href={link.url} 
                      class:list={[
                        "block px-3 py-1.5 text-sm rounded transition-colors",
                        isActive ? "bg-canvas-soft-2 text-ink font-semibold border-l-2 border-primary rounded-l-none" : "text-body hover:text-ink hover:bg-canvas-soft"
                      ]}
                    >
                      {link.name}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))}
      </nav>

      <!-- Saved Scenarios section in sidebar -->
      <div id="saved-scenarios-sidebar" class="bg-canvas-soft border border-hairline rounded-lg p-4 space-y-3 no-print mt-6 hidden lg:block">
        <h3 class="text-[10px] font-mono text-mute uppercase tracking-wider">My Saved Scenarios</h3>
        <div id="scenarios-list" class="space-y-1.5 text-xs text-mute">
          No saved scenarios yet.
        </div>
        <button id="save-scenario-btn" class="w-full py-1.5 bg-canvas hover:bg-canvas-soft-2 border border-hairline text-ink text-xs rounded transition-colors cursor-pointer font-medium mt-2 flex items-center justify-center gap-1.5">
          <span>💾</span> Save Inputs
        </button>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="flex-1 bg-canvas border border-hairline rounded-lg p-6 lg:p-10 shadow-sm min-h-[600px] relative">
      <!-- Last Updated Badge -->
      <div class="absolute top-4 right-6 text-[10px] font-mono text-mute bg-canvas-soft px-2 py-0.5 rounded border border-hairline no-print">
        Updated: {lastUpdated}
      </div>

      <div class="mb-10">
        <h1 class="text-3xl font-semibold tracking-[-1.28px] text-ink mb-3">{title}</h1>
        {description && <p class="text-body text-base max-w-3xl">{description}</p>}
      </div>
      <slot />

      <!-- FAQ Section -->
      {faqs && faqs.length > 0 && (
        <div class="border-t border-hairline mt-12 pt-12 space-y-6 no-print">
          <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
          <div class="divide-y divide-hairline">
            {faqs.map(faq => (
              <details class="group py-4">
                <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
                  <span>{faq.question}</span>
                  <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
                  <p>{faq.answer}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}

      <!-- Browser Privacy Note -->
      <div class="mt-12 p-4 bg-canvas-soft border border-hairline border-dashed rounded-md text-xs text-mute flex items-center gap-2 no-print">
        <span>🔒</span>
        <span><strong>100% Private:</strong> All calculations execute locally in your web browser. We do not store or transmit your financial details.</span>
      </div>

      <!-- Related Calculators Section -->
      {relatedLinks.length > 0 && (
        <div class="mt-12 border-t border-hairline pt-8 no-print">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Related Calculators</h3>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedLinks.map(link => (
              <a href={link.url} class="p-4 bg-canvas-soft hover:bg-canvas-soft-2 border border-hairline hover:border-hairline-strong rounded-md transition-colors block text-sm font-medium text-ink">
                {link.name} →
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Feedback Widget -->
      <div class="mt-12 border-t border-hairline pt-6 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 no-print">
        <span class="text-xs text-mute font-mono">Was this calculator helpful?</span>
        <div id="feedback-widget" class="flex items-center gap-2">
          <button class="feedback-btn px-3 py-1 bg-canvas hover:bg-canvas-soft-2 text-xs border border-hairline rounded-full cursor-pointer transition-colors" data-val="yes">👍 Yes</button>
          <button class="feedback-btn px-3 py-1 bg-canvas hover:bg-canvas-soft-2 text-xs border border-hairline rounded-full cursor-pointer transition-colors" data-val="no">👎 No</button>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { safeGetItem, safeSetItem } from '../lib/storage';

  // Feedback Widget Handlers
  const buttons = document.querySelectorAll('.feedback-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      const rating = (e.currentTarget as HTMLButtonElement).dataset.val || 'yes';
      const pageUrl = window.location.pathname;
      const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];

      let feedbackList = [];
      try {
        feedbackList = JSON.parse(safeGetItem('feedback_responses', '[]'));
      } catch (err) {}

      feedbackList.push({
        url: pageUrl,
        name: pageName,
        rating: rating,
        timestamp: Date.now()
      });

      safeSetItem('feedback_responses', JSON.stringify(feedbackList));

      const widget = document.getElementById('feedback-widget');
      if (widget) {
        widget.innerHTML = `<span class="text-xs text-success font-medium animate-fade-in">Thank you for your feedback!</span>`;
      }
    });
  });

  // 1. Record Visited page inside recent_calculators
  if (typeof window !== 'undefined') {
    const pageName = document.querySelector('h1')?.textContent || document.title.split(' - ')[0];
    const pageUrl = window.location.pathname;

    const ignoredPaths = ['/', '/about', '/contact', '/privacy', '/terms', '/disclaimer'];
    if (!ignoredPaths.includes(pageUrl) && !pageUrl.includes('/blog') && !pageUrl.includes('/compare')) {
      let recents = JSON.parse(safeGetItem('recent_calculators', '[]'));
      recents = recents.filter((item: any) => item.url !== pageUrl);
      recents.unshift({ name: pageName, url: pageUrl });
      if (recents.length > 5) recents.pop();
      safeSetItem('recent_calculators', JSON.stringify(recents));
    }
  }

  // 2. Scenario Saving & Loading Logic
  const saveBtn = document.getElementById('save-scenario-btn');
  const scenariosList = document.getElementById('scenarios-list');
  const form = document.querySelector('form');
  const scenarioKey = `scenarios:${window.location.pathname}`;

  function updateScenariosUI() {
    if (!scenariosList) return;
    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    if (saved.length === 0) {
      scenariosList.innerHTML = `<span class="text-mute text-[11px] block">No saved scenarios yet.</span>`;
      return;
    }
    
    scenariosList.innerHTML = saved.map((scenario: any, idx: number) => `
      <div class="group flex items-center justify-between gap-1 p-1.5 hover:bg-canvas-soft-2 rounded transition-colors border border-transparent hover:border-hairline">
        <button class="load-scenario-btn text-left text-ink font-medium truncate flex-1 block" data-index="${idx}" title="Click to load scenario">
          ${scenario.name}
        </button>
        <button class="delete-scenario-btn opacity-0 group-hover:opacity-100 text-mute hover:text-error transition-opacity font-bold px-1" data-index="${idx}" title="Delete scenario">
          &times;
        </button>
      </div>
    `).join('');

    // Bind load listeners
    scenariosList.querySelectorAll('.load-scenario-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
        loadScenario(idx);
      });
    });

    // Bind delete listeners
    scenariosList.querySelectorAll('.delete-scenario-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLButtonElement).dataset.index || '0');
        deleteScenario(idx);
      });
    });
  }

  function loadScenario(idx: number) {
    if (!form) return;
    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    const scenario = saved[idx];
    if (!scenario || !scenario.data) return;

    Object.entries(scenario.data).forEach(([name, val]: [string, any]) => {
      const input = form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | null;
      if (input) {
        if (input.type === 'checkbox') {
          (input as HTMLInputElement).checked = val === true;
        } else {
          input.value = String(val);
        }
        // Dispatch events so calculation scripts pick it up
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  }

  function deleteScenario(idx: number) {
    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    saved.splice(idx, 1);
    safeSetItem(scenarioKey, JSON.stringify(saved));
    updateScenariosUI();
  }

  saveBtn?.addEventListener('click', () => {
    if (!form) {
      alert("No input form found on this page.");
      return;
    }
    const name = prompt("Enter a name for this scenario:");
    if (!name || !name.trim()) return;

    const data: Record<string, any> = {};
    Array.from(form.elements).forEach((el: any) => {
      const input = el as HTMLInputElement | HTMLSelectElement;
      if (input.name) {
        data[input.name] = input.type === 'checkbox' ? (input as HTMLInputElement).checked : input.value;
      }
    });

    const saved = JSON.parse(safeGetItem(scenarioKey, '[]'));
    saved.push({ name: name.trim(), data, timestamp: Date.now() });
    safeSetItem(scenarioKey, JSON.stringify(saved));
    updateScenariosUI();
  });

  // Run initial UI update for scenarios
  updateScenariosUI();
</script>
