---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath, getHreflangList, isRtl } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  lang?: Lang;
}

const detectedLang = getLangFromUrl(Astro.url, Astro.currentLocale);
const lang = Astro.props.lang || detectedLang;
const rtl = isRtl(lang);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const { 
  title, 
  description = t("site.description"),
  canonicalUrl
} = Astro.props;

const localizedPageTitle = t(title, title);
const localizedPageDescription = description ? t(description, description) : t("site.description");

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://fincompute.vercel.app').replace(/\/+$/, '');
const localizedPath = translatePath(Astro.url.pathname, lang);
const formattedPath = localizedPath === '/' ? '/' : (localizedPath.endsWith('/') ? localizedPath : `${localizedPath}/`);
const resolvedCanonical = canonicalUrl || `${siteOrigin}${formattedPath}`;
const hreflangList = getHreflangList(Astro.url, siteOrigin);
---

<!doctype html>
<html lang={lang} dir={rtl ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={localizedPageDescription} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={resolvedCanonical} />
    <link rel="manifest" href="/manifest.json" />
    <meta name="generator" content={Astro.generator} />
    <title>{localizedPageTitle}</title>

    <!-- Hreflang markup for each supported language -->
    {hreflangList.map(({ code, href }) => (
      <link rel="alternate" hreflang={code} href={href} />
    ))}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:title" content={localizedPageTitle} />
    <meta property="og:description" content={localizedPageDescription} />
    <meta property="og:locale" content={lang} />
    <meta property="og:image" content="/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={resolvedCanonical} />
    <meta name="twitter:title" content={localizedPageTitle} />
    <meta name="twitter:description" content={localizedPageDescription} />
    <meta name="twitter:image" content="/og-image.png" />
    
    <!-- Preconnect to jsDelivr for faster font delivery -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    
    <!-- Add Geist Font from Vercel -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.0.0/dist/fonts/geist-sans/style.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/geist@1.0.0/dist/fonts/geist-mono/style.css" />
    
    <!-- Dark Mode Blocker Script -->
    <script is:inline>
      const theme = (() => {
        try {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
        } catch (e) {}
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
    
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
        document.documentElement.classList.remove('light');
      } else {
        document.documentElement.classList.remove('dark');
        document.documentElement.classList.add('light');
      }
    </script>
    <!-- Register Service Worker for PWA -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js')
            .catch((err) => console.warn('Service Worker registration failed:', err));
        });
      }
    </script>
  </head>
  <body class="bg-canvas-soft text-ink font-sans antialiased selection:bg-primary selection:text-on-primary pb-24">
    <!-- Navbar (Floating Pill) -->
    <header class="sticky top-4 z-50 max-w-[950px] w-[92%] mx-auto bg-canvas/75 backdrop-blur-md border border-hairline rounded-full h-12 flex items-center px-4 sm:px-6 shadow-[0_8px_30px_rgba(0,0,0,0.02)] transition-shadow duration-200 hover:shadow-[0_8px_30px_rgba(0,0,0,0.04)] mt-4">
      <div class="w-full flex items-center justify-between">
        <!-- Logo -->
        <a href={translatePath('/')} class="flex items-center gap-2 hover:opacity-85 transition-opacity">
          <div class="w-6 h-6 rounded-md bg-ink flex items-center justify-center text-canvas">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <span class="font-bold text-xs tracking-tight text-ink font-mono">FinCompute</span>
        </a>

        <!-- Center Capsule Links -->
        <nav class="hidden md:flex items-center gap-0.5 bg-canvas-soft border border-hairline rounded-full p-0.5 shadow-inner">
          <a href={translatePath('/#categories-section')} class="text-body text-[11px] font-mono font-medium hover:text-ink transition-colors px-3.5 py-1 rounded-full hover:bg-canvas">{t('nav.calculators')}</a>
          <a href={translatePath('/blog')} class="text-body text-[11px] font-mono font-medium hover:text-ink transition-colors px-3.5 py-1 rounded-full hover:bg-canvas">{t('nav.blog')}</a>
          <a href={translatePath('/about')} class="text-body text-[11px] font-mono font-medium hover:text-ink transition-colors px-3.5 py-1 rounded-full hover:bg-canvas">{t('nav.about')}</a>
          <a href={translatePath('/contact')} class="text-body text-[11px] font-mono font-medium hover:text-ink transition-colors px-3.5 py-1 rounded-full hover:bg-canvas">{t('nav.contact')}</a>
        </nav>

        <!-- Right side tools -->
        <div class="flex items-center gap-1">
          <!-- Language Selector -->
          <div class="hidden sm:flex items-center mr-1">
            <LanguagePicker id="navbar-language-select" lang={lang} />
          </div>

          <!-- Currency Selector -->
          <div class="relative flex items-center mr-1">
            <select id="currency-select" title="Rates: 1 USD = 0.92 EUR = 0.79 GBP = 83 INR" class="bg-canvas text-ink text-[11px] font-mono font-medium border border-hairline rounded-full px-2.5 py-1 focus:outline-none focus:border-hairline-strong transition-colors cursor-pointer select-none" aria-label="Select currency">
              <option value="USD">USD ($)</option>
              <option value="EUR">EUR (€)</option>
              <option value="GBP">GBP (£)</option>
              <option value="INR">INR (₹)</option>
            </select>
          </div>

          <!-- Theme Toggle -->
          <button id="theme-toggle" class="p-1.5 rounded-full hover:bg-canvas-soft-2 text-body hover:text-ink transition-colors cursor-pointer border border-transparent hover:border-hairline" aria-label="Toggle dark mode">
            <!-- Sun Icon (visible in dark mode) -->
            <svg id="sun-icon" class="w-3.5 h-3.5 hidden dark:block" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364-6.364l-.707.707M6.343 17.657l-.707.707m0-12.728l.707.707m11.314 11.314l.707.707M12 5a7 7 0 100 14 7 7 0 000-14z" />
            </svg>
            <!-- Moon Icon (visible in light mode) -->
            <svg id="moon-icon" class="w-3.5 h-3.5 block dark:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>

          <!-- Mobile Menu Button -->
          <button id="mobile-menu-btn" class="md:hidden p-1.5 rounded-full hover:bg-canvas-soft-2 text-body hover:text-ink transition-colors cursor-pointer border border-transparent hover:border-hairline" aria-label="Open menu">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
              <path d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu overlay (Card style below the navbar) -->
      <div id="mobile-menu" class="hidden md:hidden absolute left-0 right-0 top-14 bg-canvas/95 backdrop-blur-xl border border-hairline rounded-2xl p-4 shadow-xl z-50 animate-fade-in mx-auto w-full">
        <nav class="flex flex-col gap-1">
          <a href={translatePath('/#categories-section')} class="text-body text-xs font-mono font-medium hover:text-ink transition-colors px-4 py-2.5 rounded-xl hover:bg-canvas-soft-2">{t('nav.calculators')}</a>
          <a href={translatePath('/blog')} class="text-body text-xs font-mono font-medium hover:text-ink transition-colors px-4 py-2.5 rounded-xl hover:bg-canvas-soft-2">{t('nav.blog')}</a>
          <a href={translatePath('/about')} class="text-body text-xs font-mono font-medium hover:text-ink transition-colors px-4 py-2.5 rounded-xl hover:bg-canvas-soft-2">{t('nav.about')}</a>
          <a href={translatePath('/contact')} class="text-body text-xs font-mono font-medium hover:text-ink transition-colors px-4 py-2.5 rounded-xl hover:bg-canvas-soft-2">{t('nav.contact')}</a>
          <div class="border-t border-hairline my-2"></div>
          <a href={translatePath('/privacy')} class="text-mute text-[10px] font-mono hover:text-ink transition-colors px-4 py-2 rounded-xl hover:bg-canvas-soft-2">{t('nav.privacy')}</a>
          <a href={translatePath('/terms')} class="text-mute text-[10px] font-mono hover:text-ink transition-colors px-4 py-2 rounded-xl hover:bg-canvas-soft-2">{t('nav.terms')}</a>
          <a href={translatePath('/disclaimer')} class="text-mute text-[10px] font-mono hover:text-ink transition-colors px-4 py-2 rounded-xl hover:bg-canvas-soft-2">{t('nav.disclaimer')}</a>
          <div class="pt-2 px-4 border-t border-hairline/60 mt-1">
            <span class="text-[10px] font-mono text-mute block mb-1.5">{t('lang.select')}:</span>
            <LanguagePicker id="mobile-language-select" lang={lang} />
          </div>
        </nav>
      </div>
    </header>

    <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 pt-8">
      <slot />
    </main>

    <footer class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 mt-32 border-t border-hairline pt-16 pb-12">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8 mb-16">
        <!-- Col 1: Brand & Description -->
        <div class="lg:col-span-2 space-y-4">
          <a href={translatePath('/')} class="flex items-center gap-2 hover:opacity-85 transition-opacity w-fit">
            <div class="w-6 h-6 rounded-md bg-ink flex items-center justify-center text-canvas">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
            </div>
            <span class="font-bold text-sm tracking-tight text-ink font-mono">FinCompute</span>
          </a>
          <p class="text-xs text-mute leading-relaxed max-w-sm font-sans">
            {t('footer.brand')}
          </p>
          <p class="text-[10px] text-mute/80 leading-relaxed max-w-sm font-sans border-t border-hairline/60 pt-2.5">
            <strong>{t('nav.disclaimer')}:</strong> {t('footer.disclaimer')}
          </p>
          <div class="pt-2 flex items-center gap-2">
            <span class="text-[10px] font-mono text-mute">{t('lang.select')}:</span>
            <LanguagePicker id="footer-language-select" lang={lang} />
          </div>
        </div>

        <!-- Col 2: Calculators -->
        <div class="space-y-4">
          <h4 class="text-[10px] font-mono text-ink font-semibold uppercase tracking-wider">{t('nav.calculators')}</h4>
          <ul class="space-y-2 text-xs font-sans text-mute">
            <li><a href={translatePath('/finance/compound-interest')} class="hover:text-ink transition-colors">{t('calc.compound.name')}</a></li>
            <li><a href={translatePath('/finance/paycheck')} class="hover:text-ink transition-colors">{t('calc.paycheck.name')}</a></li>
            <li><a href={translatePath('/finance/net-worth')} class="hover:text-ink transition-colors">Net Worth Tracker</a></li>
            <li><a href={translatePath('/loan/mortgage')} class="hover:text-ink transition-colors">{t('calc.mortgage.name')}</a></li>
            <li><a href={translatePath('/finance/college-savings')} class="hover:text-ink transition-colors">College Savings (529)</a></li>
          </ul>
        </div>

        <!-- Col 3: Comparisons -->
        <div class="space-y-4">
          <h4 class="text-[10px] font-mono text-ink font-semibold uppercase tracking-wider">{t('footer.comparisons')}</h4>
          <ul class="space-y-2 text-xs font-sans text-mute">
            <li><a href={translatePath('/compare/snowball-vs-avalanche')} class="hover:text-ink transition-colors">Snowball vs Avalanche</a></li>
            <li><a href={translatePath('/compare/roth-vs-traditional-ira')} class="hover:text-ink transition-colors">Roth vs Traditional IRA</a></li>
            <li><a href={translatePath('/compare/apr-vs-nominal')} class="hover:text-ink transition-colors">APR vs Nominal Interest</a></li>
            <li><a href={translatePath('/loan/rent-vs-buy')} class="hover:text-ink transition-colors">Rent vs Buy Decision</a></li>
          </ul>
        </div>

        <!-- Col 4: Resources & Legal -->
        <div class="space-y-4">
          <h4 class="text-[10px] font-mono text-ink font-semibold uppercase tracking-wider">{t('footer.resources')}</h4>
          <ul class="space-y-2 text-xs font-sans text-mute">
            <li><a href={translatePath('/blog')} class="hover:text-ink transition-colors">{t('nav.blog')}</a></li>
            <li><a href={translatePath('/glossary')} class="hover:text-ink transition-colors">Financial Glossary</a></li>
            <li><a href={translatePath('/about')} class="hover:text-ink transition-colors">{t('nav.about')}</a></li>
            <li><a href={translatePath('/contact')} class="hover:text-ink transition-colors">{t('nav.contact')}</a></li>
            <li><a href={translatePath('/privacy')} class="hover:text-ink transition-colors">{t('nav.privacy')}</a></li>
            <li><a href={translatePath('/terms')} class="hover:text-ink transition-colors">{t('nav.terms')}</a></li>
            <li><a href={translatePath('/disclaimer')} class="hover:text-ink transition-colors">{t('nav.disclaimer')}</a></li>
            <li><a href={translatePath('/sitemap.xml')} class="hover:text-ink transition-colors">{t('nav.sitemap')}</a></li>
          </ul>
        </div>
      </div>

      <!-- Footer Bottom -->
      <div class="border-t border-hairline pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[10px] text-mute font-mono">
        <div>
          &copy; {new Date().getFullYear()} FinCompute. {t('footer.rights')}
        </div>
        <div class="flex items-center gap-2 text-mute/50 font-sans">
          <span>{t('footer.tagline')}</span>
        </div>
      </div>
    </footer>

    <!-- Theme Toggle, Localization & Mobile Menu logic -->
    <script>
      import { safeGetItem, safeSetItem } from '../lib/storage';
      import { initClientLocalization } from '../i18n/client-localize';

      initClientLocalization();
      document.addEventListener('astro:page-load', initClientLocalization);

      const themeToggleBtn = document.getElementById('theme-toggle');
      themeToggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.contains('dark');
        const newTheme = isDark ? 'light' : 'dark';
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          safeSetItem('theme', 'light');
        } else {
          document.documentElement.classList.add('dark');
          document.documentElement.classList.remove('light');
          safeSetItem('theme', 'dark');
        }
        window.dispatchEvent(new CustomEvent('theme-change', { detail: newTheme }));
      });

      // Currency Selection logic
      const currencySelect = document.getElementById('currency-select') as HTMLSelectElement | null;
      if (currencySelect) {
        let previousCurrency = safeGetItem('currency', 'USD');
        currencySelect.value = previousCurrency;
        currencySelect.addEventListener('change', () => {
          const newCurrency = currencySelect.value;
          const rates: Record<string, number> = {
            USD: 1.0,
            EUR: 0.92,
            GBP: 0.79,
            INR: 83.0
          };
          const oldRate = rates[previousCurrency] || 1.0;
          const newRate = rates[newCurrency] || 1.0;
          const ratio = newRate / oldRate;

          // Convert values on all inputs associated with currency
          document.querySelectorAll('[data-currency-prefix]').forEach(span => {
            const input = span.parentElement?.querySelector('input') as HTMLInputElement | null;
            if (input && input.value) {
              const val = parseFloat(input.value.replace(/,/g, ''));
              if (!isNaN(val)) {
                const converted = val * ratio;
                const hasDecimals = input.step === 'any' || input.value.includes('.') || input.getAttribute('data-decimals') === 'true';
                input.value = Number(converted.toFixed(hasDecimals ? 2 : 0)).toString();
                // Dispatch events to let individual calculator script recalculate
                input.dispatchEvent(new Event('input', { bubbles: true }));
                input.dispatchEvent(new Event('change', { bubbles: true }));
              }
            }
          });

          safeSetItem('currency', newCurrency);
          previousCurrency = newCurrency;
          window.dispatchEvent(new CustomEvent('currency-change', { detail: newCurrency }));
        });
      }

      const mobileMenuBtn = document.getElementById('mobile-menu-btn');
      const mobileMenu = document.getElementById('mobile-menu');
      let menuOpen = false;

      mobileMenuBtn?.addEventListener('click', (e) => {
        e.stopPropagation();
        menuOpen = !menuOpen;
        mobileMenu?.classList.toggle('hidden', !menuOpen);
        document.body.style.overflow = menuOpen ? 'hidden' : '';
      });

      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          menuOpen = false;
          mobileMenu?.classList.add('hidden');
          document.body.style.overflow = '';
        });
      });

      // Close mobile menu when clicking outside
      document.addEventListener('click', (e) => {
        if (menuOpen && mobileMenu && !mobileMenu.contains(e.target as Node) && mobileMenuBtn && !mobileMenuBtn.contains(e.target as Node)) {
          menuOpen = false;
          mobileMenu.classList.add('hidden');
          document.body.style.overflow = '';
        }
      });
    </script>
    <Analytics />
  </body>
</html>

