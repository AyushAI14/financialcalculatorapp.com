---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
---

<CalculatorLayout 
  title="Auto Loan Calculator" 
  description="Estimate your monthly car payments, financed amounts, and overall cost of purchasing a vehicle. Factor in sales taxes, dealer fees, and trade-in credits."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="auto-loan-form" class="space-y-6">
        <!-- Vehicle Pricing -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">Vehicle Pricing</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="price" label="Vehicle Purchase Price" type="number" prefix="$" value="35000" />
            <Input id="tax-rate" label="Sales Tax Rate" type="number" suffix="%" value="7.0" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2 border-t border-hairline/60">
            <Input id="fees" label="Title, License & Dealer Fees" type="number" prefix="$" value="1200" />
          </div>
        </div>

        <!-- Down Payment & Trade-In -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">Upfront Offsets</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="downpayment" label="Cash Down Payment" type="number" prefix="$" value="5000" />
            <Input id="trade-in" label="Net Trade-In Value" type="number" prefix="$" value="3000" />
          </div>
        </div>

        <!-- Financing terms -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5 bg-canvas-soft border border-hairline rounded-md">
          <Input id="rate" label="Interest Rate (APR)" type="number" suffix="%" value="5.9" />
          <Select id="term" label="Loan Term" options={[
            { value: '36', label: '36 months (3 years)' },
            { value: '48', label: '48 months (4 years)' },
            { value: '60', label: '60 months (5 years)' },
            { value: '72', label: '72 months (6 years)' },
            { value: '84', label: '84 months (7 years)' }
          ]} value="60" />
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            Calculate Auto Loan
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            Clear
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Charts) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-payment">
          <ResultCard title="Monthly Payment" value="$594.32" highlight={true} />
        </div>
        <div id="res-financed">
          <ResultCard title="Financed Amount" value="$30,650.00" />
        </div>
        <div id="res-interest">
          <ResultCard title="Total Interest" value="$5,009.20" />
        </div>
        <div id="res-cost">
          <ResultCard title="Total Out-of-Pocket" value="$43,659.20" />
        </div>
      </div>

      <div id="auto-takeaway" class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm font-medium text-xs leading-relaxed text-ink hidden">
      </div>

      <!-- Purchase Price Breakdown Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Total Cost of Purchase Breakdown</h4>
        <div class="h-64 relative">
          <canvas id="cost-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational SEO Section -->
  <article class="mt-20 max-w-4xl prose prose-sm text-body leading-relaxed border-t border-hairline pt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink mb-3">Tips for Auto Financing.</h2>
      <p>
        Buying a vehicle is a major expense. Because automobiles are depreciating assets (losing value over time, unlike homes), structuring your auto loan correctly is vital to maintaining financial flexibility:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">The 20/4/10 Rule</h3>
        <p class="text-sm">
          Financial planners recommend the **20/4/10 guideline** for purchasing cars:
        </p>
        <ul class="list-disc pl-5 mt-2 space-y-1.5 text-xs text-mute">
          <li><strong>20% Down Payment</strong>: Pay at least 20% upfront to prevent going "underwater" (owing more on the loan than the car is worth) the moment you drive off the lot.</li>
          <li><strong>4 Years (48 Months) Term</strong>: Avoid stretching loans to 72 or 84 months. Longer terms lower monthly payments but increase total interest fees dramatically.</li>
          <li><strong>10% of Income</strong>: Total monthly transportation costs (loan payment + gas + insurance + maintenance) should not exceed 10% of gross monthly income.</li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">Trade-Ins & Sales Tax</h3>
        <p class="text-sm">
          Trading in a vehicle is not just a convenience—it offers tax advantages. In many states, you only pay sales tax on the **net price** of the car (purchase price minus trade-in credit), which can save you hundreds of dollars in tax fees!
        </p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-hairline pt-12 space-y-6">
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
      <div class="divide-y divide-hairline">
        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>What is an auto loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              An auto loan is a personal, secured loan used specifically to purchase a vehicle. The vehicle serves as collateral for the debt, meaning that if you fail to make your payments, the lender has the legal right to repossess the car.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I get an auto loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              You can get an auto loan by applying directly to banks, credit unions, online lenders, or through the financing department at a car dealership. It is highly recommended to get pre-approved by a credit union or bank *before* visiting the dealer to secure the lowest possible rate.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How often are auto loan payments required?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Auto loan payments are standardly due **once a month** on a set day. Some lenders allow you to set up bi-weekly payments (making a half-payment every two weeks), which can help align with your paychecks and pay down the principal slightly faster.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I refinance an auto loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              To refinance, apply for a new loan with a different lender to pay off your existing auto loan. If approved, the new lender will pay off your old car loan, and you will begin making payments to the new lender under the new, hopefully cheaper, interest rate or term.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>When should I consider refinancing my auto loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Consider refinancing if market interest rates have dropped since you bought the car, your credit score has improved significantly (qualifying you for better rates), or you need to extend the loan term to reduce your monthly payment obligation due to financial hardship.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>Is auto loan interest tax deductible?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              For personal use vehicles, auto loan interest is **not tax deductible**. However, if you use the car for business purposes (e.g. self-employed contract work), you can deduct a proportional percentage of the interest matching the business use percentage of the vehicle.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do auto loan rates affect monthly payments?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Interest rates directly influence your monthly payment and the total cost of ownership. A higher interest rate increases your monthly payment and redirects cash away from paying down the principal toward bank interest fees. Use this calculator to compare rates and see the total cost differences.
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>
</CalculatorLayout>

<script>
  import { calculateAutoLoan } from '../../lib/math/misc';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('auto-loan-form') as HTMLFormElement;
  
  const priceInput = document.getElementById('price') as HTMLInputElement;
  const taxRateInput = document.getElementById('tax-rate') as HTMLInputElement;
  const feesInput = document.getElementById('fees') as HTMLInputElement;
  const downpaymentInput = document.getElementById('downpayment') as HTMLInputElement;
  const tradeinInput = document.getElementById('trade-in') as HTMLInputElement;
  const rateInput = document.getElementById('rate') as HTMLInputElement;
  const termSelect = document.getElementById('term') as HTMLSelectElement;

  const resPaymentCard = document.getElementById('res-payment');
  const resFinancedCard = document.getElementById('res-financed');
  const resInterestCard = document.getElementById('res-interest');
  const resCostCard = document.getElementById('res-cost');

  let chartInstance: Chart | null = null;

  // Run calculation
  function performCalculation() {
    const vehiclePrice = parseFloat(priceInput.value) || 0;
    const salesTaxPct = (parseFloat(taxRateInput.value) || 0) / 100;
    const fees = parseFloat(feesInput.value) || 0;
    const downPayment = parseFloat(downpaymentInput.value) || 0;
    const tradeInValue = parseFloat(tradeinInput.value) || 0;
    const interestRate = (parseFloat(rateInput.value) || 0) / 100;
    const termMonths = parseInt(termSelect.value) || 60;

    const res = calculateAutoLoan({
      vehiclePrice,
      downPayment,
      tradeInValue,
      salesTaxPct,
      fees,
      interestRate,
      termMonths
    });

    const totalOutOfPocket = downPayment + tradeInValue + (res.monthlyPayment * termMonths);

    // Update Result Cards
    if (resPaymentCard) resPaymentCard.querySelector('.font-mono')!.textContent = formatCurrency(res.monthlyPayment);
    if (resFinancedCard) resFinancedCard.querySelector('.font-mono')!.textContent = formatCurrency(res.financedAmount);
    if (resInterestCard) resInterestCard.querySelector('.font-mono')!.textContent = formatCurrency(res.totalInterest);
    if (resCostCard) resCostCard.querySelector('.font-mono')!.textContent = formatCurrency(totalOutOfPocket);

    const takeawayEl = document.getElementById('auto-takeaway');
    if (takeawayEl) {
      takeawayEl.classList.remove('hidden');
      const downPercent = vehiclePrice > 0 ? (downPayment / vehiclePrice) * 100 : 0;
      let notes = [];
      if (downPercent < 20) {
        notes.push(`Your down payment is ${(downPercent).toFixed(1)}% (less than the recommended <strong class="text-link">20%</strong>), increasing the risk of negative equity.`);
      }
      if (termMonths > 48) {
        notes.push(`Your term of ${termMonths} months exceeds the recommended <strong class="text-link">48 months</strong>, which increases your interest fees to <strong class="text-ink">${formatCurrency(res.totalInterest)}</strong>.`);
      }
      if (notes.length === 0) {
        notes.push(`Your auto loan setup perfectly aligns with the conservative 20/4 rule of thumb! You will pay a total of <strong class="text-ink">${formatCurrency(totalOutOfPocket)}</strong> over the life of the loan.`);
      }
      takeawayEl.innerHTML = `
        <span class="text-link">📢 Takeaway:</span> ${notes.join(' ')}
      `;
    }

    // Update Chart
    updateChart(vehiclePrice, res.salesTax + fees, res.totalInterest);
  }

  function updateChart(vehicleNet: number, feesAndTax: number, interest: number) {
    const canvas = document.getElementById('cost-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dataset = [vehicleNet, feesAndTax, interest];

    if (chartInstance) {
      chartInstance.data.datasets[0].data = dataset;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Base Vehicle Cost', 'Taxes & Fees', 'Financing Interest'],
          datasets: [
            {
              data: dataset,
              backgroundColor: ['#171717', '#4d4d4d', '#0070f3'],
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'right',
              labels: {
                boxWidth: 10,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` ${formatCurrency(context.raw as number)}`;
                }
              }
            }
          }
        }
      });
    }
  }

  // Listeners
  const allInputs = [priceInput, taxRateInput, feesInput, downpaymentInput, tradeinInput, rateInput, termSelect];
  allInputs.forEach(el => {
    el.addEventListener('input', performCalculation);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  // Initial calculation
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', performCalculation);
</script>
