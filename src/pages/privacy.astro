---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={t('privacy.title', 'Privacy Policy')} description={t('privacy.intro')} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('privacy.heading', 'Privacy Policy.')}</h1>
    <p class="text-xs text-mute font-mono uppercase tracking-wider">{t('privacy.lastUpdated', 'Last updated: October 2026')}</p>
    
    <p>
      {t('privacy.intro')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec1.heading', '1. Information We Collect & Client-Side Execution')}</h2>
    <p>
      {t('privacy.sec1.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec2.heading', '2. Local Web Storage')}</h2>
    <p>
      {t('privacy.sec2.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec3.heading', '3. Google AdSense & Advertising Cookies')}</h2>
    <p>
      {t('privacy.sec3.text1')}
    </p>
    <p>
      {t('privacy.sec3.text2')}
    </p>
    <div class="p-4 rounded-xl border border-divider bg-layer-2 text-xs space-y-2">
      <div class="font-medium text-ink">Advertising Choices & Opt-Out Resources:</div>
      <ul class="list-disc pl-5 space-y-1 text-mute">
        <li><a href="https://www.google.com/settings/ads" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Google Ads Settings</a></li>
        <li><a href="https://www.aboutads.info/choices/" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">Digital Advertising Alliance (DAA) WebChoices</a></li>
        <li><a href="https://www.youronlinechoices.eu/" target="_blank" rel="noopener noreferrer" class="text-link hover:underline">European Interactive Digital Advertising Alliance (EDAA)</a></li>
      </ul>
    </div>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec4.heading', '4. Privacy-First Analytics & CDN Infrastructure')}</h2>
    <p>
      {t('privacy.sec4.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec5.heading', '5. Changes to This Policy')}</h2>
    <p>
      {t('privacy.sec5.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('privacy.sec6.heading', '6. Contact Us')}</h2>
    <p>
      {t('privacy.sec6.text')} <a href="mailto:privacy@financialcalculatorapp.com" class="text-link hover:underline">privacy@financialcalculatorapp.com</a>.
    </p>
  </article>
</Layout>
