---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { CATEGORIES_DATA } from '../lib/calculators';
import { getCollection } from 'astro:content';
import { getLocalizedBlogPost } from '../i18n/blogs';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

// Fetch blog posts
let blogPosts: any[] = [];
try {
  blogPosts = await getCollection('blog');
  blogPosts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
} catch (e) {
  blogPosts = [];
}

const isEs = lang === 'es';
const isDe = lang === 'de';
const isJa = lang === 'ja';
const isPt = lang === 'pt';

const comparisonPagesEs = [
  {
    title: 'Bola de Nieve vs. Avalancha de Deudas',
    desc: 'Compara el impulso psicológico frente a la optimización matemática de intereses para liquidar deudas más rápido.',
    path: '/compare/snowball-vs-avalanche',
  },
  {
    title: 'Roth vs. IRA Tradicional',
    desc: 'Analiza la deducción fiscal inicial frente al crecimiento libre de impuestos en la jubilación.',
    path: '/compare/roth-vs-traditional-ira',
  },
  {
    title: 'TAE vs. Tipo de Interés Nominal',
    desc: 'Comprende periodos de capitalización, TAE vs TIN y comisiones de formalización en préstamos.',
    path: '/compare/apr-vs-nominal',
  },
  {
    title: 'Alquilar vs. Comprar Vivienda',
    desc: 'Evalúa revalorización, intereses hipotecarios, impuestos y costes de oportunidad frente al alquiler.',
    path: '/loan/rent-vs-buy',
  },
];

const comparisonPagesDe = [
  {
    title: 'Schneeball- vs. Lawinen-Methode',
    desc: 'Vergleichen Sie psychologische Motivation mit mathematischer Zinsoptimierung, um Schulden schneller zu tilgen.',
    path: '/compare/snowball-vs-avalanche',
  },
  {
    title: 'Roth vs. Traditionelle Altersvorsorge',
    desc: 'Analysieren Sie sofortige Steuerabzüge im Vergleich zu steuerfreiem Vermögenszuwachs im Ruhestand.',
    path: '/compare/roth-vs-traditional-ira',
  },
  {
    title: 'Sollzins vs. Effektiver Jahreszins',
    desc: 'Verstehen Sie Zinseszinsperioden, Effektivzins, Nominalzins und Nebenkosten bei Krediten.',
    path: '/compare/apr-vs-nominal',
  },
  {
    title: 'Mieten oder Kaufen: Entscheidungsmodell',
    desc: 'Bewerten Sie Wertsteigerung, Hypothekenzinsen, Grundsteuer und Opportunitätskosten im Vergleich zur Miete.',
    path: '/loan/rent-vs-buy',
  },
];

const comparisonPagesEn = [
  {
    title: 'Snowball vs. Avalanche Debt Payoff',
    desc: 'Compare psychological momentum against mathematical interest optimization to eliminate credit debt faster.',
    path: '/compare/snowball-vs-avalanche',
  },
  {
    title: 'Roth vs. Traditional IRA Comparison',
    desc: 'Analyze upfront tax deduction versus tax-free retirement growth across income brackets.',
    path: '/compare/roth-vs-traditional-ira',
  },
  {
    title: 'APR vs. Nominal Interest Rate',
    desc: 'Understand compounding periods, APR vs APY, and closing fees on consumer and mortgage debt.',
    path: '/compare/apr-vs-nominal',
  },
  {
    title: 'Rent vs. Buy Decision Engine',
    desc: 'Evaluate homeownership appreciation, mortgage interest, property tax, and opportunity costs against renting.',
    path: '/loan/rent-vs-buy',
  },
];

const comparisonPagesJa = [
  {
    title: 'スノーボール法 vs. アバランチ法（借金返済比較）',
    desc: '心理的な達成感（雪だるま方式）と数学的な利息削減（雪崩方式）を比較し、最速で借金を完済する方法を導きます。',
    path: '/compare/snowball-vs-avalanche',
  },
  {
    title: 'Roth IRA vs. Traditional IRA（確定拠出個人年金）',
    desc: '拠出時の所得控除と退職後の非課税受取のメリットを、年収と将来税率に基づいて比較分析します。',
    path: '/compare/roth-vs-traditional-ira',
  },
  {
    title: '名目金利（表面金利）vs. 実質年率（APR）',
    desc: '複利計算期間、実質年率（APR）と実質利回り（APY）、諸費用や手数料が総借入コストに与える影響を解説します。',
    path: '/compare/apr-vs-nominal',
  },
  {
    title: '賃貸 vs. 持ち家（購入）シミュレーション',
    desc: '物件価格の上昇期待、住宅ローン金利、固定資産税、機会費用を総合的に勘案し、購入と賃貸の損益を比較します。',
    path: '/loan/rent-vs-buy',
  },
];

const comparisonPagesPt = [
  {
    title: 'Bola de Neve vs. Avalancha de Dívidas',
    desc: 'Compare o impulso psicológico com a otimização matemática de juros para quitar dívidas mais rápido.',
    path: '/compare/snowball-vs-avalanche',
  },
  {
    title: 'Roth vs. Previdência / IRA Tradicional',
    desc: 'Analise a dedução fiscal imediata versus o crescimento com resgate isento de impostos na aposentadoria.',
    path: '/compare/roth-vs-traditional-ira',
  },
  {
    title: 'Taxa Nominal vs. CET / Taxa Efetiva (APR)',
    desc: 'Compreenda períodos de capitalização, CET, juros nominais e tarifas de contratação em financiamentos.',
    path: '/compare/apr-vs-nominal',
  },
  {
    title: 'Alugar vs. Comprar Imóvel: Simulador Decisório',
    desc: 'Avalie valorização imobiliária, juros de financiamento, impostos e custos de oportunidade frente ao aluguel.',
    path: '/loan/rent-vs-buy',
  },
];

const comparisonPages = isEs ? comparisonPagesEs : (isDe ? comparisonPagesDe : (isJa ? comparisonPagesJa : (isPt ? comparisonPagesPt : comparisonPagesEn)));

const legalPagesEs = [
  { name: t('nav.about', 'Sobre Nosotros'), path: '/about', desc: 'Nuestra misión de ofrecer cálculos financieros privados, gratuitos y en el navegador.' },
  { name: t('nav.contact', 'Contacto'), path: '/contact', desc: 'Canales de soporte directo, reporte de errores y solicitudes de nuevas herramientas.' },
  { name: t('nav.privacy', 'Política de Privacidad'), path: '/privacy', desc: 'Política de cero retención de datos, cálculos en el navegador y opciones de cookies.' },
  { name: t('nav.terms', 'Términos de Servicio'), path: '/terms', desc: 'Uso educativo permitido y limitación de responsabilidad legal.' },
  { name: t('nav.disclaimer', 'Aviso Legal'), path: '/disclaimer', desc: 'Avisos importantes sobre modelos financieros sin asesoramiento profesional.' },
];

const legalPagesDe = [
  { name: t('nav.about', 'Über uns'), path: '/about', desc: 'Unsere Mission: kostenlose, datenschutzfreundliche Finanzberechnungen direkt im Browser.' },
  { name: t('nav.contact', 'Kontakt'), path: '/contact', desc: 'Direkter Support, Fehlerberichte und Vorschläge für neue Rechner.' },
  { name: t('nav.privacy', 'Datenschutzerklärung'), path: '/privacy', desc: 'Vollständiger Verzicht auf Datenspeicherung, lokale Berechnungen und Cookie-Optionen.' },
  { name: t('nav.terms', 'Nutzungsbedingungen'), path: '/terms', desc: 'Zulässige Nutzung zu Informationszwecken und Haftungsbeschränkungen.' },
  { name: t('nav.disclaimer', 'Haftungsausschluss'), path: '/disclaimer', desc: 'Wichtige Hinweise: Berechnungen dienen nur Informationszwecken und sind keine Finanzberatung.' },
];

const legalPagesEn = [
  { name: t('nav.about', 'About Us'), path: '/about', desc: 'Our mission to provide private, free, client-side financial calculations.' },
  { name: t('nav.contact', 'Contact Us'), path: '/contact', desc: 'Direct support, bug reporting, and feature request channels.' },
  { name: t('nav.privacy', 'Privacy Policy'), path: '/privacy', desc: 'Zero data retention policy, client-side guarantees, and AdSense cookie options.' },
  { name: t('nav.terms', 'Terms of Service'), path: '/terms', desc: 'Permitted educational use and limitation of liability.' },
  { name: t('nav.disclaimer', 'Disclaimer'), path: '/disclaimer', desc: 'Important disclosures regarding non-advisory financial modeling.' },
];

const legalPagesJa = [
  { name: t('nav.about', '当サイトについて'), path: '/about', desc: 'プライバシーに配慮し、完全無料かつブラウザ完結で動作する金融計算ツールの提供方針。' },
  { name: t('nav.contact', 'お問い合わせ'), path: '/contact', desc: '公式サポート窓口、バグ報告、新機能・計算機のリクエスト受付。' },
  { name: t('nav.privacy', 'プライバシーポリシー'), path: '/privacy', desc: 'データ非保持方針、クライアントサイド計算の保証、およびCookieの設定について。' },
  { name: t('nav.terms', '利用規約'), path: '/terms', desc: '教育目的での利用規約および免責事項に関する重要事項。' },
  { name: t('nav.disclaimer', '免責事項'), path: '/disclaimer', desc: '財務アドバイスの非提供および金融シミュレーションモデルに関する免責事項。' },
];

const legalPagesPt = [
  { name: t('nav.about', 'Sobre Nós'), path: '/about', desc: 'Nossa missão de oferecer cálculos financeiros gratuitos, privados e executados no navegador.' },
  { name: t('nav.contact', 'Fale Conosco'), path: '/contact', desc: 'Canais de suporte direto, reporte de erros e sugestões de novas calculadoras.' },
  { name: t('nav.privacy', 'Política de Privacidade'), path: '/privacy', desc: 'Política de zero retenção de dados, garantias do lado do cliente e opções de cookies.' },
  { name: t('nav.terms', 'Termos de Serviço'), path: '/terms', desc: 'Termos de uso educacional permitido e limites de responsabilidade legal.' },
  { name: t('nav.disclaimer', 'Aviso Legal'), path: '/disclaimer', desc: 'Avisos importantes sobre simulação e modelos financeiros sem assessoria de investimentos.' },
];

const legalPages = isEs ? legalPagesEs : (isDe ? legalPagesDe : (isJa ? legalPagesJa : (isPt ? legalPagesPt : legalPagesEn)));
---

<Layout
  title={t('sitemap.title', 'Financial Comparisons & Calculators Sitemap | financialcalculatorapp.com')}
  description={t('sitemap.subtitle', 'Complete index of interactive financial calculators, side-by-side strategy comparisons, and money guides to make smarter borrowing decisions.')}
  lang={lang}
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <header class="text-center space-y-3 pt-4">
      <nav class="flex items-center justify-center gap-2 text-xs font-mono text-muted mb-2" aria-label="Breadcrumb">
        <a href={translatePath('/')} class="hover:text-ink transition-colors">{t('nav.home', 'Home')}</a>
        <span>/</span>
        <span class="text-ink font-bold">{t('nav.sitemap', 'Sitemap')}</span>
      </nav>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-paper border border-ink/40 text-[11px] font-mono font-bold text-ink">
        <span class="text-input-accent">✦</span>
        <span>{isEs ? "Índice del Sitio HTML" : (isDe ? "HTML-Seitenverzeichnis" : (isJa ? "HTMLサイトマップ・索引" : (isPt ? "Índice do Site HTML" : "HTML Site Index")))}</span>
      </div>
      <h1 class="font-display font-black text-3xl sm:text-5xl tracking-tight text-ink">
        {t('sitemap.heading', 'Site Index & Sitemap.')}
      </h1>
      <p class="text-sm sm:text-base text-muted max-w-2xl mx-auto leading-relaxed">
        {t('sitemap.subtitle', 'Complete directory of all 38 financial calculators, comparison guides, educational articles, and company information.')}
      </p>
    </header>

    <!-- Calculators Categorized Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between border-b border-line pb-3">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-ink flex items-center gap-2">
          <span>🧮</span>
          <span>{t('sitemap.calculators', 'Financial Calculators (38 Tools)')}</span>
        </h2>
        <a href={translatePath('/calculators')} class="text-xs font-mono font-bold text-input-accent hover:underline">
          {isEs ? "Ver Directorio Interactivo →" : (isDe ? "Interaktives Verzeichnis anzeigen →" : (isJa ? "計算機一覧を見る →" : (isPt ? "Ver Diretório Interativo →" : "View Interactive Directory →")))}
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {CATEGORIES_DATA.map((cat) => (
          <div class="p-5 rounded-2xl border border-line bg-paper shadow-[var(--control-shadow)] space-y-4">
            <div class="flex items-center gap-2.5 pb-2 border-b border-line/20">
              <span class="text-xl">{cat.icon}</span>
              <h3 class="font-display font-bold text-base text-ink">
                {t(cat.nameKey, cat.defaultName)}
              </h3>
              <span class="ml-auto text-[10px] font-mono px-2 py-0.5 rounded-full bg-soft text-muted font-bold">
                {cat.calculators.length}
              </span>
            </div>

            <ul class="space-y-2.5 text-xs">
              {cat.calculators.map((calc) => (
                <li>
                  <a
                    href={translatePath(calc.url)}
                    class="group block p-2 rounded-lg hover:bg-soft transition-colors border border-transparent hover:border-line/20"
                  >
                    <div class="font-semibold text-ink group-hover:text-input-accent transition-colors flex items-center justify-between">
                      <span>{t(calc.nameKey, calc.defaultName)}</span>
                      {calc.badge && (
                        <span class="text-[9px] font-mono uppercase px-1.5 py-0.5 rounded bg-layer-2 text-ink/70">
                          {calc.badge}
                        </span>
                      )}
                    </div>
                    <p class="text-muted text-[11px] mt-0.5 line-clamp-1">
                      {t(calc.descKey, calc.defaultDesc)}
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Comparisons & Decision Tools -->
    <section class="space-y-4">
      <div class="border-b border-line pb-3">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-ink flex items-center gap-2">
          <span>⚖️</span>
          <span>{t('sitemap.comparisons', 'Comparison & Strategy Guides')}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {comparisonPages.map((item) => (
          <a
            href={translatePath(item.path)}
            class="p-4 rounded-xl border border-line bg-paper hover:bg-soft transition-colors shadow-[var(--control-shadow)] block group"
          >
            <div class="font-display font-bold text-sm text-ink group-hover:text-input-accent transition-colors">
              {item.title} →
            </div>
            <p class="text-xs text-muted mt-1 leading-relaxed">
              {item.desc}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- Articles & Educational Content -->
    {blogPosts.length > 0 && (
      <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-line pb-3">
          <h2 class="text-xl sm:text-2xl font-bold font-display text-ink flex items-center gap-2">
            <span>📚</span>
            <span>{t('sitemap.articles', 'Financial Insights & Articles')}</span>
          </h2>
          <a href={translatePath('/blog')} class="text-xs font-mono font-bold text-input-accent hover:underline">
            {isEs ? "Todos los Artículos →" : (isDe ? "Alle Artikel →" : (isJa ? "すべての記事一覧 →" : (isPt ? "Todos os Artigos →" : "All Blog Posts →")))}
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {blogPosts.map((post) => {
            const loc = getLocalizedBlogPost(post.id, lang);
            const postTitle = loc.title || post.data.title;
            const postDesc = loc.description || post.data.description;
            return (
              <a
                href={translatePath(`/blog/${post.id}`)}
                class="p-4 rounded-xl border border-line bg-paper hover:bg-soft transition-colors shadow-[var(--control-shadow)] block group flex flex-col justify-between"
              >
                <div>
                  <span class="text-[10px] font-mono text-muted uppercase">
                    {new Date(post.data.pubDate).toLocaleDateString(isEs ? 'es-ES' : (isDe ? 'de-DE' : (isJa ? 'ja-JP' : (isPt ? 'pt-BR' : 'en-US'))), { month: 'short', day: 'numeric', year: 'numeric' })}
                  </span>
                  <h3 class="font-display font-bold text-sm text-ink group-hover:text-input-accent transition-colors mt-1">
                    {postTitle}
                  </h3>
                  <p class="text-xs text-muted mt-1.5 line-clamp-2 leading-relaxed">
                    {postDesc}
                  </p>
                </div>
                <div class="text-[11px] font-mono font-bold text-input-accent mt-3">
                  {isEs ? "Leer Artículo →" : (isDe ? "Artikel lesen →" : (isJa ? "記事を読む →" : (isPt ? "Ler Artigo →" : "Read Article →")))}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}

    <!-- Reference & Glossary -->
    <section class="space-y-4">
      <div class="border-b border-line pb-3">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-ink flex items-center gap-2">
          <span>📖</span>
          <span>{t('sitemap.glossary', 'Glossary & References')}</span>
        </h2>
      </div>

      <div class="p-5 rounded-2xl border border-line bg-paper shadow-[var(--control-shadow)] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <h3 class="font-display font-bold text-base text-ink">
            {isEs ? "Glosario de Términos Financieros y Amortización" : (isDe ? "Finanzlexikon & Tilgungsbegriffe" : (isJa ? "金融用語・ローン償還用語集" : (isPt ? "Glossário de Termos Financeiros e Amortização" : "Financial Terms & Amortization Glossary")))}
          </h3>
          <p class="text-xs text-muted max-w-xl mt-1">
            {isEs ? "Guía alfabética de conceptos clave: TAE, TIN/APY, DTI, LTV, PMI, amortización, frecuencia de capitalización y flujos de caja." : (isDe ? "Alphabetische Übersicht wichtiger Finanzbegriffe: Effektiver Jahreszins, Nominalzins, DTI, Tilgung, Zinseszins und Cashflow-Kennzahlen." : (isJa ? "重要金融用語の解説集: 実質年率(APR)、実質利回り(APY)、DTI、LTV、PMI、元利均等返済、複利頻度、キャッシュフロー指標など。" : (isPt ? "Guia alfabético dos principais conceitos financeiros: CET/APR, Taxa Efetiva/APY, DTI, LTV, PMI, amortização, frequência de capitalização e fluxo de caixa." : "Alphabetical guide covering essential financial terminology: APR, APY, DTI, LTV, PMI, Amortization, Compound Frequency, IRR, and Cash Flow metrics.")))}
          </p>
        </div>
        <a
          href={translatePath('/glossary')}
          class="shrink-0 px-4 py-2 rounded-lg bg-ink text-canvas text-xs font-mono font-bold hover:opacity-90 transition-opacity"
        >
          {isEs ? "Explorar Glosario →" : (isDe ? "Glossar entdecken →" : (isJa ? "用語集を見る →" : (isPt ? "Explorar Glossário →" : "Explore Glossary →")))}
        </a>
      </div>
    </section>

    <!-- Company & Legal -->
    <section class="space-y-4">
      <div class="border-b border-line pb-3">
        <h2 class="text-xl sm:text-2xl font-bold font-display text-ink flex items-center gap-2">
          <span>⚖️</span>
          <span>{t('sitemap.legal', 'Company & Legal Documents')}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {legalPages.map((page) => (
          <a
            href={translatePath(page.path)}
            class="p-4 rounded-xl border border-line bg-paper hover:bg-soft transition-colors shadow-[var(--control-shadow)] block group"
          >
            <div class="font-display font-bold text-sm text-ink group-hover:text-input-accent transition-colors">
              {page.name} →
            </div>
            <p class="text-xs text-muted mt-1 leading-relaxed">
              {page.desc}
            </p>
          </a>
        ))}
      </div>
    </section>

    <!-- XML Sitemap Link -->
    <div class="p-4 rounded-xl border border-line/30 bg-layer-2 text-center text-xs font-mono text-muted">
      {isEs ? "Feed XML para Motores de Búsqueda:" : (isDe ? "XML-Feed für Suchmaschinen:" : (isJa ? "検索エンジン用XMLフィード:" : (isPt ? "Feed XML para Motores de Busca:" : "Raw Search Engine XML Feed:")))} <a href="/sitemap.xml" target="_blank" class="text-link hover:underline font-bold">/sitemap.xml</a>
    </div>
  </div>
</Layout>
