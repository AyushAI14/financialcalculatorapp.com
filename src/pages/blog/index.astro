---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';
import { getLocalizedBlogPost } from '../../i18n/blogs';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const posts = await getCollection('blog');
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const localizedPosts = sortedPosts.map(post => {
  const loc = getLocalizedBlogPost(post.id, lang);
  return {
    ...post,
    localizedTitle: loc.title || post.data.title,
    localizedDesc: loc.description || post.data.description,
  };
});
---

<Layout 
  title={`${t('blog.title', 'Financial Insights Blog - financialcalculatorapp.com')}`} 
  description={t('blog.subtitle', 'Deep dives into financial planning, loan structures, debt payoff strategies, and purchasing power math from the financialcalculatorapp.com team.')}
  lang={lang}
>
  <div class="max-w-4xl mx-auto py-8 px-4">
    <header class="mb-12 border-b border-hairline pb-8">
      <h1 class="text-4xl font-extrabold tracking-tight text-ink">{t('blog.heading', 'Financial Insights Blog')}</h1>
      <p class="text-sm text-body mt-2">{t('blog.subtitle', 'Deep dives, guides, and educational articles exploring interest rates, debt dynamics, tax schedules, and saving strategies.')}</p>
    </header>

    <div class="space-y-10">
      {localizedPosts.length === 0 ? (
        <p class="text-mute text-sm">{t('blog.empty', 'No articles published yet.')}</p>
      ) : (
        localizedPosts.map(post => (
          <article class="space-y-2.5">
            <div class="flex items-center gap-3 text-xs font-mono text-mute">
              <span>{post.data.pubDate.toLocaleDateString(lang, { year: 'numeric', month: 'long', day: 'numeric' })}</span>
              <span>•</span>
              <span>{t('blog.by', 'By')} {post.data.author}</span>
            </div>
            
            <h2 class="text-2xl font-bold tracking-tight text-ink hover:text-primary transition-colors">
              <a href={translatePath(`/blog/${post.id}`)}>{post.localizedTitle}</a>
            </h2>
            
            <p class="text-sm text-body leading-relaxed max-w-2xl">{post.localizedDesc}</p>
            
            <div class="flex items-center gap-2 pt-1.5 no-print">
              {post.data.tags.map(tag => (
                <span class="px-2 py-0.5 bg-canvas-soft border border-hairline text-mute font-mono text-[10px] rounded-full">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))
      )}
    </div>
  </div>
</Layout>
