---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} - FinCompute Blog`} description={post.data.description}>
  <article class="max-w-3xl mx-auto py-8 px-4">
    <header class="mb-8 border-b border-hairline pb-6">
      <div class="flex items-center gap-3 text-xs font-mono text-mute mb-2">
        <span>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
        <span>•</span>
        <span>By {post.data.author}</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">{post.data.title}</h1>
      
      <div class="flex items-center gap-2 mt-4 no-print">
        {post.data.tags.map(tag => (
          <span class="px-2 py-0.5 bg-canvas-soft border border-hairline text-mute font-mono text-[10px] rounded-full">
            #{tag}
          </span>
        ))}
      </div>
    </header>

    <div class="blog-content prose prose-sm sm:prose-base dark:prose-invert max-w-none text-body leading-relaxed space-y-6">
      <Content />
    </div>

    <footer class="mt-12 pt-8 border-t border-hairline no-print">
      <a href="/blog" class="text-xs font-mono font-medium text-mute hover:text-ink transition-colors flex items-center gap-1">
        ← Back to all posts
      </a>
    </footer>
  </article>
</Layout>

<style is:global>
  .blog-content a {
    color: #0070f3;
    text-decoration: underline;
    font-weight: 600;
  }
  .blog-content a:hover {
    color: #0056b3;
  }
  .blog-content h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
    color: var(--color-ink, #171717);
  }
  .blog-content h3 {
    font-size: 1.2rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    color: var(--color-ink, #171717);
  }
  .blog-content ul {
    list-style-type: disc;
    padding-left: 1.5rem;
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    space-y: 0.25rem;
  }
  .blog-content li {
    margin-bottom: 0.4rem;
  }
</style>
