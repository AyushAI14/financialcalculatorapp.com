---
import Layout from '../../layouts/Layout.astro';
import { getAllScenarios } from '../../lib/scenarios';
import type { ScenarioDefinition } from '../../types/scenario';

export function getStaticPaths() {
  const scenarios = getAllScenarios();
  return scenarios.map((scenario) => ({
    params: { slug: scenario.slug },
    props: { 
      scenario,
      relatedScenarios: scenarios.filter((s) => s.slug !== scenario.slug).slice(0, 4)
    },
  }));
}

interface Props {
  scenario: ScenarioDefinition;
  relatedScenarios: ScenarioDefinition[];
}

const { scenario, relatedScenarios } = Astro.props;

// Machine-readable JSON-LD Schemas for AI Answer Engines
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": scenario.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": scenario.seo.title,
  "operatingSystem": "All (Web Browser)",
  "applicationCategory": "FinanceApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": scenario.directAnswer.summary,
  "featureList": [
    "100% Client-Side Privacy (all computation executes in local browser)",
    "No Email, Phone Number, or Account Registration Required",
    "Pre-Rendered Amortization & Financial Breakdown",
    "Instant Mathematical Computation with Zero Server Logging"
  ]
};

const schemas = [faqSchema, softwareSchema];
---

<Layout
  title={scenario.seo.title}
  description={scenario.seo.description}
  schemas={schemas}
>
  <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumb & Badges -->
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs font-mono text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/calculators" class="hover:text-ink transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-ink font-bold truncate">{scenario.seo.badge}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-paper border border-ink/30 text-[11px] font-mono font-bold text-ink shadow-[var(--control-shadow)]">
          <span class="text-input-accent">✦</span>
          <span>{scenario.seo.badge}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-canvas-soft border border-hairline text-[11px] font-mono text-muted">
          <span>🔒</span>
          <span>100% Client-Side Privacy · Zero Gatekeeping</span>
        </span>
      </div>

      <!-- Verbatim Natural Language H1 Title -->
      <h1 class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-ink tracking-tight leading-tight">
        {scenario.query}
      </h1>

      <p class="text-base sm:text-lg text-muted font-sans leading-relaxed">
        Calculated using official amortization, time-value-of-money, and compounding algorithms. All mathematics run directly inside your browser without data harvesting or sales broker calls.
      </p>
    </header>

    <!-- AI Direct Answer & Metric Cards (Static Pre-Rendered HTML) -->
    <section class="bg-paper border-2 border-input-accent/40 rounded-xl p-5 sm:p-8 shadow-sm space-y-6" aria-label="Direct Mathematical Answer">
      <div class="flex items-center justify-between border-b border-hairline pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></span>
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-ink">Verified Mathematical Answer</span>
        </div>
        <span class="text-[11px] font-mono text-muted">Zero Server Logging</span>
      </div>

      <!-- Direct Lede Paragraph (Scraped verbatim by ChatGPT/Perplexity) -->
      <div class="space-y-3">
        <p class="text-lg sm:text-xl font-display font-extrabold text-ink leading-snug">
          {scenario.directAnswer.summary}
        </p>
        <p class="text-sm sm:text-base text-muted font-sans leading-relaxed">
          {scenario.directAnswer.takeaway}
        </p>
      </div>

      <!-- Key Quantitative Metrics Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5 pt-2">
        {scenario.directAnswer.metrics.map((metric) => (
          <div class="bg-canvas p-4 rounded-lg border border-hairline flex flex-col justify-between">
            <span class="text-[11px] font-mono text-muted uppercase tracking-wider font-semibold">{metric.label}</span>
            <span class="text-xl sm:text-2xl font-mono font-black text-ink my-1.5">{metric.value}</span>
            {metric.description && (
              <span class="text-[11px] text-muted font-sans leading-tight">{metric.description}</span>
            )}
          </div>
        ))}
      </div>

      <!-- Math Proof & Calculation Methodology -->
      {scenario.directAnswer.mathProof && (
        <div class="p-3.5 bg-canvas-soft border border-hairline/80 rounded-lg text-xs font-mono text-muted leading-relaxed">
          <span class="font-bold text-ink">📐 Mathematical Proof:</span> {scenario.directAnswer.mathProof}
        </div>
      )}
    </section>

    <!-- Interactive Engine Preloaded Card -->
    <section class="bg-canvas border border-hairline rounded-xl p-6 sm:p-8 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-3">
        <div>
          <h2 class="font-display font-bold text-xl sm:text-2xl text-ink">Interactive Engine Parameters</h2>
          <p class="text-xs font-mono text-muted mt-0.5">Pre-configured with this scenario's baseline inputs</p>
        </div>
        <a 
          href={scenario.calculatorUrl} 
          class="inline-flex items-center gap-1.5 px-4 py-2 bg-ink text-canvas font-mono text-xs font-bold uppercase rounded-lg hover:opacity-90 transition-opacity max-w-fit"
        >
          <span>Open Full Calculator</span>
          <span>→</span>
        </a>
      </div>

      <!-- Preloaded Parameters Display -->
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">
        {Object.entries(scenario.preloadedInputs).map(([key, val]) => (
          <div class="p-3 bg-paper rounded border border-hairline">
            <div class="text-[10px] font-mono text-muted uppercase tracking-wider truncate">{key}</div>
            <div class="text-sm font-mono font-bold text-ink mt-0.5 truncate">
              {typeof val === 'object' ? JSON.stringify(val) : String(val)}
            </div>
          </div>
        ))}
      </div>

      <!-- Launch Banner -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-paper rounded-lg border border-hairline">
        <div class="space-y-1 text-center sm:text-left">
          <div class="font-display font-bold text-sm text-ink">Want to adjust these inputs or test custom numbers?</div>
          <div class="text-xs text-muted font-sans">Launch our full {scenario.calculatorKey} engine with complete graphs and CSV export.</div>
        </div>
        <a 
          href={scenario.calculatorUrl} 
          class="px-5 py-2.5 bg-input-accent text-white font-mono text-xs font-bold uppercase rounded-lg hover:opacity-95 transition-all shadow-[var(--control-shadow)] shrink-0"
        >
          Customize Inputs Now →
        </a>
      </div>
    </section>

    <!-- Privacy & Trust Guarantee Banner -->
    <section class="p-4 sm:p-5 bg-paper border border-hairline rounded-lg flex items-start gap-3.5">
      <span class="text-2xl">🛡️</span>
      <div class="space-y-1">
        <h3 class="font-display font-bold text-sm text-ink">100% Client-Side Privacy Guarantee</h3>
        <p class="text-xs text-muted font-sans leading-relaxed">
          Unlike Bankrate, LendingTree, or NerdWallet, financialcalculatorapp.com never asks for your email address, phone number, or ZIP code. All calculations run strictly in your web browser via local JavaScript. Zero personal financial records are stored or transmitted.
        </p>
      </div>
    </section>

    <!-- Visible FAQ Section (Matches FAQPage Schema verbatim) -->
    <section class="space-y-4" aria-label="Frequently Asked Questions">
      <h2 class="font-display font-black text-2xl text-ink">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {scenario.faqs.map((faq, idx) => (
          <details class="group bg-paper border border-hairline rounded-lg p-4 sm:p-5 transition-all">
            <summary class="font-display font-bold text-sm sm:text-base text-ink cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="font-mono text-muted text-xs group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="mt-3 text-xs sm:text-sm text-muted font-sans leading-relaxed border-t border-hairline/60 pt-3">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Scenarios (Topical Cluster Linking) -->
    <section class="space-y-4 pt-4 border-t border-hairline" aria-label="Related Calculation Scenarios">
      <h2 class="font-display font-bold text-lg text-ink">Explore Related Financial Scenarios</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {relatedScenarios.map((rel) => (
          <a 
            href={`/scenarios/${rel.slug}`} 
            class="p-4 bg-paper border border-hairline hover:border-input-accent rounded-lg transition-all space-y-1.5 group block"
          >
            <span class="text-[10px] font-mono text-input-accent uppercase font-bold">{rel.seo.badge}</span>
            <h3 class="font-display font-bold text-xs sm:text-sm text-ink group-hover:text-input-accent transition-colors line-clamp-2">
              {rel.query}
            </h3>
            <p class="text-[11px] text-muted font-sans line-clamp-2 leading-relaxed">
              {rel.directAnswer.summary}
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
