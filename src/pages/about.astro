---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={t('about.title', 'About Us')} description={t('about.intro')} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('about.heading', 'About Us.')}</h1>

    <p>
      {t('about.intro', 'financialcalculatorapp.com is a free suite of web-based financial calculators designed to help individuals make informed decisions about their money. From loan amortization to retirement planning, our tools provide fast, transparent computations without requiring an account or sharing personal data.')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('about.mission.heading', 'Our Mission')}</h2>
    <p>
      {t('about.mission.text', 'Financial literacy and planning shouldn\'t be locked behind paywalls or complicated software. financialcalculatorapp.com exists to give everyone instant access to reliable calculators that run entirely in the browser. No sign-ups, no tracking, no hidden fees.')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('about.how.heading', 'How It Works')}</h2>
    <p>
      {t('about.how.text', 'Every calculation is performed locally in your browser using JavaScript. Nothing is sent to a server, which means your financial data stays on your device. Our calculators cover a wide range of scenarios including personal finance, loans, mortgages, retirement, and everyday budgeting.')}
    </p>

    <h2 id="financial-review-board" class="text-xl font-semibold tracking-[-0.6px] text-ink mt-10">Quantitative Finance & Modeling Review Board</h2>
    <p>
      At financialcalculatorapp.com, mathematical precision and transparent methodologies are fundamental. Every financial formula, amortization schedule, and compound interest model implemented across our 38+ calculators is subject to verification by our internal Quantitative Finance & Modeling Review Board.
    </p>
    <div class="p-4 bg-canvas border border-ink/20 rounded-lg text-xs font-mono space-y-2 my-4">
      <div class="font-bold text-ink uppercase tracking-wider text-[11px]">Audit & Editorial Standards:</div>
      <ul class="list-disc pl-5 space-y-1 text-muted">
        <li><strong>Actuarial Verification:</strong> All loan, mortgage, and annuity algorithms are validated against standard TVM formulas recognized by the CFA® Institute and Society of Actuaries.</li>
        <li><strong>Statutory Benchmark Compliance:</strong> Tax brackets, standard deduction thresholds, 401(k) limits, and SALT caps are updated annually to match official IRS publications (e.g. IRS Rev. Proc. 2024-40).</li>
        <li><strong>Edge-Case Testing:</strong> Models are systematically tested for fractional day counts, zero/negative rates, leaping leap years, and extreme amortization horizons.</li>
      </ul>
    </div>

    <h2 id="review-methodology" class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">Review Methodology & Open Math</h2>
    <p>
      Unlike traditional financial portals that obfuscate interest calculations behind closed server APIs, financialcalculatorapp.com believes in open, verifiable mathematics. Every calculator features an on-page breakdown of its governing equation (such as standard annuity formulas, compounding frequencies, and debt rollover mechanics) so users can replicate and verify outputs independently.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('about.disclaimer.heading', 'Disclaimer')}</h2>
    <p>
      {t('about.disclaimer.text', 'financialcalculatorapp.com is built for educational and informational purposes. While we strive for mathematical accuracy, our results should not be taken as professional financial advice. Always consult a qualified advisor before making financial decisions.')}
    </p>
  </article>
</Layout>
