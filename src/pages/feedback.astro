---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

export const prerender = false;

const CORRECT_PASSCODE = process.env.ADMIN_PASSCODE || 'admin123';
let authenticated = false;
let errorMsg = '';
let feedbacks: any[] = [];

// 1. Get cookies from request headers
const cookies = Astro.request.headers.get('cookie') || '';
const sessionCookie = cookies
  .split(';')
  .map(c => c.trim())
  .find(c => c.startsWith('admin_session='));

if (sessionCookie && sessionCookie.split('=')[1] === 'authenticated') {
  authenticated = true;
}

// 2. Handle POST Actions (Login, Clear, Logout)
if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get('action');

    if (action === 'login') {
      const passcode = formData.get('passcode');
      if (passcode === CORRECT_PASSCODE) {
        authenticated = true;
        Astro.response.headers.set(
          'Set-Cookie',
          'admin_session=authenticated; Path=/; HttpOnly; SameSite=Strict; Max-Age=86400'
        );
      } else {
        errorMsg = 'Incorrect passcode. Please try again.';
      }
    } else if (action === 'clear' && authenticated) {
      // Clear local JSON
      if (import.meta.env.DEV) {
        const filePath = path.resolve(process.cwd(), 'src/data/feedback-submissions.json');
        if (fs.existsSync(filePath)) {
          fs.writeFileSync(filePath, JSON.stringify([]), 'utf-8');
        }
      }

      // Clear Vercel KV
      const kvUrl = process.env.KV_REST_API_URL;
      const kvToken = process.env.KV_REST_API_TOKEN;
      if (kvUrl && kvToken) {
        await fetch(`${kvUrl}/set/feedback_submissions`, {
          method: 'POST',
          headers: {
            Authorization: `Bearer ${kvToken}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(JSON.stringify([]))
        });
      }
    } else if (action === 'logout') {
      authenticated = false;
      Astro.response.headers.set(
        'Set-Cookie',
        'admin_session=; Path=/; HttpOnly; SameSite=Strict; Max-Age=0'
      );
    }
  } catch (e) {
    console.error('Error handling feedback post action:', e);
  }
}

// 3. Load feedbacks if authenticated
if (authenticated) {
  // Load from local file
  const filePath = path.resolve(process.cwd(), 'src/data/feedback-submissions.json');
  let localFeedbacks = [];
  if (fs.existsSync(filePath)) {
    try {
      localFeedbacks = JSON.parse(fs.readFileSync(filePath, 'utf-8'));
    } catch (e) {}
  }

  // Load from Vercel KV
  let kvFeedbacks = [];
  const kvUrl = process.env.KV_REST_API_URL;
  const kvToken = process.env.KV_REST_API_TOKEN;
  if (kvUrl && kvToken) {
    try {
      const kvRes = await fetch(`${kvUrl}/get/feedback_submissions`, {
        headers: { Authorization: `Bearer ${kvToken}` }
      });
      if (kvRes.ok) {
        const kvBody = await kvRes.json();
        if (kvBody.result) {
          kvFeedbacks = JSON.parse(kvBody.result);
        }
      }
    } catch (e) {}
  }

  // Merge & Sort
  const mergedMap = new Map();
  [...localFeedbacks, ...kvFeedbacks].forEach(item => {
    const key = `${item.timestamp}-${item.url}`;
    mergedMap.set(key, item);
  });

  feedbacks = Array.from(mergedMap.values()).sort((a, b) => b.timestamp - a.timestamp);
}

const totalRatings = feedbacks.length;
const yesCount = feedbacks.filter(item => item.rating === 'yes').length;
const ratio = totalRatings > 0 ? Math.round((yesCount / totalRatings) * 100) : 0;
---

<Layout 
  title="Feedback Dashboard - FinCompute.com" 
  description="View user helpfulness feedback ratings and submissions collected across all calculators."
>
  { !authenticated ? (
    /* Passcode Unlock Overlay (Server Rendered) */
    <div id="unlock-overlay" class="min-h-[70vh] flex items-center justify-center p-4">
      <form method="POST" class="max-w-sm w-full bg-canvas border border-hairline p-6 rounded-lg shadow-lg space-y-4 text-center">
        <input type="hidden" name="action" value="login" />
        <div class="w-12 h-12 rounded-full bg-canvas-soft border border-hairline flex items-center justify-center text-lg mx-auto">🔒</div>
        <div>
          <h3 class="text-sm font-semibold text-ink">Authorization Required</h3>
          <p class="text-[11px] text-body mt-1">Please enter the admin passcode to view dashboard metrics.</p>
        </div>
        <input 
          type="password" 
          name="passcode" 
          placeholder="Enter passcode..." 
          class="w-full h-10 px-3 bg-canvas text-ink text-sm border border-hairline rounded focus:outline-none focus:border-hairline-strong focus:ring-1 focus:ring-hairline-strong text-center" 
          required 
          autoplay
        />
        {errorMsg && <div class="text-xs text-error font-medium">{errorMsg}</div>}
        <button type="submit" class="w-full py-2 bg-primary text-on-primary rounded font-semibold text-xs hover:opacity-90 transition-opacity cursor-pointer shadow-sm">
          Unlock Dashboard
        </button>
      </form>
    </div>
  ) : (
    /* Dashboard Content */
    <div id="dashboard-content" class="max-w-4xl mx-auto py-8 px-4 space-y-8 animate-fade-in">
      <header class="border-b border-hairline pb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h1 class="text-3xl font-extrabold tracking-tight text-ink">Feedback Submissions</h1>
          <p class="text-xs text-body mt-1">Review helpfulness ratings left by users across FinCompute calculators.</p>
        </div>
        <div class="flex items-center gap-2 no-print">
          <form method="POST" onsubmit="return confirm('Are you sure you want to clear all feedback logs?');">
            <input type="hidden" name="action" value="clear" />
            <button type="submit" class="px-4 py-2 bg-canvas hover:bg-canvas-soft border border-hairline hover:border-error hover:text-error text-ink text-xs font-semibold rounded-full cursor-pointer transition-colors shadow-sm">
              Clear All Feedback
            </button>
          </form>
          <form method="POST">
            <input type="hidden" name="action" value="logout" />
            <button type="submit" class="px-4 py-2 bg-canvas hover:bg-canvas-soft border border-hairline text-ink text-xs font-semibold rounded-full cursor-pointer transition-colors shadow-sm">
              Log Out
            </button>
          </form>
        </div>
      </header>

      {/* Metrics Cards */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="border border-hairline p-5 rounded-lg bg-canvas shadow-sm">
          <h4 class="text-[10px] font-mono uppercase tracking-wider text-mute">Total Ratings</h4>
          <p class="text-3xl font-bold text-ink mt-1 font-mono">{totalRatings}</p>
        </div>
        <div class="border border-hairline p-5 rounded-lg bg-canvas shadow-sm">
          <h4 class="text-[10px] font-mono uppercase tracking-wider text-mute">Helpful (👍 Yes)</h4>
          <p class="text-3xl font-bold text-green-700 dark:text-green-400 mt-1 font-mono">{yesCount}</p>
        </div>
        <div class="border border-hairline p-5 rounded-lg bg-canvas shadow-sm">
          <h4 class="text-[10px] font-mono uppercase tracking-wider text-mute">Helpfulness Ratio</h4>
          <p class="text-3xl font-bold text-link mt-1 font-mono">{ratio}%</p>
        </div>
      </div>

      {/* Feedbacks Table/List */}
      <div class="border border-hairline rounded-lg overflow-hidden bg-canvas shadow-sm">
        <div class="px-5 py-4 border-b border-hairline bg-canvas-soft flex items-center justify-between">
          <h3 class="text-xs font-mono uppercase tracking-wider text-mute font-semibold">Submission Log</h3>
        </div>
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-left text-xs">
            <thead class="bg-canvas-soft border-b border-hairline font-mono uppercase text-mute">
              <tr>
                <th class="px-5 py-3">Calculator</th>
                <th class="px-5 py-3">Rating</th>
                <th class="px-5 py-3">Date Submitted</th>
              </tr>
            </thead>
            <tbody id="feedback-tbody" class="divide-y divide-hairline text-body text-ink">
              { feedbacks.length === 0 ? (
                <tr>
                  <td colspan="3" class="px-5 py-8 text-center text-mute">No feedback submissions recorded on the server yet.</td>
                </tr>
              ) : (
                feedbacks.map((item) => {
                  const dateStr = new Date(item.timestamp).toLocaleString();
                  return (
                    <tr class="hover:bg-canvas-soft transition-colors text-ink">
                      <td class="px-5 py-3 font-semibold text-body">
                        <a href={item.url} class="hover:underline text-link">{item.name}</a>
                        <span class="text-[10px] font-mono text-mute block mt-0.5">{item.url}</span>
                        {item.message && (
                          <div class="mt-2 text-xs font-normal text-body bg-canvas-soft-2 p-2.5 rounded border border-hairline max-w-xl whitespace-pre-wrap">
                            💬 "{item.message}"
                          </div>
                        )}
                      </td>
                      <td class="px-5 py-3">
                        {item.rating === 'yes' ? (
                          <span class="px-2 py-0.5 bg-green-50 text-green-700 dark:bg-green-950/40 dark:text-green-400 border border-green-200 dark:border-green-900 rounded text-[10px] font-medium">👍 Helpful</span>
                        ) : (
                          <span class="px-2 py-0.5 bg-red-50 text-red-700 dark:bg-red-950/40 dark:text-red-400 border border-red-200 dark:border-red-900 rounded text-[10px] font-medium">👎 Not Helpful</span>
                        )}
                      </td>
                      <td class="px-5 py-3 font-mono text-mute">{dateStr}</td>
                    </tr>
                  )
                })
              )}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  )}
</Layout>
