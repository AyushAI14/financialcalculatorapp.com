---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import RangeSlider from '../../components/ui/RangeSlider.astro';
---

<CalculatorLayout 
  title="Loan Calculator" 
  description="Calculate monthly repayments, total interest, and compile complete amortization schedules for mortgages, auto loans, or personal loans."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Form Inputs (Left Column) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="loan-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4 border-b border-hairline pb-2">Loan Parameters</h3>

          <!-- Loan Amount -->
          <div class="space-y-2">
            <Input id="amount" label="Loan Amount" type="number" prefix="$" value="250000" />
            <RangeSlider id="amount-slider" label="Loan Amount Adjustment" min={5000} max={1000000} step={5000} value={250000} />
          </div>

          <!-- Interest Rate -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="rate" label="Annual Interest Rate" type="number" suffix="%" value="5.8" />
            <RangeSlider id="rate-slider" label="Interest Rate Adjustment" min={0.5} max={20} step={0.1} value={5.8} />
          </div>

          <!-- Loan Term -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="term" label="Loan Term" type="number" suffix="years" value="30" />
            <RangeSlider id="term-slider" label="Loan Term Adjustment" min={1} max={40} step={1} value={30} />
          </div>
        </div>

        <!-- Compounding and Pay Cadence -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5 bg-canvas-soft border border-hairline rounded-md">
          <Select id="frequency" label="Payment Cadence" options={[
            { value: '12', label: 'Monthly (12/year)' },
            { value: '26', label: 'Bi-Weekly (26/year)' },
            { value: '4', label: 'Quarterly (4/year)' },
            { value: '1', label: 'Annually (1/year)' }
          ]} value="12" />
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            Calculate Loan
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            Clear
          </button>
        </div>
      </form>
    </div>

    <!-- Results & Charts (Right Column) -->
    <div class="lg:col-span-6 space-y-6">
      <!-- 4-up Result Cards Grid -->
      <div class="flex flex-col gap-3">
        <div id="res-payment">
          <ResultCard title="Periodic Payment" value="$1,466.13" highlight={true} />
        </div>
        <div id="res-interest">
          <ResultCard title="Total Interest" value="$277,808.20" />
        </div>
        <div id="res-principal">
          <ResultCard title="Total Principal" value="$250,000.00" />
        </div>
        <div id="res-cost">
          <ResultCard title="Total Cost" value="$527,808.20" />
        </div>
      </div>

      <!-- Amortization Drawdown Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Amortization Drawdown Chart</h4>
        <div class="h-80 relative">
          <canvas id="amortization-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Amortization Schedule Table -->
  <div class="mt-12 border-t border-hairline pt-8">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-4">
      <div>
        <h3 class="text-xl font-semibold tracking-[-0.8px] text-ink">Amortization Schedule</h3>
        <p class="text-sm text-body mt-1">Detailed period-by-period progression showing starting balances, payment structures, and interest margins.</p>
      </div>
      <div class="flex items-center gap-3">
        <Select id="schedule-view" label="" options={[
          { value: 'yearly', label: 'Yearly Summary' },
          { value: 'monthly', label: 'Monthly Table' }
        ]} value="yearly" />
        
        <button 
          id="toggle-schedule" 
          class="px-4 py-2 border border-hairline rounded-md text-xs font-mono font-medium bg-canvas hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer whitespace-nowrap"
        >
          Show Amortization Table
        </button>
      </div>
    </div>

    <div id="schedule-wrapper" class="hidden border border-hairline rounded-lg overflow-hidden shadow-sm">
      <div class="overflow-x-auto max-h-[500px]">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="sticky top-0 bg-canvas-soft border-b border-hairline font-mono text-xs uppercase text-mute z-10">
            <tr>
              <th id="period-col" class="px-5 py-3">Year</th>
              <th class="px-5 py-3 text-right">Starting Bal</th>
              <th class="px-5 py-3 text-right">Total Payments</th>
              <th class="px-5 py-3 text-right">Principal Paid</th>
              <th class="px-5 py-3 text-right">Interest Paid</th>
              <th class="px-5 py-3 text-right">Ending Bal</th>
            </tr>
          </thead>
          <tbody id="schedule-body" class="divide-y divide-hairline">
            <!-- Populated dynamically -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Educational SEO Section -->
  <article class="mt-20 max-w-4xl prose prose-sm text-body leading-relaxed border-t border-hairline pt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink mb-3">Understanding Amortization.</h2>
      <p>
        Amortization is the process of spreading out a loan into a series of equal periodic payments. While each periodic payment is identical, the proportion of the payment going to **interest** vs. **principal** changes dynamically:
      </p>
      <ul class="list-disc pl-5 mt-2 space-y-1.5 text-sm">
        <li><strong>Early Periods</strong>: A larger percentage of your payment goes toward paying off the interest charged on the outstanding balance, meaning the principal decreases slowly.</li>
        <li><strong>Late Periods</strong>: As the outstanding principal is paid down, interest charges shrink, and a much larger percentage of your payment goes directly toward reducing the balance.</li>
      </ul>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">How Payments Are Structured</h3>
        <p class="text-sm">
          The monthly payment is calculated using the formula:
        </p>
        <div class="bg-canvas-soft border border-hairline p-4 rounded font-mono text-xs text-ink my-3">
          PMT = P * [r(1 + r)^n] / [(1 + r)^n - 1]
        </div>
        <p class="text-xs text-mute">
          Where <code class="bg-canvas-soft px-1 rounded font-mono">P</code> is the principal amount, <code class="bg-canvas-soft px-1 rounded font-mono">r</code> is the periodic interest rate (annual rate / frequency), and <code class="bg-canvas-soft px-1 rounded font-mono">n</code> is the total number of periods (years * frequency).
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">Ways to Save on Interest</h3>
        <p class="text-sm">
          You can reduce the total interest paid and pay off the loan years early by:
        </p>
        <ul class="list-disc pl-5 mt-2 space-y-1.5 text-xs text-mute">
          <li><strong>Making Extra Payments</strong>: Paying even small amounts of extra principal early reduces the balance on which future interest is calculated.</li>
          <li><strong>Choosing a Shorter Term</strong>: A 15-year mortgage has much lower total interest than a 30-year mortgage, although the monthly payment is higher.</li>
          <li><strong>Bi-weekly Payments</strong>: Making half-payments every two weeks results in 13 full payments per year instead of 12, cutting years off the term.</li>
        </ul>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-hairline pt-12 space-y-6">
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
      <div class="divide-y divide-hairline">
        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much loan can I qualify for?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              The loan amount you qualify for is determined by your debt-to-income (DTI) ratio, monthly income, credit score, and current interest rates. Lenders generally limit total monthly debt payments (including housing costs) to between 36% and 43% of your gross monthly income.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How long will it take to pay off my loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              By default, a loan is paid off at the end of its stated term (e.g. 5 years for an auto loan or 30 years for a mortgage). However, making extra principal payments, paying bi-weekly, or sending lump-sum payments will shorten your time to payoff.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much can I borrow with a personal loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Personal loan limits generally range from $1,000 to $100,000. The specific amount you can borrow is heavily dependent on your creditworthiness, income, and debt levels. Lenders evaluate these factors to ensure you can comfortably handle the monthly repayment obligation.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How can I pay off my car loan faster?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              You can pay off a car loan faster by rounding up your monthly payment, making bi-weekly payments, paying a large lump sum whenever possible, or refinancing to a shorter-term or lower-rate loan. Ensure your lender doesn't charge prepayment penalties.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much car loan can I get approved for?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Most financial experts recommend that your monthly auto loan payment should not exceed **10% of your gross monthly income** (or 15% of your net take-home pay). Lenders will approve larger amounts, but sticking to this limit protects your cash flow.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much home loan can I qualify for?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Under standard underwriting guidelines (the 28/36 rule), your monthly mortgage payment (PITI) should not exceed 28% of your gross income, and all monthly debt payments combined should not exceed 36%. Use our Home Affordability Calculator for a detailed analysis.
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>
</CalculatorLayout>

<script>
  import { generateAmortizationSchedule, calculateLoanPMT, compileYearlyAmortization } from '../../lib/math/loan';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('loan-form') as HTMLFormElement;
  
  const amountInput = document.getElementById('amount') as HTMLInputElement;
  const amountSlider = document.getElementById('amount-slider') as HTMLInputElement;
  
  const rateInput = document.getElementById('rate') as HTMLInputElement;
  const rateSlider = document.getElementById('rate-slider') as HTMLInputElement;
  
  const termInput = document.getElementById('term') as HTMLInputElement;
  const termSlider = document.getElementById('term-slider') as HTMLInputElement;

  const frequencySelect = document.getElementById('frequency') as HTMLSelectElement;

  const resPaymentCard = document.getElementById('res-payment');
  const resInterestCard = document.getElementById('res-interest');
  const resPrincipalCard = document.getElementById('res-principal');
  const resCostCard = document.getElementById('res-cost');

  const toggleScheduleBtn = document.getElementById('toggle-schedule');
  const scheduleViewSelect = document.getElementById('schedule-view') as HTMLSelectElement;
  const scheduleWrapper = document.getElementById('schedule-wrapper');
  const scheduleBody = document.getElementById('schedule-body');
  const periodColHeader = document.getElementById('period-col');

  let chartInstance: Chart | null = null;

  // Sync Input and Sliders
  function setupSyncedInputs(inp: HTMLInputElement, sli: HTMLInputElement) {
    sli.addEventListener('input', (e: any) => {
      inp.value = e.target.value;
      performCalculation();
    });
    inp.addEventListener('input', () => {
      const val = parseFloat(inp.value) || 0;
      sli.value = Math.min(Math.max(val, parseFloat(sli.min)), parseFloat(sli.max)).toString();
      const displayVal = document.getElementById(`${sli.id}-val`);
      if (displayVal) displayVal.textContent = sli.value;
      performCalculation();
    });
  }

  setupSyncedInputs(amountInput, amountSlider);
  setupSyncedInputs(rateInput, rateSlider);
  setupSyncedInputs(termInput, termSlider);

  // Perform Calculations
  function performCalculation() {
    const principal = Math.abs(parseFloat(amountInput.value)) || 0;
    const rate = (Math.abs(parseFloat(rateInput.value)) || 0) / 100;
    const years = Math.abs(parseInt(termInput.value)) || 1;
    const frequency = parseInt(frequencySelect.value) || 12;

    const pmt = calculateLoanPMT({ principal, rate, years, compoundingFrequency: frequency });
    const schedule = generateAmortizationSchedule({ principal, rate, years, compoundingFrequency: frequency });

    const totalCost = pmt * (years * frequency);
    const totalInterest = Math.max(0, totalCost - principal);

    // Update Result Display
    if (resPaymentCard) resPaymentCard.querySelector('.font-mono')!.textContent = formatCurrency(pmt);
    if (resInterestCard) resInterestCard.querySelector('.font-mono')!.textContent = formatCurrency(totalInterest);
    if (resPrincipalCard) resPrincipalCard.querySelector('.font-mono')!.textContent = formatCurrency(principal);
    if (resCostCard) resCostCard.querySelector('.font-mono')!.textContent = formatCurrency(totalCost);

    // Update Chart
    updateChart(schedule, frequency);
    // Update Schedule Table
    updateScheduleTable(schedule);
  }

  function updateChart(schedule: any[], frequency: number) {
    const canvas = document.getElementById('amortization-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // To prevent rendering too many points for long loans, we filter points
    const step = Math.max(1, Math.floor(schedule.length / 100));
    const filteredPoints = schedule.filter((_, idx) => idx % step === 0);

    const labels = filteredPoints.map(e => {
      const periodInYears = (e.period / frequency).toFixed(1);
      return `Yr ${periodInYears}`;
    });
    
    const balances = filteredPoints.map(e => e.endingBalance);
    
    // Accumulate total interest paid
    let cumInterest = 0;
    const interestData = filteredPoints.map(e => {
      // Find index range and sum interest for exact tracking
      // But for simple visualization, we can just track cumulative interest
      return schedule.slice(0, e.period).reduce((sum, item) => sum + item.interest, 0);
    });

    if (chartInstance) {
      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = balances;
      chartInstance.data.datasets[1].data = interestData;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Remaining Principal',
              data: balances,
              borderColor: '#171717',
              backgroundColor: 'rgba(23, 23, 23, 0.05)',
              fill: true,
              tension: 0.1,
              borderWidth: 2,
              pointRadius: 0
            },
            {
              label: 'Cumulative Interest Paid',
              data: interestData,
              borderColor: '#0070f3',
              backgroundColor: 'rgba(0, 112, 243, 0.02)',
              fill: true,
              tension: 0.1,
              borderWidth: 1.5,
              pointRadius: 0
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 8,
                padding: 12,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { maxTicksLimit: 10, font: { family: 'Geist Mono, monospace', size: 9 } }
            },
            y: {
              grid: { color: '#ebebeb' },
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
                }
              }
            }
          }
        }
      });
    }
  }

  function updateScheduleTable(schedule: any[]) {
    if (!scheduleBody) return;
    const viewMode = scheduleViewSelect.value;
    
    let html = '';
    
    if (viewMode === 'yearly') {
      if (periodColHeader) periodColHeader.textContent = 'Year';
      const yearlySummary = compileYearlyAmortization(schedule);
      
      yearlySummary.forEach(e => {
        html += `
          <tr class="hover:bg-canvas-soft transition-colors font-mono text-xs text-ink">
            <td class="px-5 py-3 font-semibold text-body">Year ${e.year}</td>
            <td class="px-5 py-3 text-right">${formatCurrency(e.startingBalance)}</td>
            <td class="px-5 py-3 text-right">${formatCurrency(e.totalPayments)}</td>
            <td class="px-5 py-3 text-right text-link">${formatCurrency(e.principal)}</td>
            <td class="px-5 py-3 text-right text-error-deep">${formatCurrency(e.interest)}</td>
            <td class="px-5 py-3 text-right font-medium">${formatCurrency(e.endingBalance)}</td>
          </tr>
        `;
      });
    } else {
      if (periodColHeader) periodColHeader.textContent = 'Month / Period';
      
      // Limit monthly rendering to first 360 periods to avoid DOM slow downs
      const truncated = schedule.slice(0, 360);
      
      truncated.forEach(e => {
        html += `
          <tr class="hover:bg-canvas-soft transition-colors font-mono text-xs text-ink">
            <td class="px-5 py-3 font-semibold text-body">Month ${e.period}</td>
            <td class="px-5 py-3 text-right">${formatCurrency(e.startingBalance)}</td>
            <td class="px-5 py-3 text-right">${formatCurrency(e.payment)}</td>
            <td class="px-5 py-3 text-right text-link">${formatCurrency(e.principal)}</td>
            <td class="px-5 py-3 text-right text-error-deep">${formatCurrency(e.interest)}</td>
            <td class="px-5 py-3 text-right font-medium">${formatCurrency(e.endingBalance)}</td>
          </tr>
        `;
      });

      if (schedule.length > 360) {
        html += `
          <tr class="bg-canvas-soft-2 font-mono text-xs text-mute">
            <td colspan="6" class="px-5 py-3 text-center">
              Showing first 360 months of ${schedule.length} months. Select "Yearly Summary" to view the entire schedule.
            </td>
          </tr>
        `;
      }
    }

    scheduleBody.innerHTML = html;
  }

  // Listeners
  frequencySelect.addEventListener('change', performCalculation);
  scheduleViewSelect.addEventListener('change', () => {
    performCalculation();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  if (toggleScheduleBtn && scheduleWrapper) {
    toggleScheduleBtn.addEventListener('click', () => {
      const isHidden = scheduleWrapper.classList.contains('hidden');
      if (isHidden) {
        scheduleWrapper.classList.remove('hidden');
        toggleScheduleBtn.textContent = 'Hide Amortization Table';
      } else {
        scheduleWrapper.classList.add('hidden');
        toggleScheduleBtn.textContent = 'Show Amortization Table';
      }
    });
  }

  // Initial Calculation
  performCalculation();
</script>
