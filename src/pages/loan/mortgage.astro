---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);

const faqs = [
  {
    question: "How is a mortgage payment calculated?",
    answer: "A standard monthly mortgage payment consists of Principal & Interest (P&I), property taxes, homeowners insurance, private mortgage insurance (PMI) if down payment is under 20%, and homeowner association (HOA) fees. For the complete mathematical formula and a comparison with reverse mortgages, read our comprehensive guide: <a href=\"/blog/what-is-a-reverse-mortgage-how-it-works/\" class=\"text-primary underline font-medium\">What is a Reverse Mortgage & How Payments Work</a>."
  },
  {
    question: "What is PMI and when do I pay it?",
    answer: "Private Mortgage Insurance (PMI) is a policy that protects the lender if you default. It is typically required on conventional loans if your down payment is less than 20% of the home purchase price."
  },
  {
    question: "What does PITI stand for?",
    answer: "PITI stands for Principal, Interest, Taxes, and Insurance. These are the four basic components that make up a homeowner's monthly housing payment. Together, they reflect the true cost of owning a home on a month-to-month basis."
  },
  {
    question: "Is a 15-year mortgage better than a 30-year mortgage?",
    answer: "A 15-year mortgage typically offers a lower interest rate and allows you to pay off your home twice as fast, saving you tens of thousands of dollars in interest. However, a 30-year mortgage has lower monthly payments, which provides greater cash flow flexibility and makes the home more affordable on a month-to-month basis."
  },
  {
    question: "How do extra payments affect my mortgage payoff schedule?",
    answer: "Any extra money you pay towards your mortgage is applied directly to the principal balance. This reduces the remaining loan balance and decreases the amount of interest that accumulates, helping you pay off your mortgage years ahead of schedule and saving you a substantial amount in interest fees."
  }
];
---

<CalculatorLayout 
  title="Mortgage Calculator" 
  seoTitle="Mortgage Calculator: Estimate Monthly Payments & PMI"
  description="Calculate your monthly mortgage payment including principal, interest, taxes, home insurance, and PMI. View full amortization breakdown for free."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="mortgage-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-2 mb-4">
            <h3 class="text-xs font-mono text-mute uppercase tracking-wider">{t('Property & Loan Details')}</h3>
            <div class="flex flex-wrap items-center gap-1.5 no-print">
              <span class="text-[10px] text-mute font-mono">{t('Presets:')}</span>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-price="400000" data-down="80000" data-rate="6.5" data-term="30" data-tax="1.2" data-ins="1500" data-pmi="0.7" data-hoa="150">{t('Starter Home')}</button>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-price="800000" data-down="100000" data-rate="6.2" data-term="30" data-tax="1.5" data-ins="2400" data-pmi="0.85" data-hoa="0">{t('Large Family')}</button>
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="home-price" label="Home Purchase Price" type="number" prefix="$" value="400000" placeholder="0.00" tooltip="The total purchase price of the home." />
            <Input id="down-payment" label="Down Payment Amount" type="number" prefix="$" value="80000" placeholder="0.00" tooltip="The cash amount paid upfront. 20% or more removes PMI." />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-4 border-t border-hairline/60">
            <Input id="interest-rate" label="Annual Interest Rate" type="number" suffix="%" value="6.5" placeholder="0.00" tooltip="The annual nominal interest rate of the mortgage." />
            <Input id="term" label="Loan Term" type="number" suffix="years" value="30" placeholder="30" tooltip="The duration of the mortgage in years (usually 15 or 30)." />
          </div>

          <h3 class="text-xs font-mono text-mute uppercase tracking-wider pt-4 border-t border-hairline pb-2 mb-2">{t('Taxes, Fees & Insurance')}</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="tax-rate" label="Property Tax Rate" type="number" suffix="%" value="1.2" placeholder="1.2" tooltip="The annual property tax percentage of the home value." />
            <Input id="insurance" label="Homeowners Insurance" type="number" prefix="$" value="1500" placeholder="0.00" tooltip="The estimated annual cost of homeowners insurance." />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-4 border-t border-hairline/60">
            <Input id="pmi-rate" label="PMI Rate (Annual)" type="number" suffix="%" value="0.7" placeholder="0.7" tooltip="Private Mortgage Insurance rate. Applies if down payment is < 20%." />
            <Input id="hoa" label="HOA Fees" type="number" prefix="$" value="150" placeholder="0.00" suffix="/mo" tooltip="Monthly Homeowner Association fees, if applicable." />
          </div>
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Mortgage')}
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Charts) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-total-monthly">
          <ResultCard title="Total Monthly Payment" value="--" highlight={true} description="Total payment including mortgage principal, interest, taxes, insurance, and HOA." />
        </div>
        <div id="res-pi">
          <ResultCard title="Principal & Interest" value="--" description="Base monthly loan payment." />
        </div>
        <div id="res-loan-amount">
          <ResultCard title="Total Loan Amount" value="--" description="Home price minus your down payment." />
        </div>
      </div>

      <div id="mortgage-takeaway" class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm font-medium text-xs leading-relaxed text-ink hidden">
      </div>

      <!-- Payment Breakdown Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">{t('Monthly Payment Breakdown')}</h4>
        <div class="h-64 relative">
          <canvas id="mortgage-chart"></canvas>
        </div>
      </div>

      <!-- Formulas Display -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm no-print">
        <details class="group">
          <summary class="flex items-center justify-between text-xs font-mono text-mute uppercase tracking-wider cursor-pointer select-none">
            <span>{t('Formula Breakdown')}</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-4 text-xs text-body space-y-4 pt-3 border-t border-hairline">
            <div>
              <p class="font-semibold text-ink mb-1">1. Base Payment (Principal + Interest)</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-pi-formula">
                P&I = LoanAmount × [r(1+r)^n] / [(1+r)^n - 1]
              </code>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">2. Monthly Tax & Insurance</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-tax-ins">
                Tax = (HomePrice × TaxRate) / 12
              </code>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">3. Monthly Private Mortgage Insurance (PMI)</p>
              <p class="mb-1">Required if down payment is less than 20% of purchase price.</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-pmi">
                PMI = (LoanAmount × PMIRate) / 12
              </code>
            </div>
          </div>
        </details>
      </div>

      <!-- Export CSV -->
      <div class="flex gap-4 no-print">
        <button id="download-csv-btn" class="w-full py-2.5 bg-canvas hover:bg-canvas-soft border border-hairline text-ink rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 cursor-pointer shadow-sm transition-colors">
          <span>📊</span> {t('Download Results CSV')}
        </button>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateLoanPMT } from '../../lib/math/loan';
  import { formatCurrency, formatPercentage } from '../../lib/utils';
  import { validateForm, validateField } from '../../lib/validation';
  import { syncInputsWithURL } from '../../lib/shareable';
  import { downloadDataAsCSV } from '../../lib/csv-exporter';
  import type { Chart } from 'chart.js';
  import { enhanceChartCanvas } from '../../lib/chart-canvas-actions';
  enhanceChartCanvas('mortgage-chart');

  let ChartClass: any = null;
  async function getChartClass() {
    if (!ChartClass) {
      const module = await import('chart.js/auto');
      ChartClass = module.default;
    }
    return ChartClass;
  }

  // DOM Elements
  const form = document.getElementById('mortgage-form') as HTMLFormElement;
  
  const priceInput = document.getElementById('home-price') as HTMLInputElement;
  const downInput = document.getElementById('down-payment') as HTMLInputElement;
  const rateInput = document.getElementById('interest-rate') as HTMLInputElement;
  const termInput = document.getElementById('term') as HTMLInputElement;
  const taxInput = document.getElementById('tax-rate') as HTMLInputElement;
  const insInput = document.getElementById('insurance') as HTMLInputElement;
  const pmiInput = document.getElementById('pmi-rate') as HTMLInputElement;
  const hoaInput = document.getElementById('hoa') as HTMLInputElement;

  const resTotalMonthly = document.getElementById('res-total-monthly');
  const resPI = document.getElementById('res-pi');
  const resLoanAmount = document.getElementById('res-loan-amount');

  let chartInstance: Chart | null = null;

  const validationRules = {
    'home-price': { required: true, min: 1 },
    'down-payment': { 
      required: true, 
      min: 0, 
      custom: (val: number) => {
        const price = parseFloat(priceInput.value) || 0;
        return val >= price ? 'Down payment must be less than home purchase price.' : null;
      }
    },
    'interest-rate': { required: true, min: 0, max: 100 },
    'term': { required: true, min: 1, max: 100, integer: true },
    'tax-rate': { required: true, min: 0, max: 100 },
    'insurance': { required: true, min: 0 },
    'pmi-rate': { required: true, min: 0, max: 100 },
    'hoa': { required: true, min: 0 }
  };

  function performCalculation() {
    const stepPIFormula = document.getElementById('step-pi-formula');
    const stepTaxIns = document.getElementById('step-tax-ins');
    const stepPMI = document.getElementById('step-pmi');

    if (!validateForm(validationRules)) {
      if (resTotalMonthly) resTotalMonthly.querySelector('.font-mono')!.textContent = '--';
      if (resPI) resPI.querySelector('.font-mono')!.textContent = '--';
      if (resLoanAmount) resLoanAmount.querySelector('.font-mono')!.textContent = '--';
      
      if (stepPIFormula) stepPIFormula.innerHTML = 'Enter valid inputs to view formulas.';
      if (stepTaxIns) stepTaxIns.innerHTML = 'Enter valid inputs to view formulas.';
      if (stepPMI) stepPMI.innerHTML = 'Enter valid inputs to view formulas.';
      return;
    }

    const price = parseFloat(priceInput.value);
    const down = parseFloat(downInput.value);
    const rate = parseFloat(rateInput.value) / 100;
    const termYears = parseInt(termInput.value);
    const taxRate = parseFloat(taxInput.value) / 100;
    const insuranceAnnual = parseFloat(insInput.value);
    const pmiRate = parseFloat(pmiInput.value) / 100;
    const hoaMonthly = parseFloat(hoaInput.value);

    const loanAmount = Math.max(0, price - down);
    const pmtPI = calculateLoanPMT({ principal: loanAmount, rate, years: termYears });
    
    // Taxes
    const taxMonthly = (price * taxRate) / 12;
    // Insurance
    const insuranceMonthly = insuranceAnnual / 12;
    // PMI: conventionally required if downpayment is less than 20% of home price
    const pmiRequired = down < (price * 0.20 - 1e-6);
    const pmiMonthly = pmiRequired ? (loanAmount * pmiRate) / 12 : 0;
    
    const totalMonthly = pmtPI + taxMonthly + insuranceMonthly + pmiMonthly + hoaMonthly;

    // Format
    const formattedTotal = formatCurrency(totalMonthly);
    const formattedPI = formatCurrency(pmtPI);
    const formattedLoan = formatCurrency(loanAmount);

    // Update UI
    if (resTotalMonthly) resTotalMonthly.querySelector('.font-mono')!.textContent = formattedTotal;
    if (resPI) resPI.querySelector('.font-mono')!.textContent = formattedPI;
    if (resLoanAmount) resLoanAmount.querySelector('.font-mono')!.textContent = formattedLoan;

    const takeawayEl = document.getElementById('mortgage-takeaway');
    if (takeawayEl) {
      takeawayEl.classList.remove('hidden');
      const totalCost = totalMonthly * termYears * 12;
      const minIncome = (totalMonthly / 0.28) * 12;
      takeawayEl.innerHTML = `
        <span class="text-link">📢 Takeaway:</span> Over the ${termYears}-year term, you will pay a total of <strong class="text-ink">${formatCurrency(totalCost)}</strong> across all mortgage components. To comfortably afford this payment under the standard 28% housing rule of thumb, an annual gross household income of at least <strong class="text-link">${formatCurrency(minIncome)}</strong> is recommended.
      `;
    }

    // Formulas
    if (stepPIFormula) {
      if (rate === 0) {
        stepPIFormula.innerHTML = `P&I = ${formatCurrency(loanAmount)} / ${termYears * 12} periods<br/><strong>P&I = ${formattedPI} / mo</strong>`;
      } else {
        stepPIFormula.innerHTML = `P&I = ${formatCurrency(loanAmount)} × [${(rate/12).toFixed(6)} × (1 + ${(rate/12).toFixed(6)})^${termYears*12}] / [(1 + ${(rate/12).toFixed(6)})^${termYears*12} - 1]<br/><strong>P&I = ${formattedPI} / mo</strong>`;
      }
    }
    if (stepTaxIns) {
      stepTaxIns.innerHTML = `Tax = (${formatCurrency(price)} × ${formatPercentage(taxRate)}) / 12 = <strong>${formatCurrency(taxMonthly)} / mo</strong><br/>Insurance = ${formatCurrency(insuranceAnnual)} / 12 = <strong>${formatCurrency(insuranceMonthly)} / mo</strong>`;
    }
    if (stepPMI) {
      if (pmiRequired) {
        stepPMI.innerHTML = `Down payment (${formatCurrency(down)}) is less than 20% of purchase price (${formatCurrency(price * 0.2)}). PMI applies:<br/>PMI = (${formatCurrency(loanAmount)} × ${formatPercentage(pmiRate)}) / 12 = <strong>${formatCurrency(pmiMonthly)} / mo</strong>`;
      } else {
        stepPMI.innerHTML = `Down payment (${formatCurrency(down)}) is at least 20% of purchase price (${formatCurrency(price * 0.2)}). PMI is waived (<strong>${formatCurrency(0)}</strong>).`;
      }
    }

    // Update Chart
    updateChart(pmtPI, taxMonthly, insuranceMonthly, pmiMonthly, hoaMonthly);
  }

  async function updateChart(pi: number, tax: number, ins: number, pmi: number, hoa: number) {
    const canvas = document.getElementById('mortgage-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const Chart = await getChartClass();

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [pi, tax, ins, pmi, hoa];
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Principal & Interest', 'Property Tax', 'Insurance', 'PMI', 'HOA'],
          datasets: [
            {
              data: [pi, tax, ins, pmi, hoa],
              backgroundColor: ['#3b82f6', '#f59e0b', '#10b981', '#f43f5e', '#8b5cf6'],
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              position: 'right',
              labels: {
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            }
          }
        }
      });
    }
  }

  // Bind input listeners
  [priceInput, downInput, rateInput, termInput, taxInput, insInput, pmiInput, hoaInput].forEach(el => {
    el.addEventListener('input', () => {
      validateField(el.id, validationRules[el.id as keyof typeof validationRules]);
    });
  });

  // Preset scenarios click handlers
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      priceInput.value = target.dataset.price || '0';
      downInput.value = target.dataset.down || '0';
      rateInput.value = target.dataset.rate || '0';
      termInput.value = target.dataset.term || '0';
      taxInput.value = target.dataset.tax || '0';
      insInput.value = target.dataset.ins || '0';
      pmiInput.value = target.dataset.pmi || '0';
      hoaInput.value = target.dataset.hoa || '0';
      
      [priceInput, downInput, rateInput, termInput, taxInput, insInput, pmiInput, hoaInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });
    });
  });

  // CSV Export handler
  const downloadCsvBtn = document.getElementById('download-csv-btn');
  downloadCsvBtn?.addEventListener('click', () => {
    if (!validateForm(validationRules)) return;
    const price = parseFloat(priceInput.value);
    const down = parseFloat(downInput.value);
    const rate = parseFloat(rateInput.value) / 100;
    const termYears = parseInt(termInput.value);
    const taxRate = parseFloat(taxInput.value) / 100;
    const insuranceAnnual = parseFloat(insInput.value);
    const pmiRate = parseFloat(pmiInput.value) / 100;
    const hoaMonthly = parseFloat(hoaInput.value);

    const loanAmount = Math.max(0, price - down);
    const pmtPI = calculateLoanPMT({ principal: loanAmount, rate, years: termYears });
    const taxMonthly = (price * taxRate) / 12;
    const insuranceMonthly = insuranceAnnual / 12;
    const pmiMonthly = down < (price * 0.20) ? (loanAmount * pmiRate) / 12 : 0;
    const totalMonthly = pmtPI + taxMonthly + insuranceMonthly + pmiMonthly + hoaMonthly;

    const headers = ['Monthly Cost Category', 'Value'];
    const rows = [
      ['Home Purchase Price', formatCurrency(price)],
      ['Down Payment', formatCurrency(down)],
      ['Mortgage Principal (Loan Amount)', formatCurrency(loanAmount)],
      ['Principal & Interest (Base P&I)', formatCurrency(pmtPI)],
      ['Property Taxes', formatCurrency(taxMonthly)],
      ['Homeowners Insurance', formatCurrency(insuranceMonthly)],
      ['Private Mortgage Insurance (PMI)', formatCurrency(pmiMonthly)],
      ['HOA Fees', formatCurrency(hoaMonthly)],
      ['TOTAL MONTHLY PAYMENT', formatCurrency(totalMonthly)]
    ];

    downloadDataAsCSV(headers, rows, 'mortgage-calculation.csv');
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(() => {
      [priceInput, downInput, rateInput, termInput, taxInput, insInput, pmiInput, hoaInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });
      if (resTotalMonthly) resTotalMonthly.querySelector('.font-mono')!.textContent = '--';
      if (resPI) resPI.querySelector('.font-mono')!.textContent = '--';
      if (resLoanAmount) resLoanAmount.querySelector('.font-mono')!.textContent = '--';
      const takeawayEl = document.getElementById('mortgage-takeaway');
      if (takeawayEl) takeawayEl.classList.add('hidden');
      if (chartInstance) {
        chartInstance.destroy();
        chartInstance = null;
      }
    }, 0);
  });

  // Initialize sync
  syncInputsWithURL('mortgage-form', performCalculation);

  // Currency select change listener
  window.addEventListener('currency-change', () => {
    if (resTotalMonthly && resTotalMonthly.querySelector('.font-mono')?.textContent !== '--') {
      performCalculation();
    }
  });
</script>
