---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('rent-vs-buy');
---

<CalculatorLayout 
  title="Rent vs Buy Calculator" 
  description="Compare the long-term wealth impact of buying a home versus renting and investing the difference over a 10 to 30 year horizon."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="rent-vs-buy-form" class="space-y-6">
        <!-- Renter Settings -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">{t('Renter Parameters', 'Rental Assumptions')}</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <Input id="rent" label="Monthly Rent" type="number" prefix="$" value="1800" />
            <Input id="rent-inflation" label="Rent Inflation" type="number" suffix="%" value="3.0" />
            <Input id="portfolio-return" label="Portfolio Return" type="number" suffix="%" value="7.5" />
          </div>
        </div>

        <!-- Buyer Settings -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">{t('Buyer Parameters', 'Home Purchase Details')}</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-2">
              <Input id="home-price" label="Home Purchase Price" type="number" prefix="$" value="380000" />
            </div>
            <Input id="downpayment" label="Down Payment" type="number" prefix="$" value="76000" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 border-t border-hairline/60">
            <Input id="rate" label="Mortgage Rate" type="number" suffix="%" value="5.5" />
            <Input id="term" label="Loan Term" type="number" suffix="years" value="30" />
            <Input id="appreciation" label="Appreciation" type="number" suffix="%" value="4.0" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2 border-t border-hairline/60">
            <Input id="tax-rate" label="Property Tax Rate" type="number" suffix="%" value="1.2" />
            <Input id="insurance" label="Annual Insurance" type="number" prefix="$" value="1200" />
            <Input id="maintenance" label="Annual Maintenance" type="number" suffix="%" value="1.0" />
          </div>
        </div>

        <!-- General Parameters -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5 bg-canvas-soft border border-hairline rounded-md">
          <Input id="duration" label="Comparison Horizon" type="number" suffix="years" value="15" />
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <Input id="buy-fees" label="Buying Cost" type="number" suffix="%" value="2.0" />
            <Input id="sell-fees" label="Selling Cost" type="number" suffix="%" value="6.0" />
          </div>
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Run Comparison')}
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Charts) -->
    <div class="lg:col-span-6 space-y-6">
      <!-- Result Cards -->
      <div class="flex flex-col gap-3">
        <div id="res-winner">
          <ResultCard title="Financial Winner" value="--" highlight={true} description="Submit form to compare buying vs renting." />
        </div>
        <div id="res-buyer-nw">
          <ResultCard title="Buyer Net Worth" value="--" />
        </div>
        <div id="res-renter-nw">
          <ResultCard title="Renter Net Worth" value="--" />
        </div>
      </div>

      <!-- Net Worth Chart Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Net Worth Projection over Time</h4>
        <div class="h-80 relative">
          <canvas id="nw-chart"></canvas>
        </div>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { simulateRentVsBuy } from '../../lib/math/loan';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('rent-vs-buy-form') as HTMLFormElement;
  
  const rentInput = document.getElementById('rent') as HTMLInputElement;
  const rentInflationInput = document.getElementById('rent-inflation') as HTMLInputElement;
  const portfolioReturnInput = document.getElementById('portfolio-return') as HTMLInputElement;
  
  const homePriceInput = document.getElementById('home-price') as HTMLInputElement;
  const downpaymentInput = document.getElementById('downpayment') as HTMLInputElement;
  const rateInput = document.getElementById('rate') as HTMLInputElement;
  const termInput = document.getElementById('term') as HTMLInputElement;
  const appreciationInput = document.getElementById('appreciation') as HTMLInputElement;
  
  const taxRateInput = document.getElementById('tax-rate') as HTMLInputElement;
  const insuranceInput = document.getElementById('insurance') as HTMLInputElement;
  const maintenanceInput = document.getElementById('maintenance') as HTMLInputElement;
  
  const durationInput = document.getElementById('duration') as HTMLInputElement;
  const buyFeesInput = document.getElementById('buy-fees') as HTMLInputElement;
  const sellFeesInput = document.getElementById('sell-fees') as HTMLInputElement;

  const resWinnerCard = document.getElementById('res-winner');
  const resBuyerCard = document.getElementById('res-buyer-nw');
  const resRenterCard = document.getElementById('res-renter-nw');

  let chartInstance: Chart | null = null;

  // Run simulation
  function performCalculation() {
    const monthlyRent = parseFloat(rentInput.value) || 0;
    const rentInflation = (parseFloat(rentInflationInput.value) || 0) / 100;
    const renterInvestmentReturn = (parseFloat(portfolioReturnInput.value) || 0) / 100;
    
    const homePrice = parseFloat(homePriceInput.value) || 0;
    const downPayment = parseFloat(downpaymentInput.value) || 0;
    const mortgageRate = (parseFloat(rateInput.value) || 0) / 100;
    const mortgageTermYears = parseInt(termInput.value) || 30;
    const appreciationRate = (parseFloat(appreciationInput.value) || 0) / 100;
    
    const propertyTaxRate = (parseFloat(taxRateInput.value) || 0) / 100;
    const insuranceAnnual = parseFloat(insuranceInput.value) || 0;
    const maintenanceRate = (parseFloat(maintenanceInput.value) || 0) / 100;
    
    const simulationYears = parseInt(durationInput.value) || 15;
    const buyingFeesRate = (parseFloat(buyFeesInput.value) || 0) / 100;
    const sellingFeesRate = (parseFloat(sellFeesInput.value) || 0) / 100;

    const schedule = simulateRentVsBuy({
      monthlyRent, rentInflation, renterInvestmentReturn,
      homePrice, downPayment, mortgageRate, mortgageTermYears,
      propertyTaxRate, insuranceAnnual, maintenanceRate, appreciationRate,
      buyingFeesRate, sellingFeesRate, simulationYears
    });

    if (!schedule || schedule.length === 0) return;
    const finalYear = schedule[schedule.length - 1];

    const buyerNw = finalYear.buyerNetWorth;
    const renterNw = finalYear.renterPortfolioValue;

    // Determine winner
    let winner = 'Renting';
    let diff = Math.abs(buyerNw - renterNw);
    let desc = '';
    
    if (buyerNw > renterNw) {
      winner = 'Buying';
      desc = `Buying is better by ${formatCurrency(diff)} in net worth.`;
    } else {
      winner = 'Renting';
      desc = `Renting is better by ${formatCurrency(diff)} in net worth.`;
    }

    // Update Result Cards
    if (resWinnerCard) {
      resWinnerCard.querySelector('.font-mono')!.textContent = winner;
      resWinnerCard.querySelector('p')!.textContent = desc;
    }
    if (resBuyerCard) resBuyerCard.querySelector('.font-mono')!.textContent = formatCurrency(buyerNw);
    if (resRenterCard) resRenterCard.querySelector('.font-mono')!.textContent = formatCurrency(renterNw);

    // Update Chart
    updateChart(schedule);
  }

  function updateChart(schedule: any[]) {
    const canvas = document.getElementById('nw-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const labels = schedule.map(e => `Yr ${e.year}`);
    const buyerNwData = schedule.map(e => e.buyerNetWorth);
    const renterNwData = schedule.map(e => e.renterPortfolioValue);

    if (chartInstance) {
      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = buyerNwData;
      chartInstance.data.datasets[1].data = renterNwData;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Buyer Net Worth',
              data: buyerNwData,
              borderColor: '#10b981',
              fill: false,
              tension: 0.1,
              borderWidth: 2,
              pointRadius: 3
            },
            {
              label: 'Renter Net Worth',
              data: renterNwData,
              borderColor: '#3b82f6',
              fill: false,
              tension: 0.1,
              borderWidth: 2,
              pointRadius: 3
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 10,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { font: { family: 'Geist Mono, monospace', size: 9 } }
            },
            y: {
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
                }
              }
            }
          }
        }
      });
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(() => {
      if (resWinnerCard) {
        resWinnerCard.querySelector('.font-mono')!.textContent = '--';
        const pEl = resWinnerCard.querySelector('p');
        if (pEl) pEl.textContent = 'Submit form to compare buying vs renting.';
      }
      if (resBuyerCard) resBuyerCard.querySelector('.font-mono')!.textContent = '--';
      if (resRenterCard) resRenterCard.querySelector('.font-mono')!.textContent = '--';
      if (chartInstance) {
        chartInstance.destroy();
        chartInstance = null;
      }
    }, 0);
  });

  // Listen for currency changes
  window.addEventListener('currency-change', () => {
    if (resBuyerCard && resBuyerCard.querySelector('.font-mono')?.textContent !== '--') {
      performCalculation();
    }
  });
</script>
