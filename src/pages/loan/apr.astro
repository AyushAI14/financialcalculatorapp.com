---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
---

<CalculatorLayout 
  title="APR Calculator" 
  description="Calculate the true Annual Percentage Rate (APR) of your loan by factoring in interest rates, term lengths, and upfront finance charges or broker fees."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="apr-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-2 mb-4">
            <h3 class="text-xs font-mono text-mute uppercase tracking-wider">Loan Details</h3>
            <div class="flex flex-wrap items-center gap-1.5 no-print">
              <span class="text-[10px] text-mute font-mono">Presets:</span>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-amount="30000" data-rate="7.5" data-term="5" data-fees="500">Auto Loan</button>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-amount="350000" data-rate="6.5" data-term="30" data-fees="6000">Mortgage</button>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="loan-amount" label="Loan Principal Amount" type="number" prefix="$" value="200000" placeholder="0.00" tooltip="The total amount of money borrowed before fees and interest." />
            <Input id="interest-rate" label="Nominal Interest Rate" type="number" suffix="%" value="6.0" placeholder="0.00" tooltip="The base annual interest rate of the loan, excluding fees." />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-4 border-t border-hairline/60">
            <Input id="term" label="Loan Term" type="number" suffix="years" value="30" placeholder="30" tooltip="The duration of the loan in years until it is fully paid off." />
            <Input id="fees" label="Upfront Fees & Closing Costs" type="number" prefix="$" value="4000" placeholder="0.00" tooltip="Closing costs, broker fees, points, and other lender charges to include in the APR." />
          </div>
        </div>

        <div class="p-5 bg-canvas-soft border border-hairline rounded-md text-xs text-body leading-relaxed space-y-2">
          <p class="font-semibold text-ink">What fees should be included in APR?</p>
          <p>
            Standard APR fees include: loan origination fees, points, underwriting charges, document prep fees, private mortgage insurance (PMI), and broker fees. 
          </p>
          <p class="text-mute">
            *Do not include appraisal fees, title insurance, attorney fees, or notary costs, as these are typically third-party costs and not direct costs of credit.
          </p>
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            Calculate APR
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            Clear
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Visual Chart) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-apr">
          <ResultCard 
            title="Effective APR" 
            value="6.19%" 
            highlight={true} 
            description="The real interest rate you pay annually once upfront fees are included."
          />
        </div>
        <div id="res-nominal">
          <ResultCard 
            title="Interest Rate" 
            value="6.00%" 
            description="The base interest rate stated on your loan note."
          />
        </div>
        <div id="res-payment">
          <ResultCard 
            title="Monthly Payment (P&I)" 
            value="$1,199.10" 
          />
        </div>
        <div id="res-fees">
          <ResultCard 
            title="Total Finance Fees" 
            value="$4,000.00" 
          />
        </div>
      </div>

      <!-- Comparison Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Rate vs. APR Comparison</h4>
        <div class="h-56 relative">
          <canvas id="apr-chart"></canvas>
        </div>
      </div>

      <!-- Formula Transparency & Step-by-Step Details -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm no-print">
        <details class="group">
          <summary class="flex items-center justify-between text-xs font-mono text-mute uppercase tracking-wider cursor-pointer select-none">
            <span>Calculation Steps & Formulas</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-4 text-xs text-body space-y-4 pt-3 border-t border-hairline">
            <div>
              <p class="font-semibold text-ink mb-1">1. Base Monthly Payment (P&I)</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-base-formula">
                PMT = Principal × [r(1 + r)^n] / [(1 + r)^n - 1]
              </code>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">2. Adjusted Net Loan Balance</p>
              <p class="mb-1 leading-relaxed">Fees are deducted from the principal to find the actual net money received by the borrower.</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-net-loan">
                Net Principal = Principal - Fees
              </code>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">3. Solving for APR (r_apr)</p>
              <p class="mb-1 leading-relaxed">The APR is the interest rate that equates the Net Principal with the base monthly payments (P&I) over the loan term.</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words" id="step-solve-apr">
                Net Principal = PMT × [1 - (1 + r_apr)^-n] / r_apr
              </code>
            </div>
          </div>
        </details>
      </div>

      <!-- CSV Export Trigger -->
      <div class="flex gap-4 no-print">
        <button id="download-csv-btn" class="w-full py-2.5 bg-canvas hover:bg-canvas-soft border border-hairline text-ink rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 cursor-pointer shadow-sm transition-colors">
          <span>📊</span> Download Results CSV
        </button>
      </div>
    </div>
  </div>

  <!-- Educational SEO Section -->
  <article class="mt-20 max-w-4xl prose prose-sm text-body leading-relaxed border-t border-hairline pt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink mb-3">Understanding the Difference between APR and Interest Rate.</h2>
      <p>
        When shopping for a mortgage or loan, you will see two rates advertised: the **interest rate** and the **Annual Percentage Rate (APR)**. Understanding the distinction is vital to evaluating the true cost of borrowing:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">The Base Interest Rate</h3>
        <p class="text-sm">
          The interest rate is the nominal cost of borrowing the principal loan balance. It is used directly to calculate your monthly payment. For example, on a $200,000 loan at a 6% interest rate, your monthly principal & interest (P&I) payment will be exactly $1,199.10.
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">The Annual Percentage Rate (APR)</h3>
        <p class="text-sm">
          The APR represents the broader cost of credit. It includes the base interest rate plus other charges (closing costs, points, fees) amortized over the life of the loan. In other words, it represents the rate you would pay if all upfront fees were converted into interest charges. 
        </p>
        <p class="text-xs text-mute mt-2">
          If Loan A has a 5.8% interest rate but $8,000 in upfront fees (resulting in an APR of 6.2%), and Loan B has a 6.0% interest rate but only $1,000 in fees (resulting in an APR of 6.05%), **Loan B is cheaper overall** even though its interest rate is higher!
        </p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-hairline pt-12 space-y-6">
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
      <div class="divide-y divide-hairline">
        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>What is an APR calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              An APR (Annual Percentage Rate) calculator is a tool that computes the true annualized cost of borrowing a loan. Unlike nominal interest rates, it folds in closing costs, points, lender documentation fees, and origination charges to show the effective interest rate.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I use an APR calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              To use this APR calculator, enter your loan principal, the base interest rate, the loan term, and the total upfront lender fees or closing costs. The calculator automatically computes the actual monthly payment and solves for the equivalent APR.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I calculate APR on a financial calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              On a financial calculator (like TI BA II Plus):
            </p>
            <ol class="list-decimal pl-5 mt-2 space-y-1 text-xs text-mute">
              <li>Calculate your standard monthly payment (PMT) including interest and term.</li>
              <li>Subtract closing fees from the principal to find net funded amount (Net PV).</li>
              <li>Enter the monthly PMT, the Net PV, and the Term (N).</li>
              <li>Solve for the periodic interest rate (I/Y). Multiply by 12 to find the nominal annual APR.</li>
            </ol>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How does APR affect the cost of a loan?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              The wider the gap between the base interest rate and the APR, the more expensive the loan fees are. The APR represents the true baseline cost of credit, meaning that comparing APRs of different lenders is the best way to identify the cheapest overall loan.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I calculate APR on a credit card?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Credit card APR is a nominal rate. Credit cards typically charge interest daily. To find your daily periodic interest rate, divide your card's APR by 365 (or 360). For example, a 21.9% APR divided by 365 yields a daily rate of exactly 0.06%.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I convert EAR to APR on a financial calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              On TI BA II Plus, use the interest conversion tool: press <code>2nd</code> then <code>2</code> (ICONV). Enter the Effective Annual Rate as <code>EFF</code>, press <code>ENTER</code>. Arrow up to <code>C/Y</code> (compounding periods per year), set it (e.g. 12 for monthly), press <code>ENTER</code>. Arrow down to <code>NOM</code> (Nominal Rate / APR) and press <code>CPT</code>.
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>
</CalculatorLayout>

<script>
  import type { Chart } from 'chart.js';
  import { calculateAPR, calculateLoanPMT } from '../../lib/math/loan';
  import { formatCurrency, formatPercentage } from '../../lib/utils';
  import { validateForm, validateField } from '../../lib/validation';
  import { syncInputsWithURL } from '../../lib/shareable';
  import { downloadDataAsCSV } from '../../lib/csv-exporter';

  let ChartClass: any = null;
  async function getChartClass() {
    if (!ChartClass) {
      const module = await import('chart.js/auto');
      ChartClass = module.default;
    }
    return ChartClass;
  }

  // DOM Elements
  const form = document.getElementById('apr-form') as HTMLFormElement;
  
  const loanInput = document.getElementById('loan-amount') as HTMLInputElement;
  const rateInput = document.getElementById('interest-rate') as HTMLInputElement;
  const termInput = document.getElementById('term') as HTMLInputElement;
  const feesInput = document.getElementById('fees') as HTMLInputElement;

  const resAprCard = document.getElementById('res-apr');
  const resNominalCard = document.getElementById('res-nominal');
  const resPaymentCard = document.getElementById('res-payment');
  const resFeesCard = document.getElementById('res-fees');

  let chartInstance: Chart | null = null;

  // Validation Rules
  const validationRules = {
    'loan-amount': { required: true, min: 1 },
    'interest-rate': { required: true, min: 0, max: 100 },
    'term': { required: true, min: 1, max: 100, integer: true },
    'fees': { required: true, min: 0 },
  };

  // Calculate APR
  function performCalculation() {
    // Formula DOM elements
    const stepBaseFormula = document.getElementById('step-base-formula');
    const stepNetLoan = document.getElementById('step-net-loan');
    const stepSolveApr = document.getElementById('step-solve-apr');

    if (!validateForm(validationRules)) {
      // Clear UI when values are invalid
      if (resAprCard) resAprCard.querySelector('.font-mono')!.textContent = '--%';
      if (resNominalCard) resNominalCard.querySelector('.font-mono')!.textContent = '--%';
      if (resPaymentCard) resPaymentCard.querySelector('.font-mono')!.textContent = '--';
      if (resFeesCard) resFeesCard.querySelector('.font-mono')!.textContent = '--';
      
      if (stepBaseFormula) stepBaseFormula.innerHTML = 'Enter valid inputs to see formula steps.';
      if (stepNetLoan) stepNetLoan.innerHTML = 'Enter valid inputs to see formula steps.';
      if (stepSolveApr) stepSolveApr.innerHTML = 'Enter valid inputs to see formula steps.';
      return;
    }

    const loanAmount = parseFloat(loanInput.value);
    const interestRate = parseFloat(rateInput.value) / 100;
    const termYears = parseInt(termInput.value);
    const extraFees = parseFloat(feesInput.value);

    const apr = calculateAPR({ loanAmount, interestRate, termYears, extraFees });
    const pmt = calculateLoanPMT({ principal: loanAmount, rate: interestRate, years: termYears });

    // Format using selected currency (dynamically fetches from localStorage)
    const aprFormatted = formatPercentage(apr);
    const nominalFormatted = formatPercentage(interestRate);
    const paymentFormatted = formatCurrency(pmt);
    const feesFormatted = formatCurrency(extraFees);

    // Update UI
    if (resAprCard) resAprCard.querySelector('.font-mono')!.textContent = aprFormatted;
    if (resNominalCard) resNominalCard.querySelector('.font-mono')!.textContent = nominalFormatted;
    if (resPaymentCard) resPaymentCard.querySelector('.font-mono')!.textContent = paymentFormatted;
    if (resFeesCard) resFeesCard.querySelector('.font-mono')!.textContent = feesFormatted;

    // Update formulas with user values plugged-in
    if (stepBaseFormula) {
      const monthlyRate = interestRate / 12;
      const totalMonths = termYears * 12;
      stepBaseFormula.innerHTML = `PMT = ${formatCurrency(loanAmount)} × [${monthlyRate.toFixed(6)} × (1 + ${monthlyRate.toFixed(6)})^${totalMonths}] / [(1 + ${monthlyRate.toFixed(6)})^${totalMonths} - 1]<br/><strong class="text-ink mt-1 block">PMT = ${paymentFormatted} / month</strong>`;
    }
    if (stepNetLoan) {
      stepNetLoan.innerHTML = `Net Principal = ${formatCurrency(loanAmount)} - ${formatCurrency(extraFees)} = <strong class="text-ink">${formatCurrency(loanAmount - extraFees)}</strong>`;
    }
    if (stepSolveApr) {
      const totalMonths = termYears * 12;
      stepSolveApr.innerHTML = `${formatCurrency(loanAmount - extraFees)} = ${paymentFormatted} × [1 - (1 + r_apr)^-${totalMonths}] / r_apr<br/>Solving for r_apr yields monthly rate, multiplied by 12 = <strong class="text-ink mt-1 block">Effective APR = ${aprFormatted}</strong>`;
    }

    // Update Chart
    updateChart(interestRate * 100, apr * 100);
  }

  async function updateChart(nominal: number, apr: number) {
    const canvas = document.getElementById('apr-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const Chart = await getChartClass();

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [nominal, apr];
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Interest Rate', 'Effective APR'],
          datasets: [
            {
              label: 'Percentage Rate (%)',
              data: [nominal, apr],
              backgroundColor: ['#4d4d4d', '#0070f3'],
              borderColor: ['#4d4d4d', '#0070f3'],
              borderWidth: 1,
              barThickness: 48
            }
          ]
        },
        options: {
          indexAxis: 'y', // horizontal bar chart
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context: any) {
                  return ` ${Number(context.raw).toFixed(3)}%`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { color: '#ebebeb' },
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value: any) {
                  return value + '%';
                }
              }
            },
            y: {
              grid: { display: false },
              ticks: { font: { family: 'Geist, sans-serif', size: 10 } }
            }
          }
        }
      });
    }
  }

  // Listeners
  [loanInput, rateInput, termInput, feesInput].forEach(el => {
    el.addEventListener('input', () => {
      // Validate individual field as user types
      validateField(el.id, validationRules[el.id as keyof typeof validationRules]);
      performCalculation();
    });
  });

  // Preset scenarios click handlers
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      loanInput.value = target.dataset.amount || '0';
      rateInput.value = target.dataset.rate || '0';
      termInput.value = target.dataset.term || '0';
      feesInput.value = target.dataset.fees || '0';
      
      // Clear previous validation highlights
      [loanInput, rateInput, termInput, feesInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });

      performCalculation();
      
      // Trigger input events to sync with URL parameters
      loanInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });

  // CSV Export handler
  const downloadCsvBtn = document.getElementById('download-csv-btn');
  downloadCsvBtn?.addEventListener('click', () => {
    if (!validateForm(validationRules)) return;
    const loanAmount = parseFloat(loanInput.value);
    const interestRate = parseFloat(rateInput.value);
    const termYears = parseInt(termInput.value);
    const extraFees = parseFloat(feesInput.value);
    
    const apr = calculateAPR({ loanAmount, interestRate: interestRate/100, termYears, extraFees });
    const pmt = calculateLoanPMT({ principal: loanAmount, rate: interestRate/100, years: termYears });

    const headers = ['Financial Metric', 'Value'];
    const rows = [
      ['Loan Principal Amount', formatCurrency(loanAmount)],
      ['Nominal Annual Interest Rate', formatPercentage(interestRate/100)],
      ['Loan Term', `${termYears} Years`],
      ['Upfront closing fees', formatCurrency(extraFees)],
      ['Monthly Payment (P&I)', formatCurrency(pmt)],
      ['True Effective APR', formatPercentage(apr)]
    ];

    downloadDataAsCSV(headers, rows, `apr-calculation-${loanAmount}.csv`);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(() => {
      // Clear errors
      [loanInput, rateInput, termInput, feesInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });
      performCalculation();
    }, 0);
  });

  // Initialize URL parameter sync
  syncInputsWithURL('apr-form', performCalculation);

  // Currency change handler
  window.addEventListener('currency-change', performCalculation);

  // Initial calculation
  performCalculation();
</script>
