---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={t('disclaimer.title', 'Financial Disclaimer | financialcalculatorapp.com')} description={t('disclaimer.intro')} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('disclaimer.heading', 'Disclaimer.')}</h1>
    <p class="text-xs text-mute font-mono uppercase tracking-wider">{t('disclaimer.lastUpdated', 'Last updated: October 2026')}</p>
    
    <p>
      {t('disclaimer.intro')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('disclaimer.sec1.heading', '1. Not Professional Financial Advice')}</h2>
    <p>
      {t('disclaimer.sec1.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('disclaimer.sec2.heading', '2. Consult Qualified Professionals')}</h2>
    <p>
      {t('disclaimer.sec2.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('disclaimer.sec3.heading', '3. Market & Investment Risk')}</h2>
    <p>
      {t('disclaimer.sec3.text')}
    </p>
  </article>
</Layout>
