---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={`${t('nav.disclaimer', 'Disclaimer')} - financialcalculatorapp.com`} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('nav.disclaimer', 'Disclaimer')}.</h1>
    <p class="text-xs text-mute font-mono uppercase tracking-wider">{t('calc.lastUpdated', 'Last updated')}: July 10, 2026</p>
    
    <p>
      The calculators and information provided on financialcalculatorapp.com are intended strictly for educational and illustrative purposes. 
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">1. Not Financial Advice</h2>
    <p>
      None of the outputs, projections, schedules, or charts generated by financialcalculatorapp.com constitute professional financial, tax, investment, legal, or real estate advice. All calculations are mathematical approximations based on user-supplied parameters and standard amortization algorithms.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">2. Consult a Professional</h2>
    <p>
      Financial scenarios are highly complex and vary significantly based on state laws, underwriting guidelines, tax brackets, and individual circumstances. You should consult a licensed financial advisor, Certified Public Accountant (CPA), or mortgage broker before executing any financial transactions.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">3. Risk Warning</h2>
    <p>
      Investing carries risks, including the possible loss of principal. Historic market averages (such as S&amp;P 500 return histories) do not guarantee future yields. Loan APRs and qualification parameters depend on credit history and lender discretion.
    </p>
  </article>
</Layout>
