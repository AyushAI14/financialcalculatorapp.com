---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('roi');
---

<CalculatorLayout 
  title="ROI Calculator" 
  description="Calculate the Return on Investment (ROI) and annualized ROI for any business venture, real estate deal, or stock purchase."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Form Inputs (Left Column) -->
    <div class="lg:col-span-7 space-y-6">
      <form id="roi-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4 border-b border-hairline pb-2">{t('Investment Performance', 'Investment Costs & Returns')}</h3>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="initial-investment" label="Initial Investment" type="number" prefix="$" value="50000" placeholder="0.00" />
            <Input id="final-value" label="Final Value" type="number" prefix="$" value="65000" placeholder="0.00" />
          </div>

          <!-- Duration -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-5 pt-4 border-t border-hairline/60">
            <div class="md:col-span-2">
              <Input id="duration" label="Investment Length" type="number" value="3.5" placeholder="e.g. 3" />
            </div>
            <Select id="duration-unit" label="Duration Unit" options={[
              { value: 'years', label: 'Years' },
              { value: 'months', label: 'Months' },
              { value: 'days', label: 'Days' }
            ]} value="years" />
          </div>
        </div>

        <!-- Optional/Advanced details -->
        <details class="group border border-hairline rounded-lg bg-canvas-soft">
          <summary class="flex items-center justify-between p-4 text-sm font-medium text-ink cursor-pointer select-none">
            <span>{t('Advanced Cash Flows (Optional)', 'Investment Costs & Returns')}</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </summary>
          <div class="p-5 border-t border-hairline bg-canvas space-y-5">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
              <Input id="expenses" label="Additional Expenses" type="number" prefix="$" value="1000" placeholder="0.00" />
              <Input id="income" label="Additional Income" type="number" prefix="$" value="2500" placeholder="0.00" />
            </div>
            <p class="text-xs text-mute leading-relaxed">
              * **Additional Expenses**: Any recurring fees, transaction fees, brokerage costs, or taxes paid. (Added to Initial Cost)
              <br/>
              * **Additional Income**: Dividends, interest earned, rents, or cash payouts. (Added to Final Value)
            </p>
          </div>
        </details>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Returns')}
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Results (Right Column) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-roi-container">
          <ResultCard 
            title="Return on Investment" 
            value="25.49%" 
            description="Total rate of return on invested capital."
            highlight={true}
          />
        </div>
        <div id="res-annual-container">
          <ResultCard 
            title="Annualized ROI (CAGR)" 
            value="6.73%" 
            description="Annualized compound rate of return." 
          />
        </div>
        <div id="res-profit-container">
          <ResultCard 
            title="Net Profit" 
            value="$13,000.00" 
            description="Final profit after adjusting expenses and dividends." 
          />
        </div>
      </div>

      <!-- Chart Container -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Investment Comparison</h4>
        <div class="h-64 relative">
          <canvas id="roi-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Educational SEO Section -->
  <article class="mt-20 max-w-4xl prose prose-sm text-body leading-relaxed border-t border-hairline pt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink mb-3">Understanding Return on Investment.</h2>
      <p>
        <strong>Return on Investment (ROI)</strong> is a popular profitability ratio used to evaluate the efficiency or profitability of an investment or compare the efficiency of a number of different investments. ROI tries to directly measure the amount of return on a particular investment, relative to the investment’s cost.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">Annualized ROI vs. Simple ROI</h3>
        <p class="text-sm">
          Simple ROI only measures the absolute growth from start to finish, regardless of the time it took. Annualized ROI (also known as Compound Annual Growth Rate, or CAGR) adjusts the returns to a standard one-year scale. 
        </p>
        <p class="text-xs text-mute mt-2">
          An investment that returns 50% in 10 years has a simple ROI of 50%, but an annualized ROI of only 4.14%. An investment returning 20% in 1 year has a lower simple ROI but a much better annualized rate. Always use annualized ROI when comparing investments of different durations!
        </p>
      </div>

      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">Mathematical Formulas</h3>
        <p class="text-sm"><strong>Simple ROI:</strong></p>
        <div class="bg-canvas-soft border border-hairline p-3 rounded font-mono text-xs text-ink my-2">
          ROI = (Net Return / Total Cost) * 100
        </div>
        <p class="text-sm"><strong>Annualized ROI:</strong></p>
        <div class="bg-canvas-soft border border-hairline p-3 rounded font-mono text-xs text-ink my-2">
          Annualized ROI = [(Ending Value / Beginning Cost)^(1 / Years)] - 1
        </div>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-hairline pt-12 space-y-6">
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
      <div class="divide-y divide-hairline">
        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>What is an ROI calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              An ROI (Return on Investment) calculator is a tool that computes the gain or loss of an investment relative to its initial cost. It is used to compare the profitability of different financial assets, projects, or business campaigns.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I calculate ROI?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              To calculate simple ROI, divide the net profit of the investment (ending value plus any earnings minus initial cost and ongoing expenses) by the total cost of the investment, then multiply by 100 to get a percentage.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I use an ROI calculator?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Input the initial investment amount (beginning value), the ending value (current or sold value), any additional investment expenses incurred during the holding period, and any dividends or cash flow earnings received. The calculator will automatically output the simple and annualized ROI.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How do I calculate ROI on a rental property?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Calculating ROI on real estate requires dividing annual net rental income (total rent minus mortgage, taxes, insurance, repairs, and vacancies) by the total cash invested (downpayment, closing costs, and remodeling expenses). This is also referred to as the Cash-on-Cash return.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>Can an ROI calculator be used for marketing investments?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Yes, marketing teams calculate ROI (MROI) to measure advertising campaigns. The formula is: <code>ROI = (Sales Growth - Marketing Cost) / Marketing Cost</code>. This measures the revenue generated for every dollar spent on ads and promotions.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>Can an ROI calculator measure returns from AI and automation?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Yes, companies calculate ROI on AI/automation by evaluating the capital expense (software licenses, developers, cloud servers) against the total savings (hours of human labor saved, error reductions, speed enhancements, and customer churn reductions).
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>
</CalculatorLayout>

<script>
  import { calculateROI } from '../../lib/math/finance';
  import { formatCurrency, formatPercentage } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('roi-form') as HTMLFormElement;
  
  const initialInput = document.getElementById('initial-investment') as HTMLInputElement;
  const finalInput = document.getElementById('final-value') as HTMLInputElement;
  const durationInput = document.getElementById('duration') as HTMLInputElement;
  const durationUnitSelect = document.getElementById('duration-unit') as HTMLSelectElement;
  
  const expensesInput = document.getElementById('expenses') as HTMLInputElement;
  const incomeInput = document.getElementById('income') as HTMLInputElement;

  const resRoiContainer = document.getElementById('res-roi-container');
  const resAnnualContainer = document.getElementById('res-annual-container');
  const resProfitContainer = document.getElementById('res-profit-container');

  let chartInstance: Chart | null = null;

  // Perform calculations
  function performCalculation() {
    const initialInvestment = Math.abs(parseFloat(initialInput.value)) || 0;
    const finalValue = Math.abs(parseFloat(finalInput.value)) || 0;
    const length = Math.abs(parseFloat(durationInput.value)) || 0;
    const lengthUnit = durationUnitSelect.value as 'years' | 'months' | 'days';
    
    const additionalExpenses = Math.abs(parseFloat(expensesInput.value)) || 0;
    const additionalReturns = Math.abs(parseFloat(incomeInput.value)) || 0;

    const results = calculateROI({
      initialInvestment,
      finalValue,
      length,
      lengthUnit,
      additionalExpenses,
      additionalReturns
    });

    const netProfitFormatted = formatCurrency(results.netProfit);
    const roiFormatted = formatPercentage(results.roi);
    const annualRoiFormatted = formatPercentage(results.annualizedRoi);

    // Update Result Cards DOM
    if (resRoiContainer) {
      resRoiContainer.querySelector('.font-mono')!.textContent = roiFormatted;
      resRoiContainer.querySelector('.font-mono')!.setAttribute('title', roiFormatted);
    }
    if (resAnnualContainer) {
      resAnnualContainer.querySelector('.font-mono')!.textContent = annualRoiFormatted;
      resAnnualContainer.querySelector('.font-mono')!.setAttribute('title', annualRoiFormatted);
    }
    if (resProfitContainer) {
      resProfitContainer.querySelector('.font-mono')!.textContent = netProfitFormatted;
      resProfitContainer.querySelector('.font-mono')!.setAttribute('title', netProfitFormatted);
    }

    // Update Chart
    updateChart(initialInvestment + additionalExpenses, finalValue + additionalReturns);
  }

  function updateChart(cost: number, returns: number) {
    const canvas = document.getElementById('roi-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (chartInstance) {
      chartInstance.data.datasets[0].data = [cost, returns];
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['Total Invested Cost', 'Total Returned Value'],
          datasets: [
            {
              label: 'Amount ($)',
              data: [cost, returns],
              backgroundColor: ['#171717', '#0070f3'],
              borderColor: ['#171717', '#0070f3'],
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` ${formatCurrency(context.raw as number)}`;
                }
              }
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { font: { family: 'Geist, sans-serif', size: 10 } }
            },
            y: {
              grid: { color: '#ebebeb' },
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
                }
              }
            }
          }
        }
      });
    }
  }

  // Listeners
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  [initialInput, finalInput, durationInput, durationUnitSelect, expensesInput, incomeInput].forEach(el => {
    el.addEventListener('input', performCalculation);
  });

  // Initial Calculation
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', performCalculation);
</script>
