---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import ToggleSwitch from '../../components/ui/ToggleSwitch.astro';
import RangeSlider from '../../components/ui/RangeSlider.astro';
import CompoundInterestChart from '../../components/charts/CompoundInterestChart';
import { generateCompoundInterestSchedule, generateCompoundingComparison } from '../../lib/math/finance';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('compound-interest');

// Initial baseline projection schedule & multi-frequency comparison ($10k initial, $200/mo, 7.5%, 20y)
const initialSchedule = generateCompoundInterestSchedule({
  principal: 10000,
  monthlyContribution: 200,
  rate: 0.075,
  years: 20,
  compoundingFrequency: 12,
  timing: 'end'
});

const initialComparison = generateCompoundingComparison({
  principal: 10000,
  monthlyContribution: 200,
  rate: 0.075,
  years: 20,
  timing: 'end'
});
---

<CalculatorLayout 
  title="Compound Interest & Investment Calculator" 
  seoTitle="Compound Interest & Investment Calculator – Growth & Returns"
  description="Free compound interest & investment calculator. Project portfolio growth with initial principal, monthly contributions, and compounding interest frequency."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="compound-form" class="space-y-6">
        <!-- Synced Inputs & Range Sliders -->
        <div class="space-y-6 bg-canvas border border-hairline p-4 sm:p-6 rounded-lg shadow-sm">
          <h3 class="text-[11px] sm:text-xs font-mono text-mute uppercase tracking-wider mb-3 sm:mb-4 border-b border-hairline pb-2">{t('Investment Values')}</h3>
          
          <!-- Principal -->
          <div class="space-y-2">
            <Input id="principal" label="Initial Investment" type="number" prefix="$" value="10000" />
            <RangeSlider id="principal-slider" label="Initial Investment Adjustment" min={0} max={250000} step={1000} value={10000} />
          </div>

          <!-- Monthly contribution -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="contribution" label="Monthly Contribution" type="number" prefix="$" value="200" />
            <RangeSlider id="contribution-slider" label="Monthly Contribution Adjustment" min={0} max={5000} step={50} value={200} />
          </div>

          <!-- Interest Rate -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="rate" label="Annual Interest Rate" type="number" suffix="%" value="7.5" />
            <RangeSlider id="rate-slider" label="Interest Rate Adjustment" min={0} max={25} step={0.1} value={7.5} />
          </div>

          <!-- Years -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="years" label="Length of Time" type="number" suffix="years" value="20" />
            <RangeSlider id="years-slider" label="Time Duration Adjustment" min={1} max={50} step={1} value={20} />
          </div>
        </div>

        <!-- Compounding Terms -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-3.5 sm:p-5 bg-canvas-soft border border-hairline rounded-md">
          <Select id="compounding" label="Compounding Interval" options={[
            { value: '1', label: 'Annually' },
            { value: '2', label: 'Semi-Annually' },
            { value: '4', label: 'Quarterly' },
            { value: '12', label: 'Monthly' },
            { value: '365', label: 'Daily' }
          ]} value="12" />
          
          <ToggleSwitch 
            id="timing" 
            label="Beginning of Period" 
            checked={false} 
            description="Contributions made at start of month"
          />
        </div>

        <div class="pt-2 border-t border-hairline flex gap-3 sm:gap-4">
          <button type="submit" class="px-4 sm:px-6 py-2 sm:py-2.5 bg-primary text-on-primary rounded-full font-medium text-xs sm:text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Growth')}
          </button>
          <button type="reset" id="reset-btn" class="px-4 sm:px-6 py-2 sm:py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-xs sm:text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Stacked Bar Chart) -->
    <div class="lg:col-span-6 space-y-6">
      <!-- 3-up Result Cards Grid -->
      <div class="flex flex-col gap-3">
        <ResultCard 
          id="res-total"
          title="Ending Balance" 
          value="--" 
          highlight={true} 
        />
        <ResultCard 
          id="res-principal"
          title="Total Principal" 
          value="--" 
        />
        <ResultCard 
          id="res-interest"
          title="Interest Earned" 
          value="--" 
        />
      </div>

      <div id="compound-takeaway" class="bg-canvas border border-hairline p-3.5 sm:p-5 rounded-lg shadow-sm font-medium text-[11px] sm:text-xs leading-relaxed text-ink hidden">
      </div>

      <!-- Compound Interest Growth Chart (Recharts) -->
      <CompoundInterestChart
        client:load
        title={t('Compound Interest Growth Chart')}
        subtitle={t('Cumulative deposits vs. exponential compound returns over your investment horizon')}
        initialSchedule={initialSchedule}
        initialComparison={initialComparison}
        initialCompoundingFrequency={12}
      />
    </div>
  </div>

  <!-- Detailed Year-by-Year Schedule -->
  <div class="mt-8 sm:mt-12 border-t border-hairline pt-6 sm:pt-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 sm:gap-4 mb-4 sm:mb-6">
      <div>
        <h3 class="text-lg sm:text-xl font-semibold tracking-[-0.8px] text-ink">{t('Yearly Growth Breakdowns')}</h3>
        <p class="text-xs sm:text-sm text-body mt-1">{t('Detailed growth of your principal and compound interest accrued annually.')}</p>
      </div>
      <button 
        id="toggle-schedule" 
        class="px-3 sm:px-4 py-1.5 sm:py-2 border border-hairline rounded-md text-[11px] sm:text-xs font-mono font-medium bg-canvas hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer w-fit"
      >
        {t('Show Yearly Table')}
      </button>
    </div>

    <div id="schedule-wrapper" class="hidden border border-hairline rounded-lg overflow-hidden shadow-sm">
      <div class="overflow-x-auto max-h-[450px]">
        <table class="w-full border-collapse text-left text-[11px] sm:text-xs">
          <thead class="sticky top-0 bg-canvas-soft border-b border-hairline font-mono text-[10px] sm:text-xs uppercase text-mute z-10">
            <tr>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3">Year</th>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">Starting Bal</th>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">Deposits</th>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">Interest</th>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">Ending Bal</th>
              <th class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">Total Interest</th>
            </tr>
          </thead>
          <tbody id="schedule-body" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { generateCompoundInterestSchedule, generateCompoundingComparison } from '../../lib/math/finance';
  import { formatCurrency } from '../../lib/utils';

  // DOM Elements
  const form = document.getElementById('compound-form') as HTMLFormElement;
  
  const principalInput = document.getElementById('principal') as HTMLInputElement;
  const principalSlider = document.getElementById('principal-slider') as HTMLInputElement;
  
  const contributionInput = document.getElementById('contribution') as HTMLInputElement;
  const contributionSlider = document.getElementById('contribution-slider') as HTMLInputElement;
  
  const rateInput = document.getElementById('rate') as HTMLInputElement;
  const rateSlider = document.getElementById('rate-slider') as HTMLInputElement;
  
  const yearsInput = document.getElementById('years') as HTMLInputElement;
  const yearsSlider = document.getElementById('years-slider') as HTMLInputElement;

  const compoundingSelect = document.getElementById('compounding') as HTMLSelectElement;
  const timingCheckbox = document.getElementById('timing') as HTMLInputElement;
  
  const toggleScheduleBtn = document.getElementById('toggle-schedule');
  const scheduleWrapper = document.getElementById('schedule-wrapper');
  const scheduleBody = document.getElementById('schedule-body');

  // Sync Input and Sliders with instant dynamic recalculation
  function setupSyncedInputs(inp: HTMLInputElement, sli: HTMLInputElement) {
    // Sync slider -> input
    sli.addEventListener('input', (e: any) => {
      inp.value = e.target.value;
      const displayVal = document.getElementById(`${sli.id}-val`);
      if (displayVal) displayVal.textContent = sli.value;
      performCalculation();
    });

    // Sync input -> slider
    inp.addEventListener('input', () => {
      const val = parseFloat(inp.value) || 0;
      sli.value = Math.min(Math.max(val, parseFloat(sli.min)), parseFloat(sli.max)).toString();
      
      const displayVal = document.getElementById(`${sli.id}-val`);
      if (displayVal) displayVal.textContent = sli.value;
      performCalculation();
    });
  }

  setupSyncedInputs(principalInput, principalSlider);
  setupSyncedInputs(contributionInput, contributionSlider);
  setupSyncedInputs(rateInput, rateSlider);
  setupSyncedInputs(yearsInput, yearsSlider);

  // Instantly recalculate on compounding interval or payment timing changes
  compoundingSelect.addEventListener('change', () => {
    performCalculation();
  });
  timingCheckbox.addEventListener('change', () => {
    performCalculation();
  });

  // Listen for compounding convention change from chart toggle pills
  window.addEventListener('compound-frequency-changed' as any, (e: CustomEvent) => {
    if (e.detail?.frequency) {
      compoundingSelect.value = e.detail.frequency.toString();
      performCalculation();
    }
  });

  // Perform Calculation & Synchronize All Views
  function performCalculation() {
    const principal = Math.max(0, parseFloat(principalInput.value) || 0);
    const monthlyContribution = Math.max(0, parseFloat(contributionInput.value) || 0);
    const rate = Math.min(10, Math.max(0, (parseFloat(rateInput.value) || 0) / 100));
    const years = Math.min(100, Math.max(0, parseInt(yearsInput.value) || 0));
    const compounding = parseInt(compoundingSelect.value) || 12;
    const timing = timingCheckbox.checked ? 'beginning' : 'end';

    const schedule = generateCompoundInterestSchedule({
      principal,
      monthlyContribution,
      rate,
      years,
      compoundingFrequency: compounding,
      timing
    });

    const comparison = generateCompoundingComparison({
      principal,
      monthlyContribution,
      rate,
      years,
      timing
    });

    if (!schedule || schedule.length === 0) return;
    const finalEntry = schedule[schedule.length - 1];
    
    // Update Result Cards
    updateResultCards({
      totalBalance: finalEntry.endingBalance,
      totalContributions: finalEntry.totalContributions,
      totalInterest: finalEntry.totalInterest
    });

    const takeawayEl = document.getElementById('compound-takeaway');
    if (takeawayEl) {
      takeawayEl.classList.remove('hidden');
      const interestRatio = finalEntry.endingBalance > 0 ? (finalEntry.totalInterest / finalEntry.endingBalance) * 100 : 0;
      let insight = '';
      if (interestRatio > 50) {
        insight = `compound interest did more work than your actual deposits, accounting for <strong class="text-link">${interestRatio.toFixed(1)}%</strong> of your final wealth.`;
      } else {
        insight = `compound interest grew your portfolio by adding <strong class="text-link">${formatCurrency(finalEntry.totalInterest)}</strong> in free growth, accounting for <strong class="text-link">${interestRatio.toFixed(1)}%</strong> of your total balance.`;
      }
      takeawayEl.innerHTML = `
        <span class="text-link">📢 Takeaway:</span> In ${years} years, ${insight}
      `;
    }

    // Dispatch update to Recharts component
    window.dispatchEvent(
      new CustomEvent('compound-interest-data-updated', {
        detail: {
          schedule,
          comparison,
          compoundingFrequency: compounding
        }
      })
    );

    // Update Schedule Table
    updateScheduleTable(schedule);
  }

  function updateResultCards(res: { totalBalance: number, totalContributions: number, totalInterest: number }) {
    const rootTotal = document.getElementById('res-total');
    const rootPrincipal = document.getElementById('res-principal');
    const rootInterest = document.getElementById('res-interest');

    if (rootTotal) {
      rootTotal.querySelector('.font-mono')!.textContent = formatCurrency(res.totalBalance);
      rootTotal.querySelector('.font-mono')!.setAttribute('title', formatCurrency(res.totalBalance));
    }
    if (rootPrincipal) {
      rootPrincipal.querySelector('.font-mono')!.textContent = formatCurrency(res.totalContributions);
      rootPrincipal.querySelector('.font-mono')!.setAttribute('title', formatCurrency(res.totalContributions));
    }
    if (rootInterest) {
      rootInterest.querySelector('.font-mono')!.textContent = formatCurrency(res.totalInterest);
      rootInterest.querySelector('.font-mono')!.setAttribute('title', formatCurrency(res.totalInterest));
    }
  }

  function updateScheduleTable(schedule: any[]) {
    if (!scheduleBody) return;
    
    let html = '';
    schedule.forEach(e => {
      html += `
        <tr class="hover:bg-canvas-soft transition-colors font-mono text-[11px] sm:text-xs text-ink">
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 font-semibold text-body">Year ${e.year}</td>
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">${formatCurrency(e.startingBalance)}</td>
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 text-right">${formatCurrency(e.contributions)}</td>
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 text-right text-link">${formatCurrency(e.interest)}</td>
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 text-right font-medium">${formatCurrency(e.endingBalance)}</td>
          <td class="px-2.5 py-2 sm:px-5 sm:py-3 text-right text-mute">${formatCurrency(e.totalInterest)}</td>
        </tr>
      `;
    });

    scheduleBody.innerHTML = html;
  }

  // Form Submit Handler
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  // Form Reset Handler
  form.addEventListener('reset', () => {
    setTimeout(() => {
      [principalSlider, contributionSlider, rateSlider, yearsSlider].forEach(sli => {
        const displayVal = document.getElementById(`${sli.id}-val`);
        if (displayVal) displayVal.textContent = sli.value;
      });
      performCalculation();
    }, 10);
  });

  // Table toggle logic
  if (toggleScheduleBtn && scheduleWrapper) {
    toggleScheduleBtn.addEventListener('click', () => {
      const isHidden = scheduleWrapper.classList.contains('hidden');
      if (isHidden) {
        scheduleWrapper.classList.remove('hidden');
        toggleScheduleBtn.textContent = 'Hide Yearly Table';
      } else {
        scheduleWrapper.classList.add('hidden');
        toggleScheduleBtn.textContent = 'Show Yearly Table';
      }
    });
  }

  // Initial Calculation on load to populate table, cards & chart in sync
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', () => {
    performCalculation();
  });
</script>
