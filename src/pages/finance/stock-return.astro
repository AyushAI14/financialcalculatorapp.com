---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('stock-return');
---

<CalculatorLayout 
  title="Stock Return Calculator" 
  description="Calculate the total return, annualized return (CAGR), and capital gains on stock investments, including dividend reinvestment."
  faqs={faqs}
>
  <div id="section-return" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="return-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-2 mb-4">
            <h3 class="text-xs font-mono text-mute uppercase tracking-wider">{t('Purchase & Sale Pricing', 'Stock Investment Details')}</h3>
            <div class="flex flex-wrap items-center gap-1.5 no-print">
              <span class="text-[10px] text-mute font-mono">{t('Presets:')}</span>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-buy="120.50" data-sell="155.20" data-shares="100" data-holding="2.5" data-div="4.80">{t('Short Trade')}</button>
              <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-buy="50.00" data-sell="110.00" data-shares="200" data-holding="5.0" data-div="12.00">{t('Long Investment')}</button>
            </div>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="buy-price" label="Purchase Price per Share" type="number" prefix="$" value="120.50" />
            <Input id="sell-price" label="Selling Price per Share" type="number" prefix="$" value="155.20" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2 border-t border-hairline/60">
            <Input id="shares" label="Number of Shares" type="number" value="100" />
            <Input id="holding-period" label="Holding Duration" type="number" suffix="years" value="2.5" />
          </div>
        </div>

        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">{t('Dividends Received', 'Dividend Stock Profile')}</h3>
          <Input id="dividends-paid" label="Total Dividends Paid (Per share)" type="number" prefix="$" value="4.80" />
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Yields')}
          </button>
          <button type="reset" id="reset-yields-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-return-pct">
          <ResultCard title="Total Return" value="--" highlight={true} description="Total rate of return on invested capital." />
        </div>
        <div id="res-return-annual">
          <ResultCard title="Annualized Return" value="--" description="Annualized CAGR rate of return." />
        </div>
        <div id="res-net-gain">
          <ResultCard title="Net Gain" value="--" description="Total profit earned from capital gains & dividends." />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div id="res-cost">
          <ResultCard title="Initial Cost" value="--" />
        </div>
        <div id="res-proceeds">
          <ResultCard title="Sale Proceeds" value="--" />
        </div>
        <div id="res-div-total">
          <ResultCard title="Total Dividends" value="--" />
        </div>
      </div>

      <!-- Gain Breakdown Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Investment Balance Breakdown</h4>
        <div class="h-64 relative">
          <canvas id="return-chart"></canvas>
        </div>
      </div>

      <!-- Formula Breakdown -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm no-print">
        <details class="group">
          <summary class="flex items-center justify-between text-xs font-mono text-mute uppercase tracking-wider cursor-pointer select-none">
            <span>Formula Breakdown</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-4 text-xs text-body space-y-4 pt-3 border-t border-hairline">
            <div>
              <p class="font-semibold text-ink mb-1">1. Simple Return Formula</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words">
                Total Return % = [(Sell Price - Buy Price + Dividends) / Buy Price] × 100
              </code>
            </div>
            <div>
              <p class="font-semibold text-ink mb-1">2. Annualized Return (CAGR)</p>
              <code class="block p-2 bg-canvas-soft border border-hairline rounded text-[11px] font-mono leading-relaxed break-words">
                CAGR = (Total Return Ratio) ^ (1 / Years) - 1
              </code>
            </div>
            <div id="return-takeaway-container" class="border-t border-hairline/60 pt-4 mt-2 font-medium text-ink hidden">
              <!-- Takeaway sentence goes here -->
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateStockReturns } from '../../lib/math/retirement';
  import { formatCurrency, formatPercentage } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  const returnForm = document.getElementById('return-form') as HTMLFormElement;
  const buyPriceInput = document.getElementById('buy-price') as HTMLInputElement;
  const sellPriceInput = document.getElementById('sell-price') as HTMLInputElement;
  const sharesInput = document.getElementById('shares') as HTMLInputElement;
  const holdingInput = document.getElementById('holding-period') as HTMLInputElement;
  const dividendsInput = document.getElementById('dividends-paid') as HTMLInputElement;

  const resPctCard = document.getElementById('res-return-pct');
  const resAnnualCard = document.getElementById('res-return-annual');
  const resNetCard = document.getElementById('res-net-gain');
  const resCostCard = document.getElementById('res-cost');
  const resProceedsCard = document.getElementById('res-proceeds');
  const resDivCard = document.getElementById('res-div-total');
  const takeawayContainer = document.getElementById('return-takeaway-container');

  let returnChartInstance: Chart | null = null;

  function performReturnCalc() {
    const buyPrice = Math.abs(parseFloat(buyPriceInput.value)) || 0;
    const sellPrice = Math.abs(parseFloat(sellPriceInput.value)) || 0;
    const shares = Math.abs(parseInt(sharesInput.value)) || 0;
    const holdingPeriodYears = Math.abs(parseFloat(holdingInput.value)) || 0;
    const dividendsPaid = Math.abs(parseFloat(dividendsInput.value)) || 0;

    const res = calculateStockReturns({ buyPrice, sellPrice, shares, dividendsPaid, holdingPeriodYears });

    // Update displays
    if (resPctCard) resPctCard.querySelector('.font-mono')!.textContent = formatPercentage(res.totalReturnPct);
    if (resAnnualCard) resAnnualCard.querySelector('.font-mono')!.textContent = formatPercentage(res.annualizedReturn);
    if (resNetCard) resNetCard.querySelector('.font-mono')!.textContent = formatCurrency(res.netGain);
    if (resCostCard) resCostCard.querySelector('.font-mono')!.textContent = formatCurrency(res.initialCost);
    if (resProceedsCard) resProceedsCard.querySelector('.font-mono')!.textContent = formatCurrency(res.salesProceeds);
    if (resDivCard) resDivCard.querySelector('.font-mono')!.textContent = formatCurrency(res.totalDividends);

    // Plain English takeaway
    if (takeawayContainer) {
      takeawayContainer.classList.remove('hidden');
      takeawayContainer.innerHTML = `
        <span class="text-link">📢 Takeaway:</span> An initial investment of ${formatCurrency(res.initialCost)} grew to a total value of ${formatCurrency(res.salesProceeds + res.totalDividends)} (including dividends) over ${holdingPeriodYears} years, yielding an annualized return rate of <strong class="text-link">${(res.annualizedReturn * 100).toFixed(2)}%</strong>.
      `;
    }

    updateReturnChart(res.initialCost, res.salesProceeds - res.initialCost, res.totalDividends);
  }

  function updateReturnChart(cost: number, capGain: number, dividends: number) {
    const canvas = document.getElementById('return-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const values = [cost, Math.max(0, capGain), dividends];

    if (returnChartInstance) {
      returnChartInstance.data.datasets[0].data = values;
      returnChartInstance.update();
    } else {
      returnChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Initial Principal', 'Capital Gain', 'Dividends Paid'],
          datasets: [
            {
              data: values,
              backgroundColor: ['#3b82f6', '#10b981', '#f59e0b'],
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'right',
              labels: { boxWidth: 10, font: { family: 'Geist, sans-serif', size: 10 } }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` ${context.label}: ${formatCurrency(context.raw as number)}`;
                }
              }
            }
          }
        }
      });
    }
  }

  // Presets Handlers
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      buyPriceInput.value = target.dataset.buy || '';
      sellPriceInput.value = target.dataset.sell || '';
      sharesInput.value = target.dataset.shares || '';
      holdingInput.value = target.dataset.holding || '';
      dividendsInput.value = target.dataset.div || '';
    });
  });

  // Listeners
  returnForm.addEventListener('submit', (e) => {
    e.preventDefault();
    performReturnCalc();
  });
  returnForm.addEventListener('reset', () => {
    setTimeout(() => {
      if (resPctCard) resPctCard.querySelector('.font-mono')!.textContent = '--';
      if (resAnnualCard) resAnnualCard.querySelector('.font-mono')!.textContent = '--';
      if (resNetCard) resNetCard.querySelector('.font-mono')!.textContent = '--';
      if (resCostCard) resCostCard.querySelector('.font-mono')!.textContent = '--';
      if (resProceedsCard) resProceedsCard.querySelector('.font-mono')!.textContent = '--';
      if (resDivCard) resDivCard.querySelector('.font-mono')!.textContent = '--';
      if (takeawayContainer) takeawayContainer.classList.add('hidden');
      if (returnChartInstance) {
        returnChartInstance.destroy();
        returnChartInstance = null;
      }
    }, 0);
  });

  // Listen for currency changes
  window.addEventListener('currency-change', () => {
    if (resPctCard && resPctCard.querySelector('.font-mono')?.textContent !== '--') {
      performReturnCalc();
    }
  });
</script>
