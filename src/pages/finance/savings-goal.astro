---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import ToggleSwitch from '../../components/ui/ToggleSwitch.astro';
import RangeSlider from '../../components/ui/RangeSlider.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('savings-goal');
---

<CalculatorLayout 
  title="Savings Goal Calculator" 
  description="Determine how much money you need to save each month to reach your financial savings target by a specific deadline."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Form Inputs (Left Column) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="savings-goal-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4 border-b border-hairline pb-2">{t('Goal Settings', 'Savings Goal Details')}</h3>
          
          <!-- Target Goal -->
          <div class="space-y-2">
            <Input id="target-goal" label="Target Savings Goal" type="number" prefix="$" value="50000" />
            <RangeSlider id="target-goal-slider" label="Target Goal Adjustment" min={1000} max={500000} step={5000} value={50000} />
          </div>

          <!-- Starting Balance -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="starting-balance" label="Starting Balance (Initial Savings)" type="number" prefix="$" value="5000" />
            <RangeSlider id="starting-balance-slider" label="Starting Balance Adjustment" min={0} max={100000} step={1000} value={5000} />
          </div>

          <!-- Years to Save -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="years" label="Years to Save" type="number" suffix="years" value="10" />
            <RangeSlider id="years-slider" label="Time Duration Adjustment" min={1} max={40} step={1} value={10} />
          </div>

          <!-- Interest Rate -->
          <div class="space-y-2 pt-2 border-t border-hairline/60">
            <Input id="rate" label="Expected Interest Rate" type="number" suffix="%" value="6" />
            <RangeSlider id="rate-slider" label="Interest Rate Adjustment" min={0} max={15} step={0.1} value={6} />
          </div>
        </div>

        <!-- Compounding Terms -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 p-5 bg-canvas-soft border border-hairline rounded-md">
          <Select id="compounding" label="Compounding Freq" options={[
            { value: '1', label: 'Annually' },
            { value: '4', label: 'Quarterly' },
            { value: '12', label: 'Monthly' },
            { value: '365', label: 'Daily' }
          ]} value="12" />
          
          <ToggleSwitch 
            id="timing" 
            label="Beginning of Period" 
            checked={false} 
            description="Deposits made at start of month"
          />
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Goal')}
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Results (Right Column) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-monthly">
          <ResultCard 
            title="Monthly Deposit" 
            value="$271.74" 
            highlight={true} 
          />
        </div>
        <div id="res-total-dep">
          <ResultCard 
            title="Total Deposits" 
            value="$37,608.80" 
          />
        </div>
        <div id="res-interest">
          <ResultCard 
            title="Interest Earned" 
            value="$12,391.20" 
          />
        </div>
      </div>

      <div id="savings-takeaway" class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm font-medium text-xs leading-relaxed text-ink hidden">
      </div>

      <!-- Growth Chart Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Savings Accumulation Progress</h4>
        <div class="h-80 relative">
          <canvas id="savings-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Year-by-Year Schedule -->
  <div class="mt-12 border-t border-hairline pt-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xl font-semibold tracking-[-0.8px] text-ink">Savings Schedule</h3>
        <p class="text-sm text-body mt-1">Yearly accumulation breakdown of starting balance, additions, and compound growth.</p>
      </div>
      <button 
        id="toggle-schedule" 
        class="px-4 py-2 border border-hairline rounded-md text-xs font-mono font-medium bg-canvas hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer"
      >
        Show Detailed Table
      </button>
    </div>

    <div id="schedule-wrapper" class="hidden border border-hairline rounded-lg overflow-hidden shadow-sm">
      <div class="overflow-x-auto max-h-[450px]">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="sticky top-0 bg-canvas-soft border-b border-hairline font-mono text-xs uppercase text-mute z-10">
            <tr>
              <th class="px-5 py-3">Year</th>
              <th class="px-5 py-3 text-right">Starting Bal</th>
              <th class="px-5 py-3 text-right">Annual Deposits</th>
              <th class="px-5 py-3 text-right">Interest Earned</th>
              <th class="px-5 py-3 text-right">Ending Bal</th>
              <th class="px-5 py-3 text-right">Total Deposits</th>
            </tr>
          </thead>
          <tbody id="schedule-body" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateTVM } from '../../lib/math/finance';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('savings-goal-form') as HTMLFormElement;
  
  const targetInput = document.getElementById('target-goal') as HTMLInputElement;
  const targetSlider = document.getElementById('target-goal-slider') as HTMLInputElement;
  
  const startingInput = document.getElementById('starting-balance') as HTMLInputElement;
  const startingSlider = document.getElementById('starting-balance-slider') as HTMLInputElement;
  
  const yearsInput = document.getElementById('years') as HTMLInputElement;
  const yearsSlider = document.getElementById('years-slider') as HTMLInputElement;
  
  const rateInput = document.getElementById('rate') as HTMLInputElement;
  const rateSlider = document.getElementById('rate-slider') as HTMLInputElement;

  const compoundingSelect = document.getElementById('compounding') as HTMLSelectElement;
  const timingCheckbox = document.getElementById('timing') as HTMLInputElement;
  
  const resMonthlyCard = document.getElementById('res-monthly');
  const resTotalDepCard = document.getElementById('res-total-dep');
  const resInterestCard = document.getElementById('res-interest');

  const toggleScheduleBtn = document.getElementById('toggle-schedule');
  const scheduleWrapper = document.getElementById('schedule-wrapper');
  const scheduleBody = document.getElementById('schedule-body');

  let chartInstance: Chart | null = null;

  // Sync Input and Sliders
  function setupSyncedInputs(inp: HTMLInputElement, sli: HTMLInputElement) {
    sli.addEventListener('input', (e: any) => {
      inp.value = e.target.value;
      performCalculation();
    });
    inp.addEventListener('input', () => {
      const val = parseFloat(inp.value) || 0;
      sli.value = Math.min(Math.max(val, parseFloat(sli.min)), parseFloat(sli.max)).toString();
      const displayVal = document.getElementById(`${sli.id}-val`);
      if (displayVal) displayVal.textContent = sli.value;
      performCalculation();
    });
  }

  setupSyncedInputs(targetInput, targetSlider);
  setupSyncedInputs(startingInput, startingSlider);
  setupSyncedInputs(yearsInput, yearsSlider);
  setupSyncedInputs(rateInput, rateSlider);

  // Perform calculations
  function performCalculation() {
    const targetGoal = Math.abs(parseFloat(targetInput.value)) || 0;
    const startingBalance = Math.abs(parseFloat(startingInput.value)) || 0;
    const years = Math.abs(parseInt(yearsInput.value)) || 1;
    const rate = (Math.abs(parseFloat(rateInput.value)) || 0) / 100;
    const compounding = parseInt(compoundingSelect.value) || 12;
    const timing = timingCheckbox.checked ? 'beginning' : 'end';

    const periods = years * 12;

    // Check if starting balance alone solves the goal
    const compoundFactor = Math.pow(1 + rate / compounding, compounding * years);
    const balanceFromStarting = startingBalance * compoundFactor;

    let monthlyPmt = 0;
    let schedule: any[] = [];

    if (balanceFromStarting >= targetGoal) {
      // No contributions needed
      monthlyPmt = 0;
      // Generate a schedule of starting balance growth only
      schedule = simulateSavingsSchedule(startingBalance, 0, rate, compounding, periods, timing);
    } else {
      try {
        // Solve for PMT:
        // PV is outflow (-startingBalance), FV is inflow (+targetGoal)
        const pmtSolved = calculateTVM('pmt', {
          pv: -startingBalance,
          fv: targetGoal,
          rate,
          periods,
          compoundingFrequency: compounding,
          paymentFrequency: 12, // Monthly savings
          timing
        });

        // Solved PMT is negative contribution
        monthlyPmt = Math.abs(pmtSolved);
        
        // Generate monthly schedule
        schedule = simulateSavingsSchedule(startingBalance, monthlyPmt, rate, compounding, periods, timing);
      } catch (err) {
        monthlyPmt = 0;
      }
    }

    const totalDeposited = startingBalance + (monthlyPmt * periods);
    const totalInterest = Math.max(0, targetGoal - totalDeposited);

    // Update displays
    if (resMonthlyCard) {
      resMonthlyCard.querySelector('.font-mono')!.textContent = formatCurrency(monthlyPmt);
    }
    if (resTotalDepCard) {
      resTotalDepCard.querySelector('.font-mono')!.textContent = formatCurrency(totalDeposited);
    }
    if (resInterestCard) {
      resInterestCard.querySelector('.font-mono')!.textContent = formatCurrency(totalInterest);
    }

    const takeawayEl = document.getElementById('savings-takeaway');
    if (takeawayEl) {
      takeawayEl.classList.remove('hidden');
      const pctInterest = targetGoal > 0 ? (totalInterest / targetGoal) * 100 : 0;
      takeawayEl.innerHTML = `
        <span class="text-link">📢 Takeaway:</span> To reach your goal of <strong class="text-ink">${formatCurrency(targetGoal)}</strong> in ${years} years, compound interest will cover <strong class="text-link">${pctInterest.toFixed(1)}%</strong> of the target (${formatCurrency(totalInterest)}). You only need to contribute <strong class="text-ink">${formatCurrency(totalDeposited)}</strong> out of pocket.
      `;
    }

    // Compile into yearly entries for the chart and table
    const yearlySchedule = compileYearlySchedule(schedule, startingBalance);
    
    // Update Chart and Table
    updateChart(yearlySchedule);
    updateScheduleTable(yearlySchedule);
  }

  // Simulate monthly savings path
  function simulateSavingsSchedule(starting: number, pmt: number, rate: number, compounding: number, periods: number, timing: string) {
    const list = [];
    let balance = starting;
    const r = Math.pow(1 + rate / compounding, compounding / 12) - 1; // Monthly rate

    for (let i = 1; i <= periods; i++) {
      const startingBalance = balance;
      let interest = 0;
      let payment = pmt;

      if (timing === 'beginning') {
        const adjusted = startingBalance + payment;
        interest = adjusted * r;
        balance = adjusted + interest;
      } else {
        interest = startingBalance * r;
        balance = startingBalance + interest + payment;
      }

      list.push({
        period: i,
        startingBalance,
        payment,
        interest,
        endingBalance: balance
      });
    }
    return list;
  }

  // Compile monthly schedule into yearly breakdowns
  function compileYearlySchedule(monthlySchedule: any[], initial: number) {
    const yearlyList = [];
    let cumDeposits = initial;
    let cumInterest = 0;
    
    for (let y = 1; y <= Math.ceil(monthlySchedule.length / 12); y++) {
      const yearStartIdx = (y - 1) * 12;
      const yearEndIdx = Math.min(y * 12 - 1, monthlySchedule.length - 1);
      
      const yearStart = monthlySchedule[yearStartIdx];
      const yearEnd = monthlySchedule[yearEndIdx];
      
      let yearDeposits = 0;
      let yearInterest = 0;
      
      for (let i = yearStartIdx; i <= yearEndIdx; i++) {
        yearDeposits += monthlySchedule[i].payment;
        yearInterest += monthlySchedule[i].interest;
      }
      
      cumDeposits += yearDeposits;
      cumInterest += yearInterest;

      yearlyList.push({
        year: y,
        startingBalance: yearStart.startingBalance,
        deposits: yearDeposits,
        interest: yearInterest,
        endingBalance: yearEnd.endingBalance,
        totalDeposits: cumDeposits,
        totalInterest: cumInterest
      });
    }
    return yearlyList;
  }

  function updateChart(yearlySchedule: any[]) {
    const canvas = document.getElementById('savings-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const labels = yearlySchedule.map(e => `Year ${e.year}`);
    const balances = yearlySchedule.map(e => e.endingBalance);
    const deposits = yearlySchedule.map(e => e.totalDeposits);

    if (chartInstance) {
      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = balances;
      chartInstance.data.datasets[1].data = deposits;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Total Accumulation',
              data: balances,
              borderColor: '#171717',
              backgroundColor: 'rgba(23, 23, 23, 0.05)',
              fill: true,
              tension: 0.15,
              borderWidth: 2,
              pointRadius: 0,
            },
            {
              label: 'Total Out-Of-Pocket Deposits',
              data: deposits,
              borderColor: '#0070f3',
              backgroundColor: 'rgba(0, 112, 243, 0.02)',
              fill: true,
              tension: 0.15,
              borderWidth: 1.5,
              pointRadius: 0,
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 8,
                padding: 12,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false
            }
          },
          scales: {
            x: {
              grid: { display: false },
              ticks: { maxTicksLimit: 10, font: { family: 'Geist Mono, monospace', size: 9 } }
            },
            y: {
              grid: { color: '#ebebeb' },
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
                }
              }
            }
          }
        }
      });
    }
  }

  function updateScheduleTable(yearlySchedule: any[]) {
    if (!scheduleBody) return;
    
    let html = '';
    yearlySchedule.forEach(e => {
      html += `
        <tr class="hover:bg-canvas-soft transition-colors font-mono text-xs text-ink">
          <td class="px-5 py-3 font-semibold text-body">Year ${e.year}</td>
          <td class="px-5 py-3 text-right">${formatCurrency(e.startingBalance)}</td>
          <td class="px-5 py-3 text-right">${formatCurrency(e.deposits)}</td>
          <td class="px-5 py-3 text-right text-link">${formatCurrency(e.interest)}</td>
          <td class="px-5 py-3 text-right font-medium">${formatCurrency(e.endingBalance)}</td>
          <td class="px-5 py-3 text-right text-mute">${formatCurrency(e.totalDeposits)}</td>
        </tr>
      `;
    });

    scheduleBody.innerHTML = html;
  }

  // Listeners
  compoundingSelect.addEventListener('change', performCalculation);
  timingCheckbox.addEventListener('change', performCalculation);
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  // Table toggle
  if (toggleScheduleBtn && scheduleWrapper) {
    toggleScheduleBtn.addEventListener('click', () => {
      const isHidden = scheduleWrapper.classList.contains('hidden');
      if (isHidden) {
        scheduleWrapper.classList.remove('hidden');
        toggleScheduleBtn.textContent = 'Hide Detailed Table';
      } else {
        scheduleWrapper.classList.add('hidden');
        toggleScheduleBtn.textContent = 'Show Detailed Table';
      }
    });
  }

  // Initial calculation
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', performCalculation);
</script>
