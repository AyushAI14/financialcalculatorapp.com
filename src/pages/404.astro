---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found - FinCompute">
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <p class="text-7xl font-bold text-ink tracking-tight">404</p>
    <h1 class="text-2xl font-semibold text-ink mt-4">Page not found</h1>
    <p class="text-body mt-2 max-w-md">
      The page you're looking for doesn't exist or has been moved. Check the URL or head back to our calculators.
    </p>
    <div class="flex gap-4 mt-8">
      <a
        href="/"
        class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity"
      >
        Back to Home
      </a>
      <a
        href="/#categories-section"
        class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm"
      >
        Browse Calculators
      </a>
    </div>
  </div>
</Layout>
