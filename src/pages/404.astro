---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
---

<Layout title={`${t('404.title', 'Page Not Found')} | financialcalculatorapp.com`} lang={lang} noindex={true}>
  <div class="flex flex-col items-center justify-center min-h-[60vh] text-center px-4">
    <p class="text-7xl font-bold text-ink tracking-tight">404</p>
    <h1 class="text-2xl font-semibold text-ink mt-4">{t('404.heading', 'Page not found')}</h1>
    <p class="text-body mt-2 max-w-md">
      {t('404.desc', "The page you're looking for doesn't exist or has been moved. Check the URL or head back to our calculators.")}
    </p>
    <div class="flex gap-4 mt-8">
      <a
        href={translatePath('/')}
        class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity"
      >
        {t('nav.home', 'Home')}
      </a>
      <a
        href={translatePath('/calculators')}
        class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm"
      >
        {t('hero.browse', 'Browse Calculators')}
      </a>
    </div>
  </div>
</Layout>
