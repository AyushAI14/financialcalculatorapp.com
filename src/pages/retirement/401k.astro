---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
---

<CalculatorLayout 
  title="401k Calculator" 
  description="Calculate your 401k retirement balance growth. Optimize tax savings, employer matching percentages, and salary increase parameters."
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="four-oh-one-k-form" class="space-y-6">
        <!-- Salary Details -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">Income & Contributions</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="md:col-span-2">
              <Input id="salary" label="Annual Salary" type="number" prefix="$" value="95000" />
            </div>
            <Input id="salary-growth" label="Salary Increase" type="number" suffix="%" value="3.0" />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2 border-t border-hairline/60">
            <Input id="contribution-pct" label="Your Contribution Rate" type="number" suffix="%" value="8.0" />
            <Input id="tax-rate" label="Marginal Tax Rate" type="number" suffix="%" value="24" />
          </div>
        </div>

        <!-- Employer Matching Details -->
        <div class="bg-canvas border border-hairline p-5 rounded-lg shadow-sm space-y-4">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-2 border-b border-hairline pb-2">Employer Matching Rules</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="match-pct" label="Employer Match Pct" type="number" suffix="%" value="50" placeholder="e.g. 50% match" />
            <Input id="max-match-pct" label="Matching Limit" type="number" suffix="%" value="6.0" placeholder="e.g. up to 6% of salary" />
          </div>
          <p class="text-[11px] text-mute leading-normal">
            * **Employer Match**: The percentage of your contribution the employer matches (e.g., 50% match means they add $0.50 for every $1.00 you contribute).
            <br/>
            * **Matching Limit**: The maximum salary percentage the employer will match (e.g., up to 6% of your salary).
          </p>
        </div>

        <!-- General Parameters -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-5 bg-canvas-soft border border-hairline rounded-md">
          <div class="md:col-span-2">
            <Input id="current-balance" label="Current 401k Balance" type="number" prefix="$" value="25000" />
          </div>
          <Input id="years" label="Years to Save" type="number" value="25" />
          <div class="md:col-span-3 pt-2 border-t border-hairline/60">
            <Input id="return-rate" label="Expected Investment Return" type="number" suffix="%" value="7.5" />
          </div>
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            Calculate Growth
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            Clear
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Charts) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-ending">
          <ResultCard title="Projected 401k" value="$784,100" highlight={true} description="Estimated balance at the end of the saving period." />
        </div>
        <div id="res-matching">
          <ResultCard title="Company Match" value="$114,100" description="Total matching funds paid by your employer." />
        </div>
        <div id="res-tax">
          <ResultCard title="Pre-tax Tax Savings" value="$45,600" description="Total income tax savings on pre-tax contributions." />
        </div>
      </div>

      <!-- Growth Chart Card -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">401k Growth Composition</h4>
        <div class="h-80 relative">
          <canvas id="growth-chart"></canvas>
        </div>
      </div>
    </div>
  </div>

  <!-- Detailed Year-by-Year Schedule -->
  <div class="mt-12 border-t border-hairline pt-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h3 class="text-xl font-semibold tracking-[-0.8px] text-ink">401k Year-by-Year Schedule</h3>
        <p class="text-sm text-body mt-1">Detailed compound projection listing salary increases, employee deposits, employer matching, and tax savings.</p>
      </div>
      <button 
        id="toggle-schedule" 
        class="px-4 py-2 border border-hairline rounded-md text-xs font-mono font-medium bg-canvas hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer"
      >
        Show Annual Schedule
      </button>
    </div>

    <div id="schedule-wrapper" class="hidden border border-hairline rounded-lg overflow-hidden shadow-sm">
      <div class="overflow-x-auto max-h-[450px]">
        <table class="w-full border-collapse text-left text-sm">
          <thead class="sticky top-0 bg-canvas-soft border-b border-hairline font-mono text-xs uppercase text-mute z-10">
            <tr>
              <th class="px-5 py-3">Year</th>
              <th class="px-5 py-3 text-right">Salary</th>
              <th class="px-5 py-3 text-right">Employee Deposits</th>
              <th class="px-5 py-3 text-right">Employer Match</th>
              <th class="px-5 py-3 text-right">Interest</th>
              <th class="px-5 py-3 text-right">Ending Bal</th>
              <th class="px-5 py-3 text-right">Annual Tax Saved</th>
            </tr>
          </thead>
          <tbody id="schedule-body" class="divide-y divide-hairline">
            <!-- Dynamically populated -->
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Educational SEO Section -->
  <article class="mt-20 max-w-4xl prose prose-sm text-body leading-relaxed border-t border-hairline pt-12 space-y-8">
    <div>
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink mb-3">Maximizing Your 401k Employer Match.</h2>
      <p>
        A <strong>401k</strong> is a retirement savings plan sponsored by an employer. It lets workers save and invest a piece of their paycheck before taxes are taken out. One of the single greatest benefits of a 401k plan is the <strong>employer matching contribution</strong>, which represents guaranteed, free money.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">The "Free Money" Rule</h3>
        <p class="text-sm">
          If your employer matches 50% of your contributions up to 6% of your salary, and you earn $100,000:
        </p>
        <ul class="list-disc pl-5 mt-2 space-y-1 text-xs text-mute">
          <li>If you contribute 6% ($6,000), your company contributes an additional 3% ($3,000) for free. That represents a **guaranteed 50% immediate return** on your investment!</li>
          <li>If you contribute only 4% ($4,000), you only get a $2,000 company match, leaving $1,000 of free cash on the table. Always contribute at least enough to capture the full employer match!</li>
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold tracking-[-0.6px] text-ink mb-2">Pre-tax Tax Advantages</h3>
        <p class="text-sm">
          Contributions to a traditional 401k are made pre-tax, which means they reduce your taxable income for the year. 
        </p>
        <p class="text-xs text-mute mt-2">
          If you contribute $10,000 and sit in a 24% marginal tax bracket, your take-home pay only drops by $7,600, while the full $10,000 goes into your account to compound. That is an immediate tax savings of $2,400!
        </p>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="border-t border-hairline pt-12 space-y-6">
      <h2 class="text-2xl font-semibold tracking-[-0.96px] text-ink">Frequently Asked Questions.</h2>
      <div class="divide-y divide-hairline">
        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How long will my 401(k) last in retirement?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              How long your 401(k) lasts depends on your nest egg size, withdrawal rate, investment return, and inflation. Using a standard **4% safe withdrawal rule**, a 401(k) is statistically highly likely to last 30 years or more. Use our Retirement Planner for a comprehensive simulation.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much will my 401(k) pay me per month?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Under the 4% rule, if you retire with a $1,000,000 401(k) balance, you can withdraw $40,000 in your first year. This translates to **$3,333 per month** (adjusted upward for inflation each subsequent year).
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much should I contribute to my 401(k)?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              At a minimum, contribute enough to **capture your full employer match** (typically 3% to 6% of salary). Beyond that, financial planners recommend contributing **10% to 15%** of your income toward retirement to build a secure nest egg.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much will my 401(k) be worth at retirement?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Your ending balance is based on your current balance, monthly additions, employer match size, and annual interest rates. Enter your parameters into this calculator to view your projected ending balance and annual compound growth chart.
            </p>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much should I have in my 401(k)?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              A common rule of thumb (Fidelity guidelines) is to save multiples of your salary by age milestones:
            </p>
            <ul class="list-disc pl-5 mt-2 space-y-1 text-xs text-mute">
              <li><strong>Age 30</strong>: 1x annual salary.</li>
              <li><strong>Age 40</strong>: 3x annual salary.</li>
              <li><strong>Age 50</strong>: 6x annual salary.</li>
              <li><strong>Age 67</strong>: 10x annual salary.</li>
            </ul>
          </div>
        </details>

        <details class="group py-4">
          <summary class="flex items-center justify-between text-base font-medium text-ink cursor-pointer list-none focus:outline-none">
            <span>How much can 401(k) contributions reduce my taxes?</span>
            <svg class="w-4 h-4 text-mute transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
          </summary>
          <div class="mt-3 text-sm text-body leading-relaxed space-y-2">
            <p>
              Traditional 401(k) contributions reduce your gross taxable income dollar-for-dollar. If you earn $95,000 and contribute $15,000, your taxable income drops to $80,000. In a 24% marginal tax bracket, this reduces your annual federal income tax bill by **$3,600**.
            </p>
          </div>
        </details>
      </div>
    </div>
  </article>
</CalculatorLayout>

<script>
  import { simulate401KPath } from '../../lib/math/retirement';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('four-oh-one-k-form') as HTMLFormElement;
  
  const salaryInput = document.getElementById('salary') as HTMLInputElement;
  const salaryGrowthInput = document.getElementById('salary-growth') as HTMLInputElement;
  const contributionPctInput = document.getElementById('contribution-pct') as HTMLInputElement;
  const taxRateInput = document.getElementById('tax-rate') as HTMLInputElement;
  
  const matchPctInput = document.getElementById('match-pct') as HTMLInputElement;
  const maxMatchPctInput = document.getElementById('max-match-pct') as HTMLInputElement;
  
  const currentBalanceInput = document.getElementById('current-balance') as HTMLInputElement;
  const yearsInput = document.getElementById('years') as HTMLInputElement;
  const returnRateInput = document.getElementById('return-rate') as HTMLInputElement;

  const resEndingCard = document.getElementById('res-ending');
  const resMatchingCard = document.getElementById('res-matching');
  const resTaxCard = document.getElementById('res-tax');

  const toggleScheduleBtn = document.getElementById('toggle-schedule');
  const scheduleWrapper = document.getElementById('schedule-wrapper');
  const scheduleBody = document.getElementById('schedule-body');

  let chartInstance: Chart | null = null;

  // Run simulation
  function performCalculation() {
    const annualSalary = parseFloat(salaryInput.value) || 0;
    const salaryIncreaseRate = (parseFloat(salaryGrowthInput.value) || 0) / 100;
    const contributionPct = (parseFloat(contributionPctInput.value) || 0) / 100;
    const taxRate = (parseFloat(taxRateInput.value) || 0) / 100;
    
    const employerMatchPct = (parseFloat(matchPctInput.value) || 0) / 100;
    const employerMaxMatchPct = (parseFloat(maxMatchPctInput.value) || 0) / 100;
    
    const current401kBalance = parseFloat(currentBalanceInput.value) || 0;
    const yearsToRetire = parseInt(yearsInput.value) || 10;
    const annualReturn = (parseFloat(returnRateInput.value) || 0) / 100;

    const schedule = simulate401KPath({
      annualSalary,
      salaryIncreaseRate,
      contributionPct,
      current401kBalance,
      employerMatchPct,
      employerMaxMatchPct,
      annualReturn,
      taxRate,
      yearsToRetire
    });

    const finalYear = schedule[schedule.length - 1];

    // Summarize cumulative matching and tax savings
    let totalMatching = 0;
    let totalTaxSavings = 0;
    schedule.forEach(e => {
      totalMatching += e.employerMatch;
      totalTaxSavings += e.taxSavings;
    });

    // Update Result Cards
    if (resEndingCard) resEndingCard.querySelector('.font-mono')!.textContent = formatCurrency(finalYear.endingBalance);
    if (resMatchingCard) resMatchingCard.querySelector('.font-mono')!.textContent = formatCurrency(totalMatching);
    if (resTaxCard) resTaxCard.querySelector('.font-mono')!.textContent = formatCurrency(totalTaxSavings);

    // Update Chart
    updateChart(schedule, current401kBalance);
    // Update Table
    updateScheduleTable(schedule);
  }

  function updateChart(schedule: any[], initial: number) {
    const canvas = document.getElementById('growth-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const labels = schedule.map(e => `Yr ${e.year}`);
    
    // Accumulate total employee contributions, employer match, and interest growth
    let cumEmployee = initial; // Seed starting balance in employee bucket for simplicty
    let cumEmployer = 0;
    
    const employeeData = schedule.map(e => {
      cumEmployee += e.employeeContributions;
      return cumEmployee;
    });
    const employerData = schedule.map(e => {
      cumEmployer += e.employerMatch;
      return cumEmployer;
    });
    const interestData = schedule.map(e => {
      const totalDeposits = e.employeeContributions + e.employerMatch;
      // Growth is Ending Balance - Starting Balance - Deposits
      return Math.max(0, e.endingBalance - (e.startingBalance + totalDeposits));
    });
    
    // Accumulate interest growth cumulatively
    let cumInterest = 0;
    const interestCumData = interestData.map(val => {
      cumInterest += val;
      return cumInterest;
    });

    if (chartInstance) {
      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = employeeData;
      chartInstance.data.datasets[1].data = employerData;
      chartInstance.data.datasets[2].data = interestCumData;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: labels,
          datasets: [
            {
              label: 'Your Contributions',
              data: employeeData,
              backgroundColor: '#171717',
              borderColor: '#171717',
              borderWidth: 1,
              stack: 'stack0'
            },
            {
              label: 'Employer Matching',
              data: employerData,
              backgroundColor: '#a1a1a1',
              borderColor: '#a1a1a1',
              borderWidth: 1,
              stack: 'stack0'
            },
            {
              label: 'Investment Growth',
              data: interestCumData,
              backgroundColor: '#0070f3',
              borderColor: '#0070f3',
              borderWidth: 1,
              stack: 'stack0'
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'top',
              labels: {
                boxWidth: 8,
                padding: 12,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              mode: 'index',
              intersect: false
            }
          },
          scales: {
            x: {
              grid: { display: false },
              stacked: true,
              ticks: { maxTicksLimit: 12, font: { family: 'Geist Mono, monospace', size: 9 } }
            },
            y: {
              grid: { color: '#ebebeb' },
              stacked: true,
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + Number(value).toLocaleString('en-US', { maximumFractionDigits: 0 });
                }
              }
            }
          }
        }
      });
    }
  }

  function updateScheduleTable(schedule: any[]) {
    if (!scheduleBody) return;
    
    let html = '';
    schedule.forEach(e => {
      html += `
        <tr class="hover:bg-canvas-soft transition-colors font-mono text-xs text-ink">
          <td class="px-5 py-3 font-semibold text-body">Year ${e.year}</td>
          <td class="px-5 py-3 text-right">${formatCurrency(e.salary)}</td>
          <td class="px-5 py-3 text-right text-link">${formatCurrency(e.employeeContributions)}</td>
          <td class="px-5 py-3 text-right text-mute">${formatCurrency(e.employerMatch)}</td>
          <td class="px-5 py-3 text-right text-mute">${formatCurrency(e.interest)}</td>
          <td class="px-5 py-3 text-right font-medium">${formatCurrency(e.endingBalance)}</td>
          <td class="px-5 py-3 text-right text-link">${formatCurrency(e.taxSavings)}</td>
        </tr>
      `;
    });

    scheduleBody.innerHTML = html;
  }

  // Listeners
  const inputs = [
    salaryInput, salaryGrowthInput, contributionPctInput, taxRateInput,
    matchPctInput, maxMatchPctInput, currentBalanceInput, yearsInput, returnRateInput
  ];

  inputs.forEach(el => {
    el.addEventListener('input', performCalculation);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  // Table toggle
  if (toggleScheduleBtn && scheduleWrapper) {
    toggleScheduleBtn.addEventListener('click', () => {
      const isHidden = scheduleWrapper.classList.contains('hidden');
      if (isHidden) {
        scheduleWrapper.classList.remove('hidden');
        toggleScheduleBtn.textContent = 'Hide Annual Schedule';
      } else {
        scheduleWrapper.classList.add('hidden');
        toggleScheduleBtn.textContent = 'Show Annual Schedule';
      }
    });
  }

  // Initial calculation
  performCalculation();
</script>
