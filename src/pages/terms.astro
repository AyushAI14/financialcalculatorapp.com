---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={t('terms.title', 'Terms of Service')} description={t('terms.intro')} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('terms.heading', 'Terms of Service.')}</h1>
    <p class="text-xs text-mute font-mono uppercase tracking-wider">{t('terms.lastUpdated', 'Last updated: October 2026')}</p>
    
    <p>
      {t('terms.intro')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('terms.sec1.heading', '1. Acceptance of Terms')}</h2>
    <p>
      {t('terms.sec1.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('terms.sec2.heading', '2. Permitted Educational & Personal Use')}</h2>
    <p>
      {t('terms.sec2.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('terms.sec3.heading', '3. Limitation of Liability & No Warranty')}</h2>
    <p>
      {t('terms.sec3.text')}
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">{t('terms.sec4.heading', '4. Modifications to Service')}</h2>
    <p>
      {t('terms.sec4.text')}
    </p>
  </article>
</Layout>
