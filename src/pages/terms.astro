---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
---

<Layout title={`${t('nav.terms', 'Terms of Service')} - FinCompute`} lang={lang}>
  <article class="max-w-3xl mx-auto prose prose-sm text-body leading-relaxed space-y-6">
    <h1 class="text-4xl font-semibold tracking-[-1.6px] text-ink mb-8">{t('nav.terms', 'Terms of Service')}.</h1>
    <p class="text-xs text-mute font-mono uppercase tracking-wider">{t('calc.lastUpdated', 'Last updated')}: July 10, 2026</p>
    
    <p>
      Please read these Terms of Service carefully before using the FinCompute suite of financial calculators.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">1. Acceptance of Terms</h2>
    <p>
      By accessing or using our website, you agree to comply with and be bound by these Terms of Service. If you do not agree, please do not use our application.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">2. Permitted Use</h2>
    <p>
      Our suite of calculators is provided free of charge for personal, educational, and informational purposes. Commercial extraction, scraping, or automatic querying of our calculators is prohibited.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">3. Limitation of Liability</h2>
    <p>
      FinCompute does not guarantee the mathematical accuracy, timeliness, or completeness of any calculation results. In no event shall FinCompute be liable for any direct or indirect damages arising out of your reliance on our tools. All actions you take are at your own financial risk.
    </p>

    <h2 class="text-xl font-semibold tracking-[-0.6px] text-ink mt-8">4. Modifications to Service</h2>
    <p>
      We reserve the right to alter, update, suspend, or discontinue any portion of our suite of calculators at any time without notice or liability.
    </p>
  </article>
</Layout>
