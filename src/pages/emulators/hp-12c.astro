---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const isEs = lang === 'es';
const isDe = lang === 'de';
const isJa = lang === 'ja';
const isPt = lang === 'pt';

const faqsEn = [
  {
    question: "What is an HP 12C financial calculator and why is it used?",
    answer: "The HP 12C is the gold standard programmable financial calculator created by Hewlett-Packard in 1981. It is renowned for its durability, Reverse Polish Notation (RPN) efficiency, and is one of the few calculators permitted on the CFA, CFP, and Real Estate appraiser certification examinations."
  },
  {
    question: "How does Reverse Polish Notation (RPN) work on the HP 12C?",
    answer: "RPN eliminates the need for parentheses and an equals key. You enter numbers first onto a 4-level stack (X, Y, Z, T), and then press the operator. For example, to add 25 and 15, you press [2][5] [ENTER] [1][5] [+], giving 40 immediately."
  },
  {
    question: "How do I calculate Time Value of Money (TVM) on this emulator?",
    answer: "Store your known values into the TVM registers (n for periods, i for interest rate, PV for present value, PMT for payment, FV for future value). Press the key of the unknown variable to solve for it. Remember financial sign conventions: cash outflows are entered with CHS (negative)."
  },
  {
    question: "Can I use my physical computer keyboard with this emulator?",
    answer: "Yes! Use your computer numpad or number keys for digits 0-9, Enter for the ENTER stack key, standard arithmetic keys (+, -, *, /), and Backspace to clear the entry."
  }
];

const faqsEs = [
  {
    question: "¿Qué es la calculadora financiera HP 12C y por qué se utiliza?",
    answer: "La HP 12C es la calculadora financiera de referencia absoluta creada por Hewlett-Packard en 1981. Destaca por su fiabilidad, el sistema de Notación Polaca Inversa (RPN) y es una de las pocas calculadoras permitidas en los exámenes oficiales CFA, CFP y certificaciones de tasación inmobiliaria."
  },
  {
    question: "¿Cómo funciona la Notación Polaca Inversa (RPN) en la HP 12C?",
    answer: "El sistema RPN elimina la necesidad de paréntesis y de tecla igual. Primero introduces los números en una pila de 4 niveles (X, Y, Z, T) y después pulsas la operación. Por ejemplo, para sumar 25 y 15, pulsas [2][5] [ENTER] [1][5] [+], obteniendo 40 de inmediato."
  },
  {
    question: "¿Cómo se calcula el Valor del Dinero en el Tiempo (TVM) en este emulador?",
    answer: "Guarda los valores conocidos en los registros de TVM (n para periodos, i para tasa de interés, PV para valor actual, PMT para pago periódico, FV para valor futuro). Pulsa la tecla de la variable desconocida para calcularla. Recuerda la convención de signos: las salidas de dinero se introducen con signo negativo mediante la tecla CHS."
  },
  {
    question: "¿Puedo usar el teclado físico de mi ordenador con este emulador?",
    answer: "¡Sí! Utiliza el teclado numérico o las teclas numéricas del 0 al 9, Enter para la tecla ENTER de la pila, las teclas estándar (+, -, *, /) y Retroceso (Backspace) para borrar."
  }
];

const faqsDe = [
  {
    question: "Was ist der Finanzrechner HP 12C und warum wird er verwendet?",
    answer: "Der HP 12C ist der 1981 von Hewlett-Packard eingeführte Goldstandard unter den programmierbaren Finanzrechnern. Er ist berühmt für seine Langlebigkeit, die Effizienz der Umgekehrten Polnischen Notation (UPN/RPN) und ist einer der wenigen Taschenrechner, die bei offiziellen CFA-, CFP- und Immobilien-Sachverständigenprüfungen zugelassen sind."
  },
  {
    question: "Wie funktioniert die Umgekehrte Polnische Notation (UPN/RPN) beim HP 12C?",
    answer: "UPN macht Klammern und eine Gleichheitstaste überflüssig. Sie geben Zahlen zuerst auf einen 4-stufigen Stack (X, Y, Z, T) ein und drücken anschließend die Rechenoperation. Um beispielsweise 25 und 15 zu addieren, drücken Sie [2][5] [ENTER] [1][5] [+], was sofort 40 ergibt."
  },
  {
    question: "Wie berechne ich Zinseszins und Zeitwert des Geldes (TVM) auf diesem Emulator?",
    answer: "Speichern Sie die bekannten Werte in den TVM-Registern (n für Laufzeit/Perioden, i für Zinssatz, PV für Barwert, PMT für regelmäßige Rate, FV für Endwert). Drücken Sie die Taste der gesuchten Variablen, um diese zu berechnen. Beachten Sie Vorzeichenkonventionen: Geldabflüsse werden mit CHS als negativer Betrag eingegeben."
  },
  {
    question: "Kann ich meine Tastatur mit diesem Emulator verwenden?",
    answer: "Ja! Nutzen Sie den Nummernblock oder die Zifferntasten 0–9, Enter für den Stack-Eintrag (ENTER), die Standard-Rechenzeichen (+, -, *, /) und die Rücktaste (Backspace) zum Löschen."
  }
];

const faqsJa = [
  {
    question: "HP 12C金融電卓とは何ですか？なぜ選ばれるのですか？",
    answer: "HP 12Cは、1981年にヒューレット・パッカード社が開発したプログラム可能な金融電卓の世界的スタンダードです。高い堅牢性と逆ポーランド記法（RPN）による計算の高速性が特徴で、米国証券アナリスト（CFA）やファイナンシャルプランナー（CFP）、不動産鑑定士試験での持ち込みが公式認定されています。"
  },
  {
    question: "HP 12Cの逆ポーランド記法（RPN）はどのように操作しますか？",
    answer: "RPN記法ではカッコや等号［＝］キーが不要です。まず4段スタック（X, Y, Z, T）に数値を入力し、その後に演算子キーを押します。例えば25＋15を計算する場合、［2］［5］［ENTER］［1］［5］［＋］と入力すると即座に40が表示されます。"
  },
  {
    question: "このエミュレータで貨幣の時間価値（TVM）を計算する方法は？",
    answer: "判明している数値を各TVMレジスタ（期間 n、年利 i、現在価値 PV、毎月支払額 PMT、将来価値 FV）に代入し、求めたい変数のキーを押すだけで算出されます。金融計算の符号規約に従い、現金の流出（支払い）は［CHS］キーでマイナス値にして入力してください。"
  },
  {
    question: "パソコンのキーボードでエミュレータを操作できますか？",
    answer: "はい！テンキーや数字キー［0-9］、スタック入力の［Enter］、四則演算キー［＋, －, ＊, ／］、入力取り消しの［Backspace］など、PCキーボードショートカットで実機同様に快適に操作できます。"
  }
];

const faqsPt = [
  {
    question: "O que é a calculadora HP 12C e por que ela é o padrão financeiro no Brasil?",
    answer: "A HP 12C é a calculadora financeira mais famosa do mundo, lançada pela Hewlett-Packard em 1981. No Brasil, ela é o padrão absoluto e obrigatório no mercado bancário, corretoras de investimentos, mercado imobiliário e faculdades de Economia, Administração, Ciências Contábeis e Engenharia. Além disso, é a calculadora formalmente homologada para exames de certificação do mercado financeiro, como ANBIMA (CPA-10, CPA-20, CEA), CFP e perícia contábil/judicial. Sua popularidade decorre da precisão matemática indiscutível, algoritmos consolidados de juros compostos e extrema velocidade operacional proporcionada pela Notação Polonesa Reversa (RPN)."
  },
  {
    question: "Calculadora HP 12C como usar: como somar e fazer cálculos básicos com a lógica RPN?",
    answer: "Diferente das calculadoras tradicionais, a HP 12C não possui a tecla de igual (=) nem parênteses. Ela opera com Notação Polonesa Reversa (RPN) e uma pilha de 4 registradores (X, Y, Z, T). Para somar, você insere o primeiro número, pressiona [ENTER] para salvá-lo na pilha, digita o segundo número e aperta a operação [+]. Exemplo: para somar 25 + 15, tecle [2][5] [ENTER] [1][5] [+]. O visor exibe imediatamente 40.00. Para subtrair 40 - 10: tecle [4][0] [ENTER] [1][0] [-]. Para multiplicar 8 × 7: [8] [ENTER] [7] [×]. Esse sistema elimina a necessidade de rascunhos e parênteses em cálculos financeiros encadeados."
  },
  {
    question: "Como calcular juros compostos e valor futuro (FV) na HP 12C?",
    answer: "Para calcular o valor futuro (FV) com juros compostos: 1) Limpe os registradores financeiros teclando [f] [FIN]. 2) Digite o valor presente (capital inicial), inverta o sinal com [CHS] (convenção financeira para saída de caixa/investimento) e tecle [PV] (ex: 5000 [CHS] [PV]). 3) Digite a taxa de juros periódica e tecle [i] (ex: 1.2 [i] para 1,2% ao mês). 4) Digite o número de períodos e tecle [n] (ex: 24 [n] para 24 meses). 5) Pressione a tecla [FV]. O emulador calculará instantaneamente o montante acumulado de R$ 6.649,22."
  },
  {
    question: "O que significa PMT na HP 12C e como calcular a prestação na Tabela Price?",
    answer: "PMT significa 'Payment' (pagamento periódico ou prestação fixa). Na matemática financeira e no crédito bancário brasileiro (financiamento imobiliário e veicular pelo Sistema Francês / Tabela Price), o PMT calcula o valor exato da parcela mensal constante. Para calcular a prestação de um empréstimo de R$ 30.000 em 36 parcelas a 1,5% ao mês: tecle [f] [FIN], depois 30000 [PV], 1.5 [i], 36 [n] e pressione [PMT]. O visor exibirá -1.085,82 (sinal negativo indicando pagamento/saída mensal de caixa)."
  },
  {
    question: "Como calcular o prazo (n) em juros compostos na HP 12C?",
    answer: "Para saber em quanto tempo um capital atinge determinado valor com juros compostos: 1) Limpe as variáveis financeiras com [f] [FIN]. 2) Insira o valor inicial negativo em [PV] (ex: 10000 [CHS] [PV]). 3) Insira o valor futuro desejado em [FV] (ex: 20000 [FV] para dobrar o patrimônio). 4) Digite a taxa de juros do período em [i] (ex: 1 [i] para 1% a.m.). 5) Pressione a tecla [n]. A HP 12C exibirá 70 meses (lembrando que a calculadora sempre arredonda para cima frações de período quando calcula n)."
  },
  {
    question: "Como calcular juros simples na HP 12C?",
    answer: "Para calcular juros simples na HP 12C, utiliza-se a função amarela [f] [INT] (Interest). O procedimento padrão da HP é: 1) Digite o número de dias e tecle [n]. 2) Digite a taxa de juros anual e tecle [i]. 3) Digite o valor do capital com sinal negativo e tecle [PV] (ex: 12000 [CHS] [PV]). 4) Pressione [f] [INT]. O visor exibirá os juros simples acumulados com base no ano comercial de 360 dias (neste exemplo, R$ 540,00). Pressionando [+] em seguida, você obtém o montante total com o capital: R$ 12.540,00."
  },
  {
    question: "Como calcular o Custo Efetivo Total (CET) na HP 12C?",
    answer: "O Custo Efetivo Total (CET) mede a taxa real de um financiamento no Brasil, somando juros nominais, IOF, TAC e seguros. Para calculá-lo na HP 12C: 1) Em [PV], lance o valor líquido que realmente foi creditado na sua conta com sinal negativo [CHS] [PV] (ex: empréstimo de R$ 10.000 com R$ 500 de taxas descontadas = 9500 [CHS] [PV]). 2) Em [PMT], insira o valor bruto da prestação que você pagará ao banco. 3) Em [n], insira a quantidade de parcelas. 4) Pressione [i]. A taxa encontrada é a taxa periódica mensal do CET. Para o CET anual, basta capitalizar a taxa mensal para 12 meses."
  },
  {
    question: "Como programar e calcular taxas equivalentes na HP 12C (ao mês vs ao ano)?",
    answer: "No regime de juros compostos, uma taxa anual deve ser convertida para taxa equivalente ao mês pela fórmula (1 + i_ano) = (1 + i_mes)^12. Para converter uma taxa Selic de 13,25% ao ano para taxa mensal na HP 12C: tecle [1] [ENTER] [1][3][.][2][5] [ENTER] [1][0][0] [÷] [+] (resulta 1,1325), depois [1] [ENTER] [1][2] [÷] (resulta 0,08333), depois [y^x], depois [1] [-] [1][0][0] [×]. O visor exibirá 1,041% ao mês. Para o inverso (mês para ano), insira o fator mensal (ex: 1.015), eleve a 12 com [1][2] [y^x] e subtraia 1 multiplicando por 100."
  },
  {
    question: "Como zerar a HP 12C, como resetar e limpar a memória (f CLX, f REG e f FIN)?",
    answer: "A HP 12C possui diferentes níveis de limpeza: 1) Para limpar apenas o visor: tecle [CLX] (Clear X). 2) Para limpar as 5 variáveis financeiras (n, i, PV, PMT, FV): tecle a tecla amarela [f] seguida de [CLX] (função CLEAR FIN). É fundamental fazer isso antes de cada cálculo para não usar resíduos de contas anteriores! 3) Para limpar todos os registradores operacionais, memórias 0 a 9 e estatística: tecle [f] [REG]. 4) Reset de fábrica completo do aparelho físico: desligue a calculadora, segure a tecla de menos [-] e pressione [ON]."
  },
  {
    question: "Como aumentar ou alterar as casas decimais na HP 12C?",
    answer: "Para ajustar a quantidade de casas decimais exibidas no visor LCD da HP 12C, pressione a tecla de função amarela [f] seguida do número de casas desejado (entre 0 e 9). Exemplo: [f] [2] para o padrão financeiro de 2 casas (0.00), [f] [4] para 4 casas decimais (0.0000, muito usado em taxas de juros e câmbio) e [f] [9] para visualizar a precisão máxima do visor. Vale lembrar que a HP 12C sempre preserva até 10 dígitos internamente, mesmo que o visor exiba apenas 2 casas arredondadas."
  },
  {
    question: "O que é o erro 'Pr Error' na HP 12C e como resolver?",
    answer: "'Pr Error' significa Programming Error (Erro de Programação). Ele costuma acontecer quando o usuário pressiona por engano a tecla [f] [P/R], fazendo a calculadora entrar em modo de programação, ou quando uma rotina de programa tenta acessar uma memória inválida ou vazia. Para resolver e sair do Pr Error: pressione qualquer tecla (como [CLX] ou [f] [P/R]) para retornar ao modo de cálculo imediato. Se o erro ocorrer na calculadora física e não sair, retire as pilhas por 30 segundos ou efetue o reset segurando [-] e [ON]."
  },
  {
    question: "Qual a diferença entre a calculadora HP 12C Gold e a HP 12C Platinum?",
    answer: "A HP 12C Gold (Dourada) é o modelo tradicional lançado em 1981, operando exclusivamente com notação RPN, com memória para 99 passos de programação e processador clássico. A HP 12C Platinum (Prata/Preta) é uma evolução moderna: permite alternar entre o modo RPN e o modo Algébrico convencional (ALG com parênteses), possui memória expandida para 399 passos (4 vezes mais), processador até 6 vezes mais veloz para resolver taxas internas de retorno (TIR/IRR) complexas e conta com tecla dedicada de Backspace. Nosso emulador web reproduz as funções da Platinum, permitindo alternar entre RPN e ALG."
  },
  {
    question: "Preciso fazer download da calculadora HP 12C ou o emulador online é grátis?",
    answer: "Você não precisa fazer download nem instalar nenhum arquivo executável (.exe ou APK suspeito). Nosso emulador da calculadora financeira HP 12C online é 100% gratuito, seguro e roda diretamente no navegador de qualquer dispositivo: computador (Windows, Mac, Linux), notebook, tablet, celular Android ou iPhone. Além de não consumir armazenamento do seu aparelho, todas as operações são processadas localmente no seu navegador com total privacidade."
  },
  {
    question: "Quanto custa uma calculadora HP 12C física no Brasil vs emulador online?",
    answer: "No mercado brasileiro, uma calculadora física original HP 12C nova custa em média entre R$ 320,00 e R$ 580,00 (dependendo do modelo Gold ou Platinum e da cotação do dólar). Para estudantes, concurseiros e profissionais que precisam realizar cálculos financeiros rápidos no dia a dia do trabalho ou nos estudos, o emulador online grátis do financialcalculatorapp.com oferece a mesma confiabilidade matemática sem nenhum custo."
  }
];

const faqs = isEs ? faqsEs : (isDe ? faqsDe : (isJa ? faqsJa : (isPt ? faqsPt : faqsEn)));
---

<CalculatorLayout 
  title={isPt ? "calc.hp12c.name" : (isEs ? "calc.hp12c.name" : (isDe ? "HP 12C Rechner Online - Interaktiver Finanz-Emulator" : (isJa ? "HP 12C 金融電卓 オンライン - インタラクティブRPNエミュレーター" : "calc.hp12c.name")))} 
  seoTitle={isPt ? "calc.hp12c.seoTitle" : (isEs ? "calc.hp12c.seoTitle" : (isDe ? "HP 12C Rechner Online: Interaktiver UPN-Emulator | financialcalculatorapp.com" : (isJa ? "HP 12C 金融電卓 オンライン: 無料のRPNエミュレーター | financialcalculatorapp.com" : "calc.hp12c.seoTitle")))}
  description={isPt ? "calc.hp12c.desc" : (isEs ? "calc.hp12c.desc" : (isDe ? "Kostenloser Online-Emulator des Finanzrechners HP 12C: Umgekehrte Polnische Notation (UPN/RPN), TVM-Löser, Tilgung und Cashflow-Analyse mit Tastaturkürzeln." : (isJa ? "無料のHP 12C金融電卓オンラインエミュレーター。本物の逆ポーランド記法（RPN）、TVMレジスタ、元利均等償還表、キャッシュフロー分析をブラウザ上で完全再現。" : "calc.hp12c.desc")))}
  faqs={faqs}
  calcKey="hp-12c"
>
  <div class="w-full space-y-8">
    <!-- Emulator Header & Mode Selector -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 p-4 bg-canvas border border-hairline rounded-lg shadow-sm">
      <div>
        <h2 class="text-base font-semibold text-ink">{isEs ? "Emulador Web Hewlett-Packard HP 12C Platinum" : (isDe ? "Hewlett-Packard HP 12C Platinum Web-Emulator" : (isJa ? "Hewlett-Packard HP 12C Platinum Webエミュレーター" : (isPt ? "Emulador Web Hewlett-Packard HP 12C Platinum & Gold" : "Hewlett-Packard HP 12C Platinum Web Emulator")))}</h2>
        <p class="text-xs text-mute">{isEs ? "Pila RPN y Motor Financiero TVM con Soporte Completo de Atajos de Teclado" : (isDe ? "UPN/RPN-Stack und TVM-Finanzrechenwerk mit voller Tastaturunterstützung" : (isJa ? "RPNスタック＆TVM金融演算エンジン（フルキーボードショートカット対応）" : (isPt ? "Pilha RPN e Motor Financeiro TVM com Suporte Completo a Atalhos de Teclado Físico" : "RPN Stack & TVM Financial Engine with Full Keyboard Hotkey Support")))}</p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs font-mono text-mute">{isEs ? "Modo:" : (isDe ? "Modus:" : (isJa ? "モード:" : (isPt ? "Modo:" : "Mode:")))}</span>
        <button id="mode-toggle-btn" class="px-3 py-1 bg-primary text-on-primary text-xs font-mono rounded-full font-medium shadow-sm transition-colors cursor-pointer">
          {isEs ? "Modo RPN" : (isDe ? "RPN/UPN-Modus" : (isJa ? "RPNモード" : (isPt ? "Modo RPN" : "RPN Mode")))}
        </button>
      </div>
    </div>

    <!-- The HP 12C Physical Device Frame -->
    <div id="emulator-frame" class="relative bg-neutral-900 border-2 border-neutral-700/80 rounded-2xl p-6 sm:p-8 shadow-2xl text-neutral-100 max-w-2xl mx-auto select-none">
      
      <!-- Top Metallic Faceplate & LCD Display -->
      <div class="bg-neutral-800/90 border border-neutral-700 rounded-xl p-4 mb-6 shadow-inner">
        <div class="flex justify-between items-center mb-2 px-1">
          <span class="text-[11px] font-mono tracking-widest text-amber-400 font-bold">hp 12c platinum</span>
          <div class="flex gap-2 text-[10px] font-mono">
            <span id="flag-f" class="hidden text-amber-400 font-bold">f</span>
            <span id="flag-g" class="hidden text-sky-400 font-bold">g</span>
            <span id="flag-bgn" class="hidden text-amber-300 font-bold">BEGIN</span>
            <span id="flag-mode" class="text-neutral-400 font-bold">RPN</span>
          </div>
        </div>

        <!-- Vintage LCD Display -->
        <div class="bg-[#9ba88d] text-[#1b2413] font-mono text-3xl sm:text-4xl px-4 py-3 rounded border-2 border-[#7e8c6e] text-right overflow-x-auto shadow-inner tracking-wider font-bold">
          <span id="lcd-display">0.00</span>
        </div>
      </div>

      <!-- Keypad Grid -->
      <div class="grid grid-cols-10 gap-1.5 sm:gap-2 text-[11px] font-mono">
        <!-- Row 1: TVM & Registers -->
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="n">
          <span class="text-[9px] text-amber-400 block">AMORT</span>
          <span>n</span>
          <span class="text-[9px] text-sky-400 block">12×</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="i">
          <span class="text-[9px] text-amber-400 block">INT</span>
          <span>i</span>
          <span class="text-[9px] text-sky-400 block">12÷</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="PV">
          <span class="text-[9px] text-amber-400 block">NPV</span>
          <span>PV</span>
          <span class="text-[9px] text-sky-400 block">CF0</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="PMT">
          <span class="text-[9px] text-amber-400 block">RND</span>
          <span>PMT</span>
          <span class="text-[9px] text-sky-400 block">CFj</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="FV">
          <span class="text-[9px] text-amber-400 block">IRR</span>
          <span>FV</span>
          <span class="text-[9px] text-sky-400 block">Nj</span>
        </button>

        <!-- Row 2: Modifiers & Math -->
        <button class="hp-key col-span-2 bg-amber-500 hover:bg-amber-400 text-neutral-900 font-bold" data-key="f">
          <span>f</span>
        </button>
        <button class="hp-key col-span-2 bg-sky-600 hover:bg-sky-500 text-neutral-100 font-bold" data-key="g">
          <span>g</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="STO">
          <span>STO</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="RCL">
          <span>RCL</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700 text-neutral-100" data-key="CHS">
          <span class="text-[9px] text-amber-400 block">DATE</span>
          <span>CHS</span>
          <span class="text-[9px] text-sky-400 block">BEG</span>
        </button>

        <!-- Row 3: Stack & Digits -->
        <button class="hp-key col-span-3 row-span-2 bg-neutral-700 hover:bg-neutral-600 text-neutral-100 font-bold flex flex-col items-center justify-center" data-key="ENTER">
          <span class="text-sm">ENTER</span>
        </button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700" data-key="7"><span>7</span></button>
        <button class="hp-key col-span-2 bg-neutral-800 hover:bg-neutral-700" data-key="8"><span>8</span></button>
