---
import Layout from '../layouts/Layout.astro';

const calculators = [
  {
    category: 'Finance & Investment',
    links: [
      { name: 'TVM Calculator', url: '/finance/tvm', badge: 'Popular' },
      { name: 'Compound Interest Calculator', url: '/finance/compound-interest' },
      { name: 'ROI Calculator', url: '/finance/roi' },
      { name: 'Savings Goal Calculator', url: '/finance/savings-goal' },
      { name: 'Stock Return Calculator', url: '/finance/stock-return' },
      { name: 'CAPM Calculator', url: '/finance/stock-return' },
      { name: 'Dividend Calculator', url: '/finance/dividend' },
    ]
  },
  {
    category: 'Loan & Mortgage',
    links: [
      { name: 'Loan Calculator', url: '/loan/calculator', badge: 'Updated' },
      { name: 'APR Calculator', url: '/loan/apr' },
      { name: 'Rent vs Buy Calculator', url: '/loan/rent-vs-buy' },
      { name: 'Home Affordability Calculator', url: '/loan/home-affordability' },
    ]
  },
  {
    category: 'Retirement',
    links: [
      { name: 'Retirement Planner', url: '/retirement/planner' },
      { name: '401k Contribution Calculator', url: '/retirement/401k' },
    ]
  },
  {
    category: 'Credit Card & Auto',
    links: [
      { name: 'Credit Card Payoff Calculator', url: '/credit-card/payoff' },
      { name: 'Auto Loan Calculator', url: '/auto/loan' },
    ]
  },
  {
    category: 'Miscellaneous',
    links: [
      { name: 'Tip Calculator', url: '/misc/tip' },
      { name: 'Discount and Tax Calculator', url: '/misc/discount' },
    ]
  }
];
---

<Layout title="Financial Calculators - Premium Tools for Modern Finance">
  <!-- Interactive Math Watermark Background (Full Page Dense Pattern) -->
  <svg class="absolute inset-x-0 top-16 bottom-0 w-full h-full pointer-events-none select-none z-0 text-ink/[0.22] dark:text-ink/[0.10]" fill="none" stroke="currentColor" stroke-width="1">
    <defs>
      <pattern id="math-pattern" width="240" height="240" patternUnits="userSpaceOnUse">
        <!-- Faint Graph Paper Grid Lines -->
        <path d="M 0 120 L 240 120 M 120 0 L 120 240" stroke="currentColor" stroke-opacity="0.1" stroke-dasharray="1 4" />

        <!-- Right Triangle -->
        <path d="M 10 30 L 40 30 L 40 10 Z" />
        <path d="M 35 30 L 35 25 L 40 25" />
        <text x="10" y="38" font-family="monospace" font-size="7" fill="currentColor">a²+b²=c²</text>

        <!-- FV Formula -->
        <text x="60" y="15" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor">FV=PV(1+r)ⁿ</text>
        
        <!-- % sign -->
        <text x="10" y="58" font-family="monospace" font-size="11" fill="currentColor">%</text>

        <!-- Derivative -->
        <text x="160" y="20" font-family="monospace" font-size="9" fill="currentColor">dy/dx=f'(x)</text>
        <text x="160" y="35" font-family="monospace" font-size="9" fill="currentColor">∫x²dx=x³/3</text>

        <!-- Sine Wave Graph -->
        <path d="M 10 120 Q 25 100 40 120 T 70 120" stroke-width="1.2" />
        <text x="15" y="132" font-family="monospace" font-size="7" fill="currentColor">y=sin(x)</text>

        <!-- ROI Formula -->
        <text x="10" y="80" font-family="monospace" font-size="10" font-weight="bold" fill="currentColor">ROI=(G-C)/C</text>

        <!-- Limit formula -->
        <text x="90" y="50" font-family="monospace" font-size="9" fill="currentColor">lim(1+1/n)ⁿ=e</text>

        <!-- Normal Bell Curve -->
        <path d="M 130 110 C 150 110 155 110 162 90 C 169 70 174 70 181 90 C 188 110 193 110 213 110" stroke-width="1.2" />
        <text x="150" y="120" font-family="monospace" font-size="7" fill="currentColor">N(μ,σ²)</text>

        <!-- Venn Diagram -->
        <circle cx="105" cy="95" r="10" />
        <circle cx="115" cy="95" r="10" />
        <text x="106" y="97" font-family="monospace" font-size="6" fill="currentColor">A∩B</text>

        <!-- Sigma Summation -->
        <text x="100" y="160" font-family="monospace" font-size="10" fill="currentColor">Σ x_i = N*μ</text>

        <!-- CAGR Bar Chart -->
        <path d="M 10 205 L 55 205" />
        <rect x="15" y="190" width="6" height="15" />
        <rect x="25" y="180" width="6" height="25" />
        <rect x="35" y="170" width="6" height="35" />
        <text x="15" y="215" font-family="monospace" font-size="7" fill="currentColor">CAGR</text>

        <!-- Matrix -->
        <path d="M 125 180 L 120 180 L 120 210 L 125 210 M 150 180 L 155 180 L 155 210 L 150 210" />
        <text x="126" y="192" font-family="monospace" font-size="8" fill="currentColor">a b</text>
        <text x="126" y="204" font-family="monospace" font-size="8" fill="currentColor">c d</text>

        <!-- CAPM formula -->
        <text x="80" y="180" font-family="monospace" font-size="9" fill="currentColor">E(Ri)=Rf+β(Rm-Rf)</text>

        <!-- Pie Chart -->
        <circle cx="190" cy="180" r="15" />
        <path d="M 190 180 L 190 165 M 190 180 L 202 190" />
        <text x="210" y="183" font-family="monospace" font-size="7" fill="currentColor">π=3.14</text>

        <!-- Simple Interest -->
        <text x="120" y="230" font-family="monospace" font-size="10" fill="currentColor">I = P*r*t</text>

        <!-- Integral -->
        <text x="15" y="230" font-family="monospace" font-size="10" fill="currentColor">∫ e^x dx = e^x</text>

        <!-- Scattered Symbols & Variables (Denser Filler) -->
        <text x="120" y="30" font-family="monospace" font-size="10" fill="currentColor">Σ</text>
        <text x="220" y="60" font-family="monospace" font-size="12" fill="currentColor">$</text>
        <text x="225" y="145" font-family="monospace" font-size="10" fill="currentColor">θ</text>
        <text x="80" y="100" font-family="monospace" font-size="10" fill="currentColor">λ</text>
        <text x="135" y="140" font-family="monospace" font-size="12" fill="currentColor">√</text>
        <text x="60" y="235" font-family="monospace" font-size="9" fill="currentColor">dx</text>
        <text x="170" y="225" font-family="monospace" font-size="10" fill="currentColor">β</text>
        <text x="100" y="220" font-family="monospace" font-size="12" fill="currentColor">α</text>
        <text x="220" y="215" font-family="monospace" font-size="10" fill="currentColor">Δ</text>
        <text x="10" y="150" font-family="monospace" font-size="11" fill="currentColor">x</text>
        <text x="145" y="70" font-family="monospace" font-size="9" fill="currentColor">y</text>
        <text x="50" y="115" font-family="monospace" font-size="10" fill="currentColor">z</text>
        <text x="80" y="70" font-family="monospace" font-size="12" fill="currentColor">π</text>
        <text x="180" y="75" font-family="monospace" font-size="9" fill="currentColor">e</text>
        <text x="110" y="130" font-family="monospace" font-size="10" fill="currentColor">∑</text>
        <text x="150" y="160" font-family="monospace" font-size="10" fill="currentColor">≈</text>
        <text x="190" y="230" font-family="monospace" font-size="12" fill="currentColor">∞</text>
        <text x="215" y="20" font-family="monospace" font-size="9" fill="currentColor">t</text>
        <text x="50" y="230" font-family="monospace" font-size="10" fill="currentColor">P</text>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#math-pattern)" />
  </svg>

  <!-- Hero Section -->
  <section class="relative py-24 text-center max-w-4xl mx-auto space-y-6 overflow-visible">
    <!-- Mesh Gradient Backdrop -->
    <div class="absolute -top-12 left-1/2 -translate-x-1/2 w-[140%] aspect-[2/1] max-w-[1200px] pointer-events-none opacity-[0.15] z-0" style="background: radial-gradient(circle at 50% 10%, #0070f3 0%, transparent 60%), radial-gradient(circle at 25% 20%, #7928ca 0%, transparent 50%), radial-gradient(circle at 75% 15%, #50e3c2 0%, transparent 50%), radial-gradient(circle at 50% 35%, #ff0080 0%, transparent 55%); filter: blur(70px);"></div>
    
    <div class="relative z-10 flex flex-col items-center space-y-6">
      <h1 class="text-5xl md:text-6xl font-semibold tracking-[-2.4px] text-ink leading-tight">
        Professional grade financial calculators.
      </h1>
      <p class="text-lg text-body max-w-2xl mx-auto">
        An elegant suite of tools for finance and investment, loans and mortgages, retirement planning, and more. Precise math with beautiful design.
      </p>
      <div class="pt-8 flex items-center justify-center gap-4">
        <a href="#categories-section" class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-primary text-on-primary font-medium hover:bg-ink/90 transition-colors shadow-md animate-fade-in">
          Browse Calculators
        </a>
      </div>
    </div>
  </section>

  <!-- Categories Grid -->
  <section id="categories-section" class="mt-16 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
    {calculators.map(cat => (
      <div class="bg-canvas border border-hairline rounded-lg p-6 hover:shadow-[0_2px_8px_rgba(0,0,0,0.08)] transition-all duration-200 flex flex-col h-full group relative overflow-hidden">
        
        <!-- Subtle Top Gradient Decoration -->
        <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-canvas to-canvas group-hover:from-canvas-soft group-hover:to-canvas-soft transition-colors"></div>

        <h2 class="text-lg font-semibold tracking-[-0.6px] mb-4 flex items-center justify-between">
          {cat.category}
          <svg class="w-4 h-4 text-mute opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
        </h2>
        
        <ul class="space-y-3 flex-1">
          {cat.links.map(link => (
            <li>
              <a href={link.url} class="group/link flex items-start gap-2.5 text-sm text-body hover:text-ink transition-colors py-1">
                <span class="w-1.5 h-1.5 rounded-full mt-1.5 flex-shrink-0 transition-colors bg-link group-hover/link:bg-link"></span>
                <span class="flex-1 min-w-0 leading-normal font-medium text-ink/90 group-hover/link:text-link">
                  {link.name}
                </span>
                {link.badge && (
                  <span class="ml-auto flex-shrink-0 text-[10px] uppercase font-mono tracking-wider px-1.5 py-0.5 rounded-full bg-canvas-soft border border-hairline text-mute">
                    {link.badge}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </section>
</Layout>
