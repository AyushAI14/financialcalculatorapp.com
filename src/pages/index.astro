---
import Layout from '../layouts/Layout.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

import { getLocalizedCategories, getAllCalculatorsFlat } from '../lib/calculators';

const categories = getLocalizedCategories(t);
const allCalculatorsFlat = getAllCalculatorsFlat(t);
---

<Layout title={t('site.title')} description={t('site.description')} lang={lang}>
  <!-- Hero Section -->
  <section class="text-center pt-8 pb-6 max-w-3xl mx-auto space-y-3">
    <div class="space-y-3">
      <h1 class="font-display font-black text-4xl sm:text-5xl md:text-6xl tracking-tight text-ink leading-tight">
        <span class="text-input-accent">{t('hero.accent', 'Financial Calculator')}</span> {t('hero.main', 'Online & Free Finance Tools')}
      </h1>
      <p class="text-sm sm:text-base text-muted font-sans max-w-xl mx-auto">
        {t('hero.desc', 'Fast, accurate online financial calculators that run 100% in your browser. Free, private, and calculated instantly with zero sign-up.')}
      </p>
    </div>
  </section>

  <!-- Search Composer -->
  <section class="max-w-2xl mx-auto mb-6" aria-label="Calculator search">
    <div class="composer">
      <label for="calc-search" class="block font-mono text-[11px] font-bold uppercase tracking-wider text-muted mb-2">
        {t('search.findLabel', 'Find an online financial calculator')}
      </label>
      <div class="relative flex items-center">
        <input
          type="text"
          id="calc-search"
          placeholder={t('search.placeholder', 'Search financial calculators (e.g. mortgage, 401k with match, tvm calculator, salary increase, investment)...')}
          autocomplete="off"
          spellcheck="false"
          class="w-full h-16 sm:h-20 bg-canvas text-ink text-lg sm:text-2xl font-display font-extrabold border-[1.5px] border-input-accent rounded-lg pl-5 pr-24 focus:outline-none focus:ring-2 focus:ring-input-accent transition-all placeholder:text-muted/50"
        />
        <button
          id="clear-search-btn"
          type="button"
          class="card-action absolute right-3 px-3.5 py-1.5 text-xs font-mono font-bold uppercase"
          aria-label="Clear search"
        >
          {t('search.clear', 'Clear')}
        </button>
      </div>
      <div class="flex items-center justify-between mt-2.5 px-1 font-mono text-xs text-muted">
        <span>🔒 {t('search.private', '100% private in browser')}</span>
        <span id="result-count-label" class="font-bold text-ink" data-template={t('search.counterTemplate', '{count} calculators')}>{allCalculatorsFlat.length} {t('search.calculators', 'calculators')}</span>
      </div>
    </div>

  </section>

  <!-- Filter Bar -->
  <div class="filter-panel relative max-w-4xl mx-auto mb-8" aria-label="Filter calculator categories">
    <button type="button" id="filter-scroll-left" class="filter-arrow left-0" aria-label={t('filter.scrollLeft', 'Scroll categories left')}>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <div class="filter-bar overflow-x-auto px-8 sm:px-10 py-1">
      <div class="filter-list flex items-center gap-2 justify-start flex-nowrap w-max max-w-none" role="group">
        <button class="filter-button is-active" type="button" data-filter="all">
          <span class="font-mono text-xs">✦</span>
          <span>{t('filter.all', 'All')}</span>
          <span class="filter-count">{allCalculatorsFlat.length}</span>
        </button>
        {categories.map(cat => (
          <button class="filter-button" type="button" data-filter={cat.key}>
            <span>{cat.icon}</span>
            <span>{cat.name}</span>
            <span class="filter-count">{cat.count}</span>
          </button>
        ))}
      </div>
    </div>
    <div class="filter-fade filter-fade-left" aria-hidden="true"></div>
    <div class="filter-fade filter-fade-right" aria-hidden="true"></div>
    <button type="button" id="filter-scroll-right" class="filter-arrow right-0" aria-label={t('filter.scrollRight', 'Scroll categories right')}>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
    </button>
  </div>

  <!-- Results Section Heading -->
  <div class="w-full flex items-end justify-between gap-4 mb-4">
    <div>
      <h2 class="font-display font-extrabold text-2xl sm:text-3xl tracking-tight text-ink" id="results-heading-title">
        {t('results.instant', 'Instant calculations')}
      </h2>
    </div>
    <div class="flex items-center gap-4 text-xs font-mono text-muted whitespace-nowrap">
      <span><span id="visible-cards-count">{allCalculatorsFlat.length}</span> {t('search.calculators', 'calculators')}</span>
      <span>·</span>
      <a href={translatePath('/calculators')} class="font-bold text-ink hover:underline">{t('results.fullDirectory', 'Full Directory →')}</a>
    </div>
  </div>

  <!-- Style Grid -->
  <section id="categories-section" class="w-full style-grid mb-16" aria-label="Calculators list">
    {allCalculatorsFlat.map(calc => (
      <a
        href={translatePath(calc.url)}
        class="style-card group cursor-pointer transition-all no-underline text-inherit"
        data-category={calc.categoryKey}
        data-name={calc.name.toLowerCase()}
        data-category-name={calc.categoryName.toLowerCase()}
        data-snippet={calc.snippet.toLowerCase()}
        data-keywords={(calc.keywords || []).join(' ').toLowerCase()}
        data-calc-id={calc.id}
      >
        <div class="flex items-start justify-between gap-2">
          <h3 class="font-display font-bold text-base sm:text-lg tracking-tight text-ink group-hover:text-input-accent transition-colors leading-snug">
            {calc.name}
          </h3>
          {calc.badge && (
            <span class="text-[9px] font-mono uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-soft text-ink border border-line shrink-0">
              {calc.badge}
            </span>
          )}
        </div>

        <div class="py-2 text-xs text-muted font-sans leading-relaxed group-hover:text-ink transition-colors flex items-start min-h-[44px]">
          <span class="line-clamp-2">{calc.snippet}</span>
        </div>

        <div class="flex items-center justify-between pt-2.5 border-t border-line/15 mt-auto">
          <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-muted truncate max-w-[170px] flex items-center gap-1">
            <span>{calc.icon}</span>
            <span>{calc.categoryName}</span>
          </span>
          <span
            class="card-action px-3 py-1.5 text-[11px] font-mono font-bold text-ink rounded-full"
          >
            {t('card.open', 'Open →')}
          </span>
        </div>
      </a>
    ))}
  </section>

  <!-- Empty Search Results State -->
  <div id="no-results-state" class="hidden max-w-md mx-auto text-center py-16 px-4 border border-ink rounded-lg bg-paper mb-16">
    <div class="text-3xl mb-3">🔍</div>
    <h3 class="font-display font-bold text-lg text-ink mb-1">{t('search.noResultsTitle', 'No calculators found')}</h3>
    <p class="text-xs text-muted mb-4">{t('search.noResultsDesc', 'Try searching for other terms like mortgage, 401k, or compound interest.')}</p>
    <button id="reset-filter-btn" type="button" class="card-action px-4 py-2 text-xs font-mono font-bold text-ink hover:bg-soft">
      {t('search.showAll', 'Show All Calculators')}
    </button>
  </div>

  <!-- "Identify Your Problem" Scenario Finder Section -->
  <section class="w-full py-12 border-t-2 border-line relative z-10 no-print">
    <div class="text-center max-w-xl mx-auto mb-10 space-y-2">
      <span class="px-3 py-1 bg-soft border border-line text-[10px] font-mono font-bold uppercase tracking-wider text-muted rounded-full inline-flex mb-2">{t('scenario.badge', 'Real-World Answers')}</span>
      <h2 class="font-display font-black text-2xl sm:text-3xl tracking-tight text-ink">{t('scenario.heading', 'What financial question are you trying to answer?')}</h2>
      <p class="text-xs text-muted font-sans">{t('scenario.subheading', 'Select your current financial crossroad to get immediate math-backed insights.')}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      <!-- Card 1: Debt Payoff -->
      <a href={translatePath('/compare/snowball-vs-avalanche')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">⚡</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.1.title', '"I have multiple debts. How do I pay them off fastest?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.1.desc', 'Simulate and compare the Debt Snowball vs. Debt Avalanche strategies using your own numbers. Calculate exactly how many months and how much interest you will save.')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.comparison', 'Comparison')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.1.cta', 'Compare Payoff Strategies →')}
          </span>
        </div>
      </a>

      <!-- Card 2: Retirement IRA -->
      <a href={translatePath('/compare/roth-vs-traditional-ira')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">📈</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.2.title', '"Should I put my savings in a Roth or Traditional IRA?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.2.desc', 'Model your ending portfolio values by comparing pre-tax versus post-tax compounding growth based on your current marginal tax bracket and expected retirement tax rate.')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.taxStrategy', 'Tax Strategy')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.2.cta', 'Run IRA Tax Comparison →')}
          </span>
        </div>
      </a>

      <!-- Card 3: Home Buying -->
      <a href={translatePath('/loan/home-affordability')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">🏠</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.3.title', '"How much house can I actually afford to purchase?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.3.desc', 'Avoid the standard online traps. Determine your safe purchasing budget based on the 28/36 rule, incorporating down payments, local taxes, insurance, and HOA fees.')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.mortgageMath', 'Mortgage Math')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.3.cta', 'Calculate Home Affordability →')}
          </span>
        </div>
      </a>

      <!-- Card 4: Loan fees (APR vs Nominal) -->
      <a href={translatePath('/compare/apr-vs-nominal')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">🏷️</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.4.title', '"How much do closing costs and fees increase my rate?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.4.desc', 'Lenders advertise low nominal interest rates, but closing fees raise your actual cost. Factor in all fees to calculate your true Annual Percentage Rate (APR).')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.hiddenFees', 'Hidden Fees')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.4.cta', 'Calculate True Loan APR →')}
          </span>
        </div>
      </a>

      <!-- Card 5: Auto Financing -->
      <a href={translatePath('/auto/loan')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">🚗</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.5.title', '"Will sales tax and auto fees exceed my down payment?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.5.desc', 'Calculate out-of-pocket costs for a car loan. Grade your loan structure against the 20/4/10 rule of thumb to see if you risk going underwater on the vehicle.')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.carLoan', 'Car Loan')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.5.cta', 'Analyze Auto Financing →')}
          </span>
        </div>
      </a>

      <!-- Card 6: Credit Card Payoff -->
      <a href={translatePath('/credit-card/payoff')} class="style-card p-6 flex flex-col justify-between space-y-4 group cursor-pointer no-underline text-inherit">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full border border-ink bg-soft flex items-center justify-center text-lg shadow-[var(--control-shadow)]">💳</div>
          <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors leading-snug">{t('scenario.6.title', '"How much interest will I pay if I only pay minimums?"')}</h3>
          <p class="text-xs text-muted leading-relaxed font-sans">{t('scenario.6.desc', 'Avoid the credit card minimum payment trap. Discover how many years it will take to be debt-free and calculate the massive interest savings from paying even $50 more.')}</p>
        </div>
        <div class="pt-2 border-t border-line/15 flex items-center justify-between">
          <span class="text-[10px] font-mono text-muted uppercase font-bold">{t('tag.debtFree', 'Debt Free')}</span>
          <span class="card-action px-3.5 py-2 text-[11px] font-mono font-bold text-ink rounded-full">
            {t('scenario.6.cta', 'Simulate Credit Payoff →')}
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Structured Data for Financial Calculator & Finance Calculator Search Queries -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "WebSite",
        "@id": "https://financialcalculatorapp.com/#website",
        "url": "https://financialcalculatorapp.com/",
        "name": "Financial Calculator Online",
        "alternateName": [
          "Finance Calculator",
          "Financial Calculator",
          "Online Financial Calculator",
          "Free Financial Calculator Online"
        ],
        "description": "Free online financial calculator suite with 40+ private browser-based finance calculators for loans, mortgages, retirement, TVM, and investments."
      },
      {
        "@type": "WebApplication",
        "@id": "https://financialcalculatorapp.com/#webapp",
        "name": "Financial Calculator Online",
        "url": "https://financialcalculatorapp.com/",
        "applicationCategory": "FinanceApplication",
        "operatingSystem": "All",
        "browserRequirements": "Requires JavaScript. Requires HTML5.",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Comprehensive suite of 40+ free online financial calculators and finance calculation tools running 100% privately in the browser."
      }
    ]
  })} />
</Layout>

<script>
  const searchInput = document.getElementById('calc-search') as HTMLInputElement | null;
  const clearBtn = document.getElementById('clear-search-btn');
  const resultCountLabel = document.getElementById('result-count-label');
  const visibleCardsCount = document.getElementById('visible-cards-count');
  const noResultsState = document.getElementById('no-results-state');
  const resetFilterBtn = document.getElementById('reset-filter-btn');
  const filterButtons = document.querySelectorAll('.filter-button');
  const cards = document.querySelectorAll<HTMLElement>('.style-card[data-calc-id]');

  // Horizontal filter panel: arrow buttons + edge fades
  const filterBar = document.querySelector('.filter-bar') as HTMLElement | null;
  const filterPrev = document.getElementById('filter-scroll-left') as HTMLButtonElement | null;
  const filterNext = document.getElementById('filter-scroll-right') as HTMLButtonElement | null;
  const fadeLeft = document.querySelector('.filter-fade-left') as HTMLElement | null;
  const fadeRight = document.querySelector('.filter-fade-right') as HTMLElement | null;

  function updateFilterChrome() {
    if (!filterBar) return;
    const maxScroll = filterBar.scrollWidth - filterBar.clientWidth;
    const atStart = filterBar.scrollLeft <= 4;
    const atEnd = filterBar.scrollLeft >= maxScroll - 4;
    const overflowing = maxScroll > 4;
    filterPrev?.classList.toggle('is-disabled', !overflowing || atStart);
    filterNext?.classList.toggle('is-disabled', !overflowing || atEnd);
    fadeLeft?.classList.toggle('is-hidden', !overflowing || atStart);
    fadeRight?.classList.toggle('is-hidden', !overflowing || atEnd);
  }

  filterPrev?.addEventListener('click', () => {
    filterBar?.scrollBy({ left: -320, behavior: 'smooth' });
  });
  filterNext?.addEventListener('click', () => {
    filterBar?.scrollBy({ left: 320, behavior: 'smooth' });
  });
  filterBar?.addEventListener('scroll', updateFilterChrome, { passive: true });
  window.addEventListener('resize', updateFilterChrome);
  updateFilterChrome();

  let activeFilter = 'all';

  // Filter and search executor
  function applyFilters() {
    const query = searchInput?.value.toLowerCase().trim() || '';
    let visibleCount = 0;

    cards.forEach((card) => {
      const name = card.dataset.name || '';
      const category = card.dataset.category || '';
      const categoryName = card.dataset.categoryName || '';
      const snippet = card.dataset.snippet || '';
      const keywords = card.dataset.keywords || '';

      const matchesQuery = !query || name.includes(query) || categoryName.includes(query) || snippet.includes(query) || keywords.includes(query);
      const matchesCategory = activeFilter === 'all' || category === activeFilter;

      if (matchesQuery && matchesCategory) {
        card.style.display = 'grid';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultCountLabel) {
      const template = resultCountLabel.getAttribute('data-template');
      if (template) {
        resultCountLabel.textContent = template.replace('{count}', String(visibleCount));
      } else {
        resultCountLabel.textContent = `${visibleCount} calculator${visibleCount === 1 ? '' : 's'}`;
      }
    }
    if (visibleCardsCount) {
      visibleCardsCount.textContent = String(visibleCount);
    }
    if (noResultsState) {
      noResultsState.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  // Search input events
  searchInput?.addEventListener('input', applyFilters);
  clearBtn?.addEventListener('click', () => {
    if (searchInput) {
      searchInput.value = '';
      searchInput.focus();
      applyFilters();
    }
  });

  // Filter button clicks
  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterButtons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeFilter = (btn as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });

  resetFilterBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeFilter = 'all';
    filterButtons.forEach((b) => {
      if ((b as HTMLElement).dataset.filter === 'all') {
        b.classList.add('is-active');
      } else {
        b.classList.remove('is-active');
      }
    });
    applyFilters();
  });

</script>
