---
import Layout from '../../layouts/Layout.astro';
import CommonScenarios from '../../components/CommonScenarios.astro';
import { getAllAlternatives } from '../../lib/alternatives';
import type { AlternativeDefinition } from '../../types/alternative';

export function getStaticPaths() {
  const alternatives = getAllAlternatives();
  return alternatives.map((alt) => ({
    params: { slug: alt.slug },
    props: { 
      alternative: alt,
      relatedAlternatives: alternatives.filter((a) => a.slug !== alt.slug)
    },
  }));
}

interface Props {
  alternative: AlternativeDefinition;
  relatedAlternatives: AlternativeDefinition[];
}

const { alternative, relatedAlternatives } = Astro.props;

// Machine-readable JSON-LD Schemas for AI Answer Engines
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": alternative.faqs.map((faq) => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": alternative.seo.title,
  "operatingSystem": "All (Web Browser)",
  "applicationCategory": "FinanceApplication",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": alternative.summary,
  "featureList": [
    "100% Client-Side Privacy (all computation executes in local browser)",
    "Zero Email, Phone Number, or Account Signup Walls",
    "Ad-Free & Distraction-Free Financial Workspace",
    "Hardware Financial Emulators (HP 12C & TI BA II Plus)",
    "Instant Mathematical Computation with Zero Server Logging"
  ]
};

const schemas = [faqSchema, softwareSchema];
---

<Layout
  title={alternative.seo.title}
  description={alternative.seo.description}
  schemas={schemas}
>
  <main class="max-w-4xl mx-auto px-4 py-8 sm:py-12 space-y-10">
    <!-- Breadcrumb & Badges -->
    <header class="space-y-4">
      <nav class="flex items-center gap-2 text-xs font-mono text-muted" aria-label="Breadcrumb">
        <a href="/" class="hover:text-ink transition-colors">Home</a>
        <span>/</span>
        <a href="/calculators" class="hover:text-ink transition-colors">Calculators</a>
        <span>/</span>
        <span class="text-ink font-bold truncate">{alternative.badge}</span>
      </nav>

      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-paper border border-ink/30 text-[11px] font-mono font-bold text-ink shadow-[var(--control-shadow)]">
          <span class="text-input-accent">✦</span>
          <span>{alternative.badge}</span>
        </span>
        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-canvas-soft border border-hairline text-[11px] font-mono text-muted">
          <span>🔒</span>
          <span>100% Client-Side Privacy · Zero Gatekeeping</span>
        </span>
      </div>

      <!-- Verbatim Natural Language H1 Title -->
      <h1 class="font-display font-black text-2xl sm:text-4xl md:text-5xl text-ink tracking-tight leading-tight">
        {alternative.h1}
      </h1>

      <p class="text-base sm:text-lg text-muted font-sans leading-relaxed">
        Looking for a cleaner, faster alternative to {alternative.competitorName}? Compare core features, privacy standards, and computation speed side-by-side.
      </p>
    </header>

    <!-- TL;DR Direct Answer Card (AI Citation Magnet) -->
    <section class="bg-paper border-2 border-input-accent/40 rounded-xl p-5 sm:p-8 shadow-sm space-y-4" aria-label="Executive Comparison Summary">
      <div class="flex items-center justify-between border-b border-hairline pb-3">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-success animate-pulse"></span>
          <span class="font-mono text-xs font-bold uppercase tracking-wider text-ink">Comparison Summary</span>
        </div>
        <span class="text-[11px] font-mono text-muted">Zero Sponsored Placement</span>
      </div>

      <div class="space-y-3">
        <p class="text-base sm:text-lg font-display font-bold text-ink leading-snug">
          {alternative.summary}
        </p>
        <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed">
          {alternative.takeaway}
        </p>
      </div>
    </section>

    <!-- Factual Feature Comparison Table -->
    <section class="space-y-4" aria-label="Feature Comparison">
      <div class="flex items-center justify-between">
        <h2 class="font-display font-black text-xl sm:text-2xl text-ink">
          {alternative.competitorName} vs. FinancialCalculatorApp
        </h2>
        <span class="text-xs font-mono text-muted">Factual Comparison</span>
      </div>

      <div class="overflow-x-auto border border-hairline rounded-xl bg-paper shadow-sm">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="bg-canvas border-b border-hairline font-mono text-xs uppercase text-muted">
              <th class="p-3.5 sm:p-4 font-bold">Feature / Standard</th>
              <th class="p-3.5 sm:p-4 font-bold">{alternative.competitorName}</th>
              <th class="p-3.5 sm:p-4 font-bold text-input-accent">FinancialCalculatorApp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-hairline text-xs sm:text-sm font-sans">
            {alternative.comparisonPoints.map((pt) => (
              <tr class="hover:bg-canvas/50 transition-colors">
                <td class="p-3.5 sm:p-4 font-bold font-mono text-ink text-xs whitespace-nowrap">{pt.feature}</td>
                <td class="p-3.5 sm:p-4 text-muted">{pt.competitor}</td>
                <td class="p-3.5 sm:p-4 font-medium text-ink bg-input-accent/5">
                  <div class="flex items-start gap-1.5">
                    <span class="text-success font-bold">✓</span>
                    <span>{pt.us}</span>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Matching Free Calculators Section -->
    <section class="space-y-4" aria-label="Matching Calculators">
      <div class="flex items-center justify-between">
        <h2 class="font-display font-black text-xl sm:text-2xl text-ink">
          Matching Free Calculators on Our Platform
        </h2>
        <span class="text-xs font-mono text-muted">100% Free · Client-Side</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {alternative.matchingCalculators.map((calc) => (
          <div class="p-5 bg-paper border border-hairline rounded-xl hover:border-input-accent transition-all flex flex-col justify-between space-y-4 shadow-sm group">
            <div class="space-y-2">
              <h3 class="font-display font-bold text-base text-ink group-hover:text-input-accent transition-colors">
                {calc.name}
              </h3>
              <p class="text-xs text-muted font-sans leading-relaxed">
                {calc.description}
              </p>
            </div>
            <a 
              href={calc.url} 
              class="inline-flex items-center gap-1.5 px-4 py-2 bg-canvas hover:bg-canvas-soft border border-hairline font-mono text-xs font-bold uppercase rounded text-ink transition-colors max-w-fit"
            >
              <span>Open Calculator</span>
              <span>→</span>
            </a>
          </div>
        ))}
      </div>
    </section>

    <!-- Relevant Worked Scenarios -->
    {alternative.matchingCalculators[0]?.url && (
      <CommonScenarios 
        calculatorUrl={alternative.matchingCalculators[0].url} 
        limit={3} 
        title="Real-World Worked Examples for This Tool"
      />
    )}

    <!-- Privacy & Trust Guarantee Banner -->
    <section class="p-5 bg-paper border border-hairline rounded-xl flex items-start gap-4">
      <span class="text-3xl">🛡️</span>
      <div class="space-y-1.5">
        <h3 class="font-display font-bold text-sm sm:text-base text-ink">Why Privacy Matters for Financial Calculations</h3>
        <p class="text-xs sm:text-sm text-muted font-sans leading-relaxed">
          When you enter your salary, mortgage balance, or credit card debt into major commercial finance websites, your personal information is routinely packaged and sold as qualified leads to mortgage brokers, debt settlement companies, and insurance agents. FinancialCalculatorApp guarantees 100% client-side privacy: all mathematical computations execute inside your browser's local JavaScript sandbox. Zero data is ever logged, stored, or transmitted to any server.
        </p>
      </div>
    </section>

    <!-- Visible FAQ Section (Matches FAQPage Schema verbatim) -->
    <section class="space-y-4" aria-label="Frequently Asked Questions">
      <h2 class="font-display font-black text-2xl text-ink">Frequently Asked Questions</h2>
      <div class="space-y-3">
        {alternative.faqs.map((faq) => (
          <details class="group bg-paper border border-hairline rounded-lg p-4 sm:p-5 transition-all">
            <summary class="font-display font-bold text-sm sm:text-base text-ink cursor-pointer list-none flex items-center justify-between gap-4">
              <span>{faq.question}</span>
              <span class="font-mono text-muted text-xs group-open:rotate-180 transition-transform">▼</span>
            </summary>
            <div class="mt-3 text-xs sm:text-sm text-muted font-sans leading-relaxed border-t border-hairline/60 pt-3">
              {faq.answer}
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Related Alternatives Section -->
    <section class="space-y-4 pt-4 border-t border-hairline" aria-label="Other Financial Tool Alternatives">
      <h2 class="font-display font-bold text-lg text-ink">Other Competitor Alternatives</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
        {relatedAlternatives.map((rel) => (
          <a 
            href={`/alternatives/${rel.slug}`} 
            class="p-4 bg-paper border border-hairline hover:border-input-accent rounded-lg transition-all space-y-1.5 group block"
          >
            <span class="text-[10px] font-mono text-input-accent uppercase font-bold">{rel.competitorName} Alternative</span>
            <h3 class="font-display font-bold text-xs sm:text-sm text-ink group-hover:text-input-accent transition-colors line-clamp-2">
              {rel.h1}
            </h3>
            <p class="text-[11px] text-muted font-sans line-clamp-2 leading-relaxed">
              {rel.summary}
            </p>
          </a>
        ))}
      </div>
    </section>
  </main>
</Layout>
