---
import Layout from '../../layouts/Layout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
---

<Layout 
  title="Roth IRA vs. Traditional IRA: Which is Better? - FinCompute.com" 
  description="Compare Roth and Traditional IRAs side-by-side to understand tax brackets, income limits, deductions, and tax-free retirement growth rules."
  lang={lang}
>
  <div class="max-w-6xl mx-auto py-8 px-4 space-y-12">
    <header class="border-b border-hairline pb-8 text-center sm:text-left space-y-2">
      <span class="px-2 py-0.5 bg-canvas-soft border border-hairline text-mute font-mono text-[10px] rounded-full uppercase">Comparison Guide</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-ink leading-tight">Roth IRA vs. Traditional IRA</h1>
      <p class="text-sm text-body max-w-2xl">A side-by-side comparison of the two main tax-advantaged retirement accounts in the United States.</p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Traditional -->
      <div class="border border-hairline bg-canvas p-6 rounded-lg shadow-sm space-y-4">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📉</span>
          <h2 class="text-xl font-bold text-ink">Traditional IRA</h2>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Contributions are made with **pre-tax dollars** (meaning they are tax-deductible in the year you make them). Earnings grow tax-deferred, but all withdrawals during retirement are taxed as ordinary income.
        </p>
        <ul class="space-y-2 text-xs text-mute list-disc pl-4">
          <li><strong>Tax Timing:</strong> Pay taxes later (during retirement).</li>
          <li><strong>Immediate Benefit:</strong> Deduct contributions to lower this year's taxable income.</li>
          <li><strong>Best If:</strong> Your tax bracket will be lower in retirement than it is now.</li>
        </ul>
      </div>

      <!-- Roth -->
      <div class="border border-hairline bg-canvas p-6 rounded-lg shadow-sm space-y-4 border-link/30">
        <div class="flex items-center gap-2">
          <span class="text-2xl text-link">📈</span>
          <h2 class="text-xl font-bold text-ink">Roth IRA</h2>
        </div>
        <p class="text-xs text-body leading-relaxed">
          Contributions are made with **post-tax dollars** (meaning you receive no immediate tax deduction). However, your investments grow 100% tax-free, and all qualified withdrawals in retirement are completely tax-free.
        </p>
        <ul class="space-y-2 text-xs text-mute list-disc pl-4">
          <li><strong>Tax Timing:</strong> Pay taxes now (when you contribute).</li>
          <li><strong>Retirement Benefit:</strong> Withdrawals of principal & gains are 100% tax-free.</li>
          <li><strong>Best If:</strong> Your tax bracket will be higher in retirement than it is now.</li>
        </ul>
      </div>
    </div>

    <!-- Comparative Table -->
    <div class="border border-hairline rounded-lg overflow-hidden bg-canvas shadow-sm max-w-4xl mx-auto">
      <table class="w-full border-collapse text-left text-xs">
        <thead class="bg-canvas-soft border-b border-hairline font-mono uppercase text-mute">
          <tr>
            <th class="px-5 py-3.5">Feature</th>
            <th class="px-5 py-3.5">Traditional IRA</th>
            <th class="px-5 py-3.5">Roth IRA</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-hairline text-body text-ink">
          <tr>
            <td class="px-5 py-3 font-semibold">Tax Deduction</td>
            <td class="px-5 py-3 font-semibold text-green-700 dark:text-green-400">Yes (reduces current tax bill)</td>
            <td class="px-5 py-3">No (contributed post-tax)</td>
          </tr>
          <tr>
            <td class="px-5 py-3 font-semibold">Retirement Withdrawals</td>
            <td class="px-5 py-3">Taxed as ordinary income</td>
            <td class="px-5 py-3 font-semibold text-green-700 dark:text-green-400">100% Tax-Free</td>
          </tr>
          <tr>
            <td class="px-5 py-3 font-semibold">Required Minimum Distributions (RMDs)</td>
            <td class="px-5 py-3">Required starting at age 73</td>
            <td class="px-5 py-3 font-semibold text-green-700 dark:text-green-400">None during owner's lifetime</td>
          </tr>
          <tr>
            <td class="px-5 py-3 font-semibold">Contribution Rules</td>
            <td class="px-5 py-3">Anyone with earned income can contribute</td>
            <td class="px-5 py-3">Subject to income limits (phases out at higher incomes)</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Embedded Calculator Section -->
    <section class="border-t border-hairline pt-12 space-y-6">
      <div class="text-center max-w-xl mx-auto space-y-2">
        <h2 class="text-2xl font-bold text-ink">Interactive IRA Strategy Comparison</h2>
        <p class="text-xs text-mute">Model your custom tax scenarios below to see which account yields the highest retirement value.</p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start max-w-5xl mx-auto bg-canvas p-6 border border-hairline rounded-xl shadow-sm">
        <!-- Left Column (Inputs) -->
        <div class="lg:col-span-6 space-y-6">
          <form id="ira-form" class="space-y-6">
            <div class="space-y-5">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-hairline pb-2 mb-2">
                <h3 class="text-xs font-mono text-mute uppercase tracking-wider">Your Profile</h3>
                <div class="flex flex-wrap items-center gap-1.5 no-print">
                  <span class="text-[10px] text-mute font-mono">Presets:</span>
                  <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-cage="30" data-rage="65" data-contrib="7000" data-rate="7.0" data-curtax="22" data-rettax="15">Low Future Tax</button>
                  <button type="button" class="preset-btn px-2 py-0.5 bg-canvas-soft hover:bg-canvas-soft-2 text-[10px] border border-hairline rounded transition-colors cursor-pointer" data-cage="25" data-rage="65" data-contrib="7000" data-rate="8.0" data-curtax="12" data-rettax="22">High Future Tax</button>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <Input id="current-age" label="Current Age" type="number" value="30" placeholder="30" />
                <Input id="retirement-age" label="Target Age" type="number" value="65" placeholder="65" />
              </div>

              <div class="grid grid-cols-2 gap-3 pt-3 border-t border-hairline/60">
                <Input id="contribution" label="Annual Contribution" type="number" prefix="$" value="7000" />
                <Input id="return-rate" label="Annual Return" type="number" suffix="%" value="7.0" />
              </div>

              <div class="grid grid-cols-2 gap-3 pt-3 border-t border-hairline/60">
                <Input id="current-tax" label="Current Tax Rate" type="number" suffix="%" value="22" />
                <Input id="retirement-tax" label="Retirement Tax Rate" type="number" suffix="%" value="15" />
              </div>
            </div>

            <div class="pt-2 border-t border-hairline flex gap-3">
              <button type="submit" class="px-6 py-2 bg-primary text-on-primary rounded-full font-medium text-xs hover:opacity-90 transition-opacity cursor-pointer">
                Compare IRAs
              </button>
              <button type="reset" id="reset-btn" class="px-6 py-2 bg-canvas text-ink border border-hairline rounded-full font-medium text-xs hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
                Clear
              </button>
            </div>
          </form>
        </div>

        <!-- Right Column (Results) -->
        <div class="lg:col-span-6 space-y-6">
          <div class="flex flex-col gap-3">
            <div id="res-winner">
              <ResultCard title="Advantage Winner" value="Roth IRA Wins" highlight={true} description="The plan that provides the highest net wealth at retirement." />
            </div>
            <div id="res-roth">
              <ResultCard title="Roth IRA Net Value" value="$1,037,682.00" />
            </div>
            <div id="res-traditional">
              <ResultCard title="Traditional Net Value" value="$882,029.70" />
            </div>
          </div>

          <!-- Chart -->
          <div class="bg-canvas border border-hairline rounded-lg p-4 shadow-sm">
            <h4 class="text-[10px] font-mono text-mute uppercase tracking-wider mb-2">Portfolio Projections</h4>
            <div class="h-64 relative">
              <canvas id="ira-chart"></canvas>
            </div>
          </div>

          <!-- Tax savings -->
          <div class="bg-canvas border border-hairline rounded-lg p-4 shadow-sm space-y-2">
            <h4 class="text-[10px] font-mono text-mute uppercase tracking-wider border-b border-hairline pb-1">Contribution Tax Savings</h4>
            <div class="text-xs space-y-2">
              <div class="flex justify-between">
                <span class="text-body font-medium">Annual Tax Saved (Traditional)</span>
                <span class="font-mono text-ink text-right" id="savings-annual">$1,540.00 / yr</span>
              </div>
              <div class="flex justify-between border-t border-hairline/60 pt-2">
                <span class="text-body font-medium">Cumulative Lifetime Tax Savings</span>
                <span class="font-mono text-ink text-right" id="savings-cum">$53,900.00</span>
              </div>
            </div>
          </div>

          <!-- Download CSV -->
          <div class="flex gap-4 no-print">
            <button id="download-csv-btn" class="w-full py-2 bg-canvas hover:bg-canvas-soft border border-hairline text-ink rounded-full text-xs font-semibold flex items-center justify-center gap-1.5 cursor-pointer shadow-sm transition-colors">
              <span>📊</span> Download Comparison CSV
            </button>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { compareIRA } from '../../lib/math/finance';
  import { formatCurrency } from '../../lib/utils';
  import { validateForm, validateField } from '../../lib/validation';
  import { downloadDataAsCSV } from '../../lib/csv-exporter';
  import Chart from 'chart.js/auto';

  const form = document.getElementById('ira-form') as HTMLFormElement;

  const currentAgeInput = document.getElementById('current-age') as HTMLInputElement;
  const retirementAgeInput = document.getElementById('retirement-age') as HTMLInputElement;
  const contributionInput = document.getElementById('contribution') as HTMLInputElement;
  const rateInput = document.getElementById('return-rate') as HTMLInputElement;
  const currentTaxInput = document.getElementById('current-tax') as HTMLInputElement;
  const retirementTaxInput = document.getElementById('retirement-tax') as HTMLInputElement;

  const resWinner = document.getElementById('res-winner');
  const resRoth = document.getElementById('res-roth');
  const resTrad = document.getElementById('res-traditional');

  const savingsAnnual = document.getElementById('savings-annual');
  const savingsCum = document.getElementById('savings-cum');

  let chartInstance: Chart | null = null;

  const validationRules = {
    'current-age': { required: true, min: 0, max: 100 },
    'retirement-age': {
      required: true,
      min: 1,
      max: 100,
      custom: (val: number) => {
        const cage = parseInt(currentAgeInput.value) || 0;
        return val <= cage ? 'Retirement age must be greater than current age.' : null;
      }
    },
    'contribution': { required: true, min: 1 },
    'return-rate': { required: true, min: 0, max: 100 },
    'current-tax': { required: true, min: 0, max: 100 },
    'retirement-tax': { required: true, min: 0, max: 100 }
  };

  function performCalculation() {
    if (!validateForm(validationRules)) {
      if (resWinner) resWinner.querySelector('.font-mono')!.textContent = '--';
      if (resRoth) resRoth.querySelector('.font-mono')!.textContent = '--';
      if (resTrad) resTrad.querySelector('.font-mono')!.textContent = '--';
      if (savingsAnnual) savingsAnnual.textContent = '--';
      if (savingsCum) savingsCum.textContent = '--';
      return;
    }

    const cage = parseInt(currentAgeInput.value);
    const rage = parseInt(retirementAgeInput.value);
    const contrib = parseFloat(contributionInput.value);
    const rate = parseFloat(rateInput.value) / 100;
    const curTax = parseFloat(currentTaxInput.value) / 100;
    const retTax = parseFloat(retirementTaxInput.value) / 100;

    const result = compareIRA(cage, rage, contrib, rate, curTax, retTax);

    let winnerText = 'Traditional IRA Wins';
    if (Math.abs(result.rothBalance - result.tradBalanceNet) < 1) {
      winnerText = 'Both Plans Equal';
    } else if (result.rothWins) {
      winnerText = 'Roth IRA Wins';
    }

    if (resWinner) {
      resWinner.querySelector('.font-mono')!.textContent = winnerText;
    }
    if (resRoth) resRoth.querySelector('.font-mono')!.textContent = formatCurrency(result.rothBalance);
    if (resTrad) resTrad.querySelector('.font-mono')!.textContent = formatCurrency(result.tradBalanceNet);

    const taxSavedAnnualVal = contrib * curTax;
    const taxSavedCumVal = taxSavedAnnualVal * (rage - cage);
    if (savingsAnnual) savingsAnnual.textContent = `${formatCurrency(taxSavedAnnualVal)} / yr`;
    if (savingsCum) savingsCum.textContent = formatCurrency(taxSavedCumVal);

    const labels = [];
    const rothData = [];
    const tradData = [];

    const years = rage - cage;
    for (let y = 0; y <= years; y++) {
      labels.push(`Age ${cage + y}`);
      const r = compareIRA(cage, cage + y, contrib, rate, curTax, retTax);
      rothData.push(r.rothBalance);
      tradData.push(r.tradBalanceNet);
    }

    updateChart(labels, rothData, tradData);
  }

  function updateChart(labels: string[], roth: number[], trad: number[]) {
    const canvas = document.getElementById('ira-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    if (chartInstance) {
      chartInstance.data.labels = labels;
      chartInstance.data.datasets[0].data = roth;
      chartInstance.data.datasets[1].data = trad;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Roth IRA (Tax-Free Net)',
              data: roth,
              borderColor: '#0070f3',
              backgroundColor: 'transparent',
              tension: 0.1,
              borderWidth: 2
            },
            {
              label: 'Traditional IRA (Post-Tax Net)',
              data: trad,
              borderColor: '#7928ca',
              backgroundColor: 'transparent',
              tension: 0.1,
              borderWidth: 2
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              labels: { font: { family: 'Geist, sans-serif', size: 9 } }
            }
          },
          scales: {
            x: {
              grid: { color: 'rgba(128, 128, 128, 0.08)' },
              ticks: { font: { family: 'Geist Mono, monospace', size: 9 } }
            },
            y: {
              grid: { color: 'rgba(128, 128, 128, 0.08)' },
              ticks: {
                font: { family: 'Geist Mono, monospace', size: 9 },
                callback: function(value) {
                  return '$' + value.toLocaleString();
                }
              }
            }
          }
        }
      });
    }
  }

  // Bind input listeners
  [currentAgeInput, retirementAgeInput, contributionInput, rateInput, currentTaxInput, retirementTaxInput].forEach(el => {
    el.addEventListener('input', () => {
      validateField(el.id, validationRules[el.id as keyof typeof validationRules]);
      performCalculation();
    });
  });

  // Preset scenarios click handlers
  document.querySelectorAll('.preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      currentAgeInput.value = target.dataset.cage || '0';
      retirementAgeInput.value = target.dataset.rage || '0';
      contributionInput.value = target.dataset.contrib || '0';
      rateInput.value = target.dataset.rate || '0';
      currentTaxInput.value = target.dataset.curtax || '0';
      retirementTaxInput.value = target.dataset.rettax || '0';

      [currentAgeInput, retirementAgeInput, contributionInput, rateInput, currentTaxInput, retirementTaxInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });

      performCalculation();
      currentAgeInput.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });

  // CSV Export handler
  const downloadCsvBtn = document.getElementById('download-csv-btn');
  downloadCsvBtn?.addEventListener('click', () => {
    if (!validateForm(validationRules)) return;
    const cage = parseInt(currentAgeInput.value);
    const rage = parseInt(retirementAgeInput.value);
    const contrib = parseFloat(contributionInput.value);
    const rate = parseFloat(rateInput.value) / 100;
    const curTax = parseFloat(currentTaxInput.value) / 100;
    const retTax = parseFloat(retirementTaxInput.value) / 100;

    const headers = ['Age', 'Roth IRA Net Value', 'Traditional IRA Net Value'];
    const rows = [];
    const years = rage - cage;
    for (let y = 0; y <= years; y++) {
      const r = compareIRA(cage, cage + y, contrib, rate, curTax, retTax);
      rows.push([cage + y, r.rothBalance.toFixed(2), r.tradBalanceNet.toFixed(2)]);
    }

    downloadDataAsCSV(headers, rows, `ira-comparison-${cage}-to-${rage}.csv`);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(() => {
      [currentAgeInput, retirementAgeInput, contributionInput, rateInput, currentTaxInput, retirementTaxInput].forEach(el => {
        el.classList.remove('border-error');
        const errEl = document.getElementById(`${el.id}-error`);
        if (errEl) errEl.classList.add('hidden');
      });
      performCalculation();
    }, 0);
  });

  // Initial Calculation
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', performCalculation);
</script>
