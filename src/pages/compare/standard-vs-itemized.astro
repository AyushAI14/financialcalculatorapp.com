---
import Layout from '../../layouts/Layout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import ExpertReviewBadge from '../../components/ui/ExpertReviewBadge.astro';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const isEs = lang === 'es';
const isDe = lang === 'de';
const isJa = lang === 'ja';
const isPt = lang === 'pt';
const isFr = lang === 'fr';

const pageTitle = isEs 
  ? "Deducción Estándar vs. Detallada: Calculadora y Comparación Fiscal"
  : (isDe 
    ? "Pauschalbetrag vs. Einzelabzug: Steuervergleich & Rechner"
    : (isFr
      ? "Déduction Forfaitaire vs. Frais Réels : Comparatif Fiscal & Simulateur"
      : (isJa 
        ? "基礎控除・標準控除 vs. 項目別所得控除：徹底税金シミュレーター"
        : (isPt 
          ? "Dedução Padrão vs. Dedução Detalhada: Calculadora e Comparação Fiscal"
          : "Standard vs. Itemized Deduction Calculator: Which Saves More Tax?"))));

const pageDesc = isEs
  ? "Calcula y compara si te conviene la deducción estándar o detallar gastos (Schedule A). Incluye límites SALT, intereses hipotecarios y donaciones."
  : (isDe
    ? "Berechnen Sie, ob der Pauschalbetrag oder der Einzelnachweis von Werbungskosten mehr Steuern spart. Mit SALT-Höchstgrenzen und Zinsabzug."
    : (isFr
      ? "Calculez et comparez s'il est plus avantageux d'opter pour la déduction forfaitaire ou de déduire vos frais réels. Intègre les plafonds fiscaux, intérêts d'emprunt et dons."
      : (isJa
        ? "米国・主要国の標準控除（Standard Deduction）と項目別控除（Itemized）を比較。住宅ローン利息、寄付金、SALT上限を自動計算。"
        : (isPt
          ? "Calcule e compare se vale mais a pena optar pela dedução padrão simplificada ou detalhada. Simule limites de impostos, juros imobiliários e doações."
          : "Calculate whether the standard deduction or itemized deductions (Schedule A) saves you more money. Includes SALT caps, mortgage interest, and charitable donations."))));

const faqsEn = [
  {
    question: "What is the difference between standard and itemized deductions?",
    answer: "The standard deduction is a fixed dollar amount that reduces your taxable income, determined by your filing status and age. Itemized deductions allow you to list individual qualified expenses—such as mortgage interest, charitable donations, state/local taxes up to $10,000, and large medical expenses. You should always choose whichever deduction amount is larger to minimize your tax liability."
  },
  {
    question: "What is the SALT deduction limit?",
    answer: "Under the Tax Cuts and Jobs Act (TCJA), the State and Local Tax (SALT) deduction is capped at $10,000 per year ($5,000 if married filing separately). This cap includes property taxes, state income taxes, or local sales taxes."
  },
  {
    question: "Can I deduct medical expenses on Schedule A?",
    answer: "Yes, but only unreimbursed medical and dental expenses that exceed 7.5% of your Adjusted Gross Income (AGI). For example, if your AGI is $100,000, only medical expenses exceeding $7,500 can be included in your itemized deductions."
  },
  {
    question: "What is 'charitable bunching' and how does it help?",
    answer: "Charitable bunching is a tax planning strategy where you consolidate two or three years of charitable giving into a single calendar year. By giving a larger cumulative gift in one year, your itemized deductions exceed the standard deduction threshold, allowing you to maximize tax savings in the gifting year while claiming the standard deduction in alternating years."
  },
  {
    question: "Does taking the standard deduction mean I can't claim any other tax breaks?",
    answer: "No. You can still claim 'above-the-line' deductions (adjustments to income) even if you take the standard deduction. These include contributions to Traditional IRAs, Health Savings Accounts (HSAs), student loan interest deductions up to $2,500, and educator expenses."
  }
];

const faqsEs = [
  {
    question: "¿Cuál es la diferencia entre la deducción estándar y la detallada?",
    answer: "La deducción estándar es una cantidad fija prefijada por la ley fiscal según tu estado civil y edad que reduce directamente tu base imponible. Las deducciones detalladas te permiten enumerar gastos reales específicos, como intereses hipotecarios, donaciones caritativas, impuestos estatales y locales (hasta el tope de 10.000 $) y gastos médicos extraordinarios. Conviene elegir siempre el importe que sea mayor para minimizar tu carga tributaria."
  },
  {
    question: "¿Cuál es el límite máximo de la deducción SALT?",
    answer: "Bajo la ley fiscal TCJA, la deducción por Impuestos Estatales y Locales (SALT) está limitada a un máximo de 10.000 $ anuales (5.000 $ si estás casado y declaras por separado). Este límite incluye impuestos sobre bienes inmuebles, impuestos estatales sobre la renta o impuestos locales sobre las ventas."
  },
  {
    question: "¿Puedo deducir los gastos médicos en las deducciones detalladas?",
    answer: "Sí, pero únicamente los gastos médicos y dentales no reembolsados por el seguro que superen el 7,5% de tu Ingreso Bruto Ajustado (AGI). Por ejemplo, si tu AGI es de 100.000 $, sólo la parte de tus gastos médicos que sobrepase los 7.500 $ puede incluirse como deducción detallada."
  },
  {
    question: "¿Qué es la acumulación estratégica de donaciones (charitable bunching)?",
    answer: "Es una técnica de planificación fiscal que consiste en concentrar las aportaciones benéficas de varios años en un único ejercicio fiscal. Al realizar una donación agrupada más grande, tus deducciones detalladas superan holgadamente la deducción estándar en ese año, maximizando el ahorro fiscal, mientras que en los años siguientes te acoges a la deducción estándar general."
  },
  {
    question: "¿Elegir la deducción estándar me impide aplicar otras ventajas fiscales?",
    answer: "No. Puedes seguir deduciendo conceptos directamente por encima de la línea (above-the-line), tales como aportaciones a planes de pensiones o cuentas IRA Tradicionales, cuentas de ahorro para la salud (HSA) y hasta 2.500 $ en intereses de préstamos estudiantiles."
  }
];

const faqsDe = [
  {
    question: "Was ist der Unterschied zwischen Pauschalbetrag und Einzelnachweis von Abzügen?",
    answer: "Der Pauschalbetrag (Standard Deduction) ist ein fester Steuerfreibetrag, der das zu versteuernde Einkommen mindert, ohne dass Belege eingereicht werden müssen. Beim Einzelnachweis (Itemized Deductions) listen Sie abzugsfähige tatsächliche Ausgaben auf – etwa Hypothekenzinsen, Spenden, örtliche Steuern und hohe Krankheitskosten. Sie sollten stets die Methode wählen, die den höheren Gesamtabzug ergibt."
  },
  {
    question: "Was ist die Höchstgrenze für den SALT-Abzug?",
    answer: "Für staatliche und lokale Steuern (State and Local Tax / SALT) gilt eine jährliche Höchstgrenze von 10.000 $ (5.000 $ bei getrennter Veranlagung von Ehegatten). Dieser Deckel umfasst Grundsteuern, staatliche Einkommensteuern oder lokale Umsatzsteuern."
  },
  {
    question: "Können außergewöhnliche Krankheitskosten steuerlich geltend gemacht werden?",
    answer: "Ja, jedoch nur nicht erstattete medizinische und zahnärztliche Aufwendungen, die 7,5 % des bereinigten Bruttoeinkommens (AGI) übersteigen. Bei einem Einkommen von 100.000 $ ist nur der Betrag absetzbar, der über 7.500 $ liegt."
  },
  {
    question: "Was versteht man unter 'Bunching' von Spenden?",
    answer: "Beim 'Bunching' bündeln Steuerzahler planbare Spenden mehrerer Jahre in einem einzigen Kalenderjahr. Dadurch übersteigen die Einzelabzüge den Pauschalbetrag in diesem Jahr deutlich, was eine spürbare Steuerersparnis bringt, während in den Folgejahren wieder der Pauschalbetrag gewählt wird."
  },
  {
    question: "Verhindert die Wahl des Pauschalbetrags andere steuerliche Abzüge?",
    answer: "Nein. Direkte Vorwegabzüge ('above-the-line deductions') wie Beiträge zur Altersvorsorge, Krankenversicherungsbeiträge oder Bildungskreditzinsen können auch bei Nutzung des Pauschalbetrags voll steuermindernd geltend gemacht werden."
  }
];

const faqsFr = [
  {
    question: "Quelle est la différence entre la déduction forfaitaire et les déductions réelles ?",
    answer: "La déduction forfaitaire (Standard Deduction) est un abattement fiscal fixe déterminé par la loi selon votre situation familiale, sans aucun justificatif à produire. Les déductions réelles (Itemized Deductions) consistent à comptabiliser vos dépenses admissibles réelles (intérêts d'emprunt immobilier, taxes foncières et locales, dons aux œuvres, frais de santé élevés). Vous avez toujours intérêt à retenir la formule qui vous offre la déduction la plus importante pour réduire votre base imposable."
  },
  {
    question: "Quel est le plafond légal de déduction des impôts locaux (SALT) ?",
    answer: "Le plafond annuel de déduction des impôts d'État et locaux (State and Local Tax / SALT) est strictement limité à 10 000 $ par foyer fiscal (5 000 $ en cas de déclaration séparée pour un couple marié). Ce plafond englobe les impôts fonciers ainsi que l'impôt sur le revenu ou les taxes sur les ventes locales."
  },
  {
    question: "Comment sont déduits les frais de santé non remboursés ?",
    answer: "Les dépenses médicales et dentaires non couvertes par l'assurance ne sont déductibles que pour la part qui excède 7,5 % de votre revenu brut ajusté (AGI). Par exemple, avec un AGI de 100 000 $, seuls les frais médicaux dépassant 7 500 $ viennent en déduction de vos revenus imposables."
  },
  {
    question: "En quoi consiste la stratégie de groupement des dons (bunching) ?",
    answer: "Le groupement (bunching) consiste à regrouper les dons caritatifs de deux ou trois années au cours d'un seul exercice fiscal. Cette concentration permet à vos déductions réelles de dépasser largement le plafond de la déduction forfaitaire cette année-là, tout en revenant à la déduction forfaitaire les années suivantes."
  },
  {
    question: "Le choix de la déduction forfaitaire interdit-il d'autres avantages fiscaux ?",
    answer: "Non. Les déductions directes du revenu global (déductions 'above-the-line'), telles que les cotisations d'épargne retraite, les primes d'assurance santé des indépendants ou les intérêts de prêts étudiants, peuvent être déduites même si vous choisissez la déduction forfaitaire."
  }
];

const faqsPt = [
  {
    question: "Qual é a diferença entre a dedução padrão e as deduções detalhadas?",
    answer: "A dedução padrão é um valor fixo estipulado pela legislação fiscal que reduz sua renda tributável com base no seu estado civil e idade. As deduções detalhadas permitem abater despesas qualificadas específicas comprovadas — como juros de financiamento habitacional, doações beneficentes, tributos estaduais e locais (limitados a US$ 10.000) e despesas médicas extraordinárias. O contribuinte deve sempre optar pelo montante maior para minimizar o imposto a pagar."
  },
  {
    question: "O que é o teto de dedução de tributos estaduais e locais (SALT)?",
    answer: "Pela legislação fiscal, a dedução combinada de tributos locais e estaduais (SALT), que inclui IPTU predial e imposto de renda ou sobre vendas estadual, possui um teto máximo de US$ 10.000 ao ano (US$ 5.000 para casais com declaração em separado)."
  },
  {
    question: "Posso deduzir despesas médicas na declaração detalhada?",
    answer: "Sim, mas somente despesas médicas e odontológicas não reembolsadas por convênios que excedam 7,5% da sua Renda Bruta Ajustada (AGI). Por exemplo, com um AGI de US$ 100.000, apenas gastos de saúde acima de US$ 7.500 podem ser incluídos nas deduções detalhadas."
  },
  {
    question: "O que é a estratégia de concentração de doações (charitable bunching)?",
    answer: "A concentração de doações (bunching) é um planejamento tributário no qual o contribuinte reúne as contribuições filantrópicas de dois ou três anos em um único exercício fiscal. Com isso, suas despesas qualificadas superam com folga a dedução padrão naquele ano, permitindo economizar mais impostos e voltando à dedução padrão simplificada nos anos seguintes."
  },
  {
    question: "Optar pela dedução padrão impede o uso de outros benefícios fiscais?",
    answer: "Não. É possível usufruir de deduções gerais diretamente da renda bruta (deduções 'above-the-line') mesmo optando pelo desconto padrão. Isso abrange aportes em planos de previdência individual dedutíveis, contas poupança-saúde (HSA) e juros de crédito educacional."
  }
];

const faqsJa = [
  {
    question: "標準控除（Standard Deduction）と項目別控除（Itemized Deductions）の違いは何ですか？",
    answer: "標準控除は申告区分や年齢に応じて法律で定められた定額の所得控除であり、領収書の提出や経費の集計が不要です。一方、項目別控除は住宅ローン利息、慈善寄付金、州・地方税（最大10,000ドルまで）、高額な医療費など、適格な実額経費を個別に申告する制度です。節税効果を最大化するためには、両者を比較して金額が大きい方を常に選択します。"
  },
  {
    question: "SALT控除（州税・地方税控除）の上限とは何ですか？",
    answer: "減税・雇用法（TCJA）に基づき、州税および地方税（SALT：固定資産税、州所得税または地方売上税の合計）の控除限度額は年間10,000ドル（夫婦個別申告の場合は5,000ドル）に制限されています。どれほど高額な地方税を納付していても、10,000ドルを超える部分は控除できません。"
  },
  {
    question: "医療費は項目別控除として申告できますか？",
    answer: "はい、ただし保険等で補填されなかった自己負担の医療費・歯科医療費のうち、調整後総所得（AGI）の7.5%を超えた金額のみが控除対象となります。例えばAGIが100,000ドルの場合、7,500ドル（100,000 × 7.5%）を超えた自己負担分のみが控除可能です。"
  },
  {
    question: "寄付金のバンチング（Charitable Bunching）戦略とは何ですか？",
    answer: "寄付金のバンチングとは、2〜3年分の予定寄付金を1つの課税年度に集約して拠出するタックスプランニング手法です。単年度の寄付額を大きくすることで項目別控除の合計額が標準控除ラインを大幅に上回り、寄付を実行した年に多額の節税効果を得られます。翌年以降は標準控除を利用することで、複数年にわたる税負担を最小化できます。"
  },
  {
    question: "標準控除を選択すると、他の税控除は一切受けられなくなりますか？",
    answer: "いいえ。標準控除を選択した場合でも、総所得から直接差し引かれる総所得控除（Above-the-line deductions）は全額適用できます。これには従来型IRAや確定拠出年金への拠出金、医療貯蓄口座（HSA）への積立金、最大2,500ドルの学生ローン利息控除などが含まれます。"
  }
];

const faqs = isEs ? faqsEs : (isDe ? faqsDe : (isFr ? faqsFr : (isPt ? faqsPt : (isJa ? faqsJa : faqsEn))));

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://financialcalculatorapp.com').replace(/\/+$/, '');
const currentUrl = `${siteOrigin}${translatePath('/compare/standard-vs-itemized')}`;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};

const webAppSchema = {
  "@context": "https://schema.org",
  "@type": ["WebApplication", "SoftwareApplication"],
  "name": pageTitle,
  "description": pageDesc,
  "applicationCategory": "FinanceApplication",
  "operatingSystem": "All",
  "browserRequirements": "Requires JavaScript. Requires HTML5.",
  "author": {
    "@type": "Organization",
    "name": "financialcalculatorapp.com",
    "url": siteOrigin
  },
  "reviewedBy": {
    "@type": "Person",
    "name": "Quantitative Finance & Modeling Review Board",
    "jobTitle": "Chartered Financial Analyst (CFA) & CPA Tax Model Review",
    "url": `${siteOrigin}${translatePath('/about#financial-review-board')}`
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "840",
    "bestRating": "5",
    "worstRating": "1"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
};
---

<Layout 
  title={pageTitle} 
  description={pageDesc}
  lang={lang}
  schemas={[webAppSchema, faqSchema]}
>
  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Header -->
    <header class="border-b border-line pb-6 sm:pb-8 text-center sm:text-left space-y-2">
      <nav class="flex items-center gap-1.5 text-xs font-mono text-muted mb-2 justify-center sm:justify-start" aria-label="Breadcrumb">
        <a href={translatePath('/')} class="hover:text-ink transition-colors">{t('nav.home', 'Home')}</a>
        <span>/</span>
        <a href={translatePath('/calculators')} class="hover:text-ink transition-colors">{t('nav.calculators', 'Calculators')}</a>
        <span>/</span>
        <span class="text-ink font-bold">Standard vs. Itemized</span>
      </nav>
      <span class="px-2.5 py-0.5 bg-canvas-soft border border-line text-muted font-mono text-[10px] rounded-full uppercase">
        {isEs ? "Estrategia Fiscal y Comparativa" : (isDe ? "Steuerstrategie & Abzugsvergleich" : (isFr ? "Stratégie Fiscale & Comparatif" : (isPt ? "Estratégia Fiscal e Comparativo" : (isJa ? "税務戦略と所得控除の比較" : "Tax Strategy & Schedule A Comparison"))))}
      </span>
      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-ink leading-tight">
        {pageTitle}
      </h1>
      <p class="text-xs sm:text-sm text-muted max-w-3xl leading-relaxed">
        {pageDesc}
      </p>
    </header>

    <!-- Side by Side Conceptual Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="border border-ink/30 bg-paper p-5 sm:p-6 rounded-lg shadow-[var(--control-shadow)] space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl">📋</span>
          <h2 class="text-base sm:text-lg font-bold text-ink">{isEs ? "La Deducción Estándar" : (isDe ? "Der Pauschalbetrag (Standard Deduction)" : (isFr ? "La Déduction Forfaitaire" : (isPt ? "A Dedução Padrão Simplificada" : (isJa ? "標準控除（Standard Deduction）" : "The Standard Deduction"))))}</h2>
        </div>
        <p class="text-xs text-muted leading-relaxed font-sans">
          {isEs 
            ? "Una deducción fija establecida por ley según tu estado civil sin necesidad de justificar gastos ni conservar facturas. Más del 88% de los contribuyentes se acogen a la deducción estándar por su sencillez."
            : (isDe
              ? "Ein gesetzlich festgelegter Pauschalbetrag basierend auf Ihrem Veranlagungsstatus, ohne dass Belege oder Einzelaufstellungen nötig sind. Über 88% der Steuerzahler nutzen diese unkomplizierte Option."
              : (isFr
                ? "Un abattement forfaitaire fixé par la loi selon votre situation familiale, sans besoin de conserver de justificatifs. Plus de 88 % des contribuables choisissent la déduction forfaitaire pour sa simplicité."
                : (isPt
                  ? "Um desconto padrão fixado pela legislação fiscal com base no seu estado civil, sem necessidade de guardar recibos ou comprovar despesas. Mais de 88% dos contribuintes optam pela dedução padrão pela agilidade e segurança."
                  : (isJa
                    ? "申告区分に基づき法律で一律に定められた所得控除額。領収書の保管や細かな経費集計は一切不要で、確定申告を行う納税者の約88%が手続きの簡便さから標準控除を選択しています。"
                    : "A no-questions-asked, fixed dollar deduction established by the IRS based strictly on filing status. No receipts, itemized records, or audit documentation required. Over 88% of taxpayers take the standard deduction due to TCJA threshold increases."))))}
        </p>
        <ul class="text-xs text-muted list-disc pl-4 space-y-1.5 font-sans">
          <li><strong>{isEs ? "Simplicidad:" : (isDe ? "Einfachheit:" : (isFr ? "Simplicité :" : (isPt ? "Simplicidade:" : (isJa ? "手続きの簡便さ:" : "Simplicity:"))))}</strong> {isEs ? "Sin trámites adicionales; se aplica de forma automática en la declaración." : (isDe ? "Keine Belege oder Zusatzformulare; wird direkt steuermindernd angesetzt." : (isFr ? "Aucun justificatif ; déduction appliquée de plein droit sur votre déclaration." : (isPt ? "Zero burocracia; abatimento concedido automaticamente na sua declaração." : (isJa ? "領収書の提出や経費内訳の集計は不要。申告書上で自動的に控除が適用されます。" : "Zero paperwork; automatically claimed on Form 1040."))))}</li>
          <li><strong>{isEs ? "Importes de Referencia:" : (isDe ? "Richtwerte 2025/2026:" : (isPt ? "Valores de Referência:" : (isJa ? "基準控除額（2025/2026）:" : "2025/2026 Baseline:")))}</strong> $15,000 ({isEs ? "Soltero" : (isDe ? "Ledig" : (isPt ? "Solteiro" : (isJa ? "単身" : "Single")))}), $30,000 ({isEs ? "Casados Conjunta" : (isDe ? "Verheiratet" : (isPt ? "Casal Conjunto" : (isJa ? "夫婦合算" : "Married Joint")))}), $22,500 ({isEs ? "Cabeza de Familia" : (isDe ? "Haushaltsvorstand" : (isPt ? "Chefe de Família" : (isJa ? "世帯主" : "Head of Household")))}).</li>
          <li><strong>{isEs ? "Seguridad Fiscal:" : (isDe ? "Prüfungsrisiko:" : (isFr ? "Sécurité Fiscale :" : (isPt ? "Segurança Fiscal:" : (isJa ? "税務調査リスク:" : "Audit Risk:"))))}</strong> {isEs ? "Cero riesgo de auditoría por justificación de gastos deducibles." : (isDe ? "Null Prüfungsrisiko für Nachweise einzelner Werbungs- oder Sonderausgaben." : (isFr ? "Zéro risque de contrôle fiscal sur les frais réels." : (isPt ? "Zero risco de questionamento ou glosa de despesas em malha fina." : (isJa ? "個別の支出領収書を証明する必要がないため、税務調査における経費否認リスクが皆無です。" : "Zero itemized audit scrutiny."))))}</li>
        </ul>
      </div>

      <div class="border border-input-accent/40 bg-paper p-5 sm:p-6 rounded-lg shadow-[var(--control-shadow)] space-y-3">
        <div class="flex items-center gap-2">
          <span class="text-2xl text-input-accent">🧾</span>
          <h2 class="text-base sm:text-lg font-bold text-ink">{isEs ? "Deducciones Detalladas" : (isDe ? "Einzelnachweis (Itemized Deductions)" : (isFr ? "Déductions Réelles (Frais Réels)" : (isPt ? "Deduções Detalhadas (Frais Réels)" : (isJa ? "項目別控除（Itemized Deductions）" : "Itemized Deductions (Schedule A)"))))}</h2>
        </div>
        <p class="text-xs text-muted leading-relaxed font-sans">
          {isEs 
