<script>
  const statusSelect = document.getElementById('filing-status') as HTMLSelectElement | null;
  const agiInput = document.getElementById('user-agi') as HTMLInputElement | null;
  const bracketInput = document.getElementById('marginal-rate') as HTMLInputElement | null;
  const mortgageInput = document.getElementById('mortgage-interest') as HTMLInputElement | null;
  const saltInput = document.getElementById('salt-taxes') as HTMLInputElement | null;
  const charityInput = document.getElementById('charitable') as HTMLInputElement | null;
  const medInput = document.getElementById('medical-expenses') as HTMLInputElement | null;

  const resStandard = document.getElementById('res-standard');
  const resItemized = document.getElementById('res-itemized');
  const resSavings = document.getElementById('res-savings');
  const calloutHeading = document.getElementById('callout-heading');
  const calloutBody = document.getElementById('callout-body');

  const standardDeductions: Record<string, number> = {
    single: 15000,
    mfj: 30000,
    hoh: 22500,
    mfs: 15000
  };

  function updateCalculation() {
    const status = statusSelect?.value || 'mfj';
    const standardAmount = standardDeductions[status] || 30000;
    const agi = Math.max(0, parseFloat(agiInput?.value || '0'));
    const bracket = Math.max(0, parseFloat(bracketInput?.value || '22')) / 100;

    const mortgage = Math.max(0, parseFloat(mortgageInput?.value || '0'));
    const saltRaw = Math.max(0, parseFloat(saltInput?.value || '0'));
    const saltCapped = Math.min(status === 'mfs' ? 5000 : 10000, saltRaw);
    const charity = Math.max(0, parseFloat(charityInput?.value || '0'));

    const medRaw = Math.max(0, parseFloat(medInput?.value || '0'));
    const medThreshold = agi * 0.075;
    const medDeductible = Math.max(0, medRaw - medThreshold);

    const totalItemized = mortgage + saltCapped + charity + medDeductible;
    const delta = Math.abs(totalItemized - standardAmount);
    const taxSavings = Math.round(delta * bracket);

    const formatCurrency = (val: number) => `$${Math.round(val).toLocaleString()}`;

    if (resStandard) {
      const valEl = resStandard.querySelector('.result-value');
      if (valEl) valEl.textContent = formatCurrency(standardAmount);
    }

    if (resItemized) {
      const valEl = resItemized.querySelector('.result-value');
      if (valEl) valEl.textContent = formatCurrency(totalItemized);
    }

    const itemizeWins = totalItemized > standardAmount;

    if (resSavings) {
      const valEl = resSavings.querySelector('.result-value');
      const descEl = resSavings.querySelector('.result-description');
      if (valEl) valEl.textContent = itemizeWins ? 'Itemize Deductions' : 'Standard Deduction';
      if (descEl) {
        descEl.textContent = itemizeWins 
          ? `Itemizing saves an extra ${formatCurrency(taxSavings)} in tax.`
          : `Standard saves an extra ${formatCurrency(taxSavings)} in tax.`;
      }
    }

    if (calloutHeading && calloutBody) {
      if (itemizeWins) {
        calloutHeading.textContent = `Recommendation: File Schedule A & Itemize (Save ${formatCurrency(taxSavings)})`;
        calloutBody.textContent = `Your itemized deductions (${formatCurrency(totalItemized)}) beat your standard deduction (${formatCurrency(standardAmount)}) by ${formatCurrency(delta)}. Itemizing on Schedule A reduces your taxable income further, putting an estimated ${formatCurrency(taxSavings)} back in your pocket at your ${Math.round(bracket * 100)}% tax bracket.`;
      } else {
        calloutHeading.textContent = `Recommendation: Claim the Standard Deduction (Save ${formatCurrency(taxSavings)})`;
        calloutBody.textContent = `Your standard deduction (${formatCurrency(standardAmount)}) exceeds your itemized deductions (${formatCurrency(totalItemized)}) by ${formatCurrency(delta)}. Taking the standard deduction lowers your taxable income by ${formatCurrency(delta)} more with zero paperwork, saving approximately ${formatCurrency(taxSavings)} at your ${Math.round(bracket * 100)}% tax rate.`;
      }
    }
  }

  [statusSelect, agiInput, bracketInput, mortgageInput, saltInput, charityInput, medInput].forEach(el => {
    el?.addEventListener('input', updateCalculation);
    el?.addEventListener('change', updateCalculation);
  });

  document.getElementById('deduction-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    updateCalculation();
  });

  updateCalculation();
</script>
