---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import Input from '../../components/ui/Input.astro';
import ResultCard from '../../components/ui/ResultCard.astro';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';
import { getCalculatorFaqs } from '../../i18n/calculator-faqs-data';

const lang = getLangFromUrl(Astro.url, Astro.currentLocale);
const t = useTranslations(lang);
const faqs = getCalculatorFaqs('tip');
---

<CalculatorLayout 
  title="Tip Calculator" 
  description="Quickly calculate bill tips, split total amounts among friends, and round up payments for dining and hospitality services."
  faqs={faqs}
>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    <!-- Left Column (Inputs) -->
    <div class="lg:col-span-6 space-y-6">
      <form id="tip-form" class="space-y-6">
        <div class="space-y-6 bg-canvas border border-hairline p-6 rounded-lg shadow-sm">
          <h3 class="text-xs font-mono text-mute uppercase tracking-wider mb-4 border-b border-hairline pb-2">{t('Bill & Service', 'Bill & Tip Details')}</h3>
          
          <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <Input id="bill" label="Bill Amount" type="number" prefix="$" value="84.50" />
            <Input id="tip-pct" label="Tip Percentage" type="number" suffix="%" value="18" />
          </div>

          <div class="pt-4 border-t border-hairline/60">
            <Input id="split" label="Split Bill (Number of People)" type="number" value="3" />
          </div>
        </div>

        <div class="pt-2 border-t border-hairline flex gap-4">
          <button type="submit" class="px-6 py-2.5 bg-primary text-on-primary rounded-full font-medium text-sm hover:opacity-90 transition-opacity cursor-pointer">
            {t('Calculate Tip')}
          </button>
          <button type="reset" id="reset-btn" class="px-6 py-2.5 bg-canvas text-ink border border-hairline rounded-full font-medium text-sm hover:bg-canvas-soft transition-colors shadow-sm cursor-pointer">
            {t('Clear')}
          </button>
        </div>
      </form>
    </div>

    <!-- Right Column (Results & Charts) -->
    <div class="lg:col-span-6 space-y-6">
      <div class="flex flex-col gap-3">
        <div id="res-total-pp">
          <ResultCard title="Total Per Person" value="$33.14" highlight={true} />
        </div>
        <div id="res-tip-pp">
          <ResultCard title="Tip Per Person" value="$5.07" />
        </div>
        <div id="res-bill-total">
          <ResultCard title="Total Bill" value="$99.71" />
        </div>
        <div id="res-tip-total">
          <ResultCard title="Total Tip" value="$15.21" />
        </div>
      </div>

      <!-- Bill Breakdown Chart -->
      <div class="bg-canvas border border-hairline rounded-lg p-5 shadow-sm">
        <h4 class="text-xs font-mono text-mute uppercase tracking-wider mb-4">Bill vs. Tip Proportion</h4>
        <div class="h-56 relative">
          <canvas id="tip-chart"></canvas>
        </div>
      </div>
    </div>
  </div>
</CalculatorLayout>

<script>
  import { calculateTip } from '../../lib/math/misc';
  import { formatCurrency } from '../../lib/utils';
  import Chart from 'chart.js/auto';

  // DOM Elements
  const form = document.getElementById('tip-form') as HTMLFormElement;
  
  const billInput = document.getElementById('bill') as HTMLInputElement;
  const tipPctInput = document.getElementById('tip-pct') as HTMLInputElement;
  const splitInput = document.getElementById('split') as HTMLInputElement;

  const resTotalPpCard = document.getElementById('res-total-pp');
  const resTipPpCard = document.getElementById('res-tip-pp');
  const resBillTotalCard = document.getElementById('res-bill-total');
  const resTipTotalCard = document.getElementById('res-tip-total');

  let chartInstance: Chart | null = null;

  // Run calculation
  function performCalculation() {
    const billAmount = parseFloat(billInput.value) || 0;
    const tipPct = (parseFloat(tipPctInput.value) || 0) / 100;
    const splitCount = parseInt(splitInput.value) || 1;

    const res = calculateTip({ billAmount, tipPct, splitCount });

    // Update Result Cards
    if (resTotalPpCard) resTotalPpCard.querySelector('.font-mono')!.textContent = formatCurrency(res.totalPerPerson);
    if (resTipPpCard) resTipPpCard.querySelector('.font-mono')!.textContent = formatCurrency(res.tipPerPerson);
    if (resBillTotalCard) resBillTotalCard.querySelector('.font-mono')!.textContent = formatCurrency(res.totalAmount);
    if (resTipTotalCard) resTipTotalCard.querySelector('.font-mono')!.textContent = formatCurrency(res.tipAmount);

    // Update Chart
    updateChart(billAmount, res.tipAmount);
  }

  function updateChart(bill: number, tip: number) {
    const canvas = document.getElementById('tip-chart') as HTMLCanvasElement;
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dataset = [bill, tip];

    if (chartInstance) {
      chartInstance.data.datasets[0].data = dataset;
      chartInstance.update();
    } else {
      chartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Base Bill Cost', 'Service Tip'],
          datasets: [
            {
              data: dataset,
              backgroundColor: ['#171717', '#0070f3'],
              borderWidth: 1
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: {
              display: true,
              position: 'right',
              labels: {
                boxWidth: 10,
                font: { family: 'Geist, sans-serif', size: 10 }
              }
            },
            tooltip: {
              callbacks: {
                label: function(context) {
                  return ` ${formatCurrency(context.raw as number)}`;
                }
              }
            }
          }
        }
      });
    }
  }

  // Listeners
  [billInput, tipPctInput, splitInput].forEach(el => {
    el.addEventListener('input', performCalculation);
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    performCalculation();
  });

  form.addEventListener('reset', () => {
    setTimeout(performCalculation, 0);
  });

  // Initial calculation
  performCalculation();

  // Listen for currency changes
  window.addEventListener('currency-change', performCalculation);
</script>
